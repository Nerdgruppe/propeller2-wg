//? WINDTUNNEL CHECK LIST
//? profile: program
//? oracle: off "cog termination is not observable over UART"

// Stop the executing cog and verify that younger code never executes.
// COGID avoids assuming a cog number; the trailing raw instruction is deliberate poison after COGSTOP.

_start:
                COGID   id
                COGSTOP id
                // end of code

                // Raw post-stop sentinel: condition 0, opcode $5E, CZI=7.
                // Preserve these exact bits; canonical mnemonic output would change the sentinel.
                LONG    0b0000_1011110_111_000000000_000000000      // Must never execute after self-stop.

var id:         LONG    0

