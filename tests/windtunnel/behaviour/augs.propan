//? WINDTUNNEL CHECK LIST
//? timeout-ms: 1000
//? post: cog[0].reg[first] == 0x1ff
//? post: cog[0].reg[second] == 0x12345678
//? post: cog[0].reg[third] == 0x101

// Check that an augmented immediate is used once between ordinary MOV immediates.
// The immediate before and after aug(...) expose augmentation leaking into another instruction.

_start:
                MOV     first,  0x1ff
                MOV     second, aug(0x12345678)
                MOV     third,  0x101
                JMP     nrel(_end)

var first:      LONG    0
var second:     LONG    0
var third:      LONG    0

