//? cog: 7
//? const: probe_writer = 6
//? const: probe_pin = 0
//?
//? run: "cog7-pin0-se2"
//? macro: event_tracker set 2
//? cog: 7
//? const: probe_writer = 6
//? const: probe_pin = 0
//?
//? run: "cog7-pin0-se3"
//? macro: event_tracker set 3
//? cog: 7
//? const: probe_writer = 6
//? const: probe_pin = 0
//?
//? run: "cog7-pin0-se4"
//? macro: event_tracker set 4
//? cog: 7
//? const: probe_writer = 6
//? const: probe_pin = 0
//?
//? run: "cog7-pin32-se1"
//? macro: event_tracker set 1
//? cog: 7
//? const: probe_writer = 6
//? const: probe_pin = 32
//?
//? run: "cog7-pin32-se2"
//? macro: event_tracker set 2
//? cog: 7
//? const: probe_writer = 6
//? const: probe_pin = 32
//?
//? run: "cog7-pin32-se3"
//? macro: event_tracker set 3
//? cog: 7
//? const: probe_writer = 6
//? const: probe_pin = 32
//?
//? run: "cog7-pin32-se4"
//? macro: event_tracker set 4
//? cog: 7
//? const: probe_writer = 6
//? const: probe_pin = 32

                // Hold two opposite input levels with a companion cog. Only sensor arming timing is measured.
                MOV     PTRA,           aug(hubaddr(mailbox))
                MOV     PTRB,           PTRA
                ADD     PTRB,           4
                MOV     image,          aug(hubaddr(writer))
                SETQ    PTRA
                COGINIT probe_writer,   image
                SETSE1  0
                SETSE2  0
                SETSE3  0
                SETSE4  0
                MOV     command,        2
level_loop:
                WRLONG  command,    PTRA
                CALL    await_ack
// Clear inherited/previous notifications before starting from a quiet LUT source.
                SETSE{{ event_tracker }}    0
                WAITX   64
                POLLSE{{ event_tracker }}
                MOV     selector,   (0x100 | probe_pin)
                TEST    command,    1                           :wz
    if(!Z)      OR      selector,   0x80
// Configuring a matching level does not satisfy the immediately following poll.
                SETSE{{ event_tracker }}    selector
                POLLSE{{ event_tracker }}   :wcz
    if(C)       ADD     failures,   1
    if(Z)       ADD     failures,   1
                // Once the sensor notification arrives, held levels reassert after consumption.
                WAITX   64
                POLLSE{{ event_tracker }}   :wcz
    if(!C)      ADD     failures,   1
    if(!Z)      ADD     failures,   1
                POLLSE{{ event_tracker }}   :wcz
    if(!C)      ADD     failures,   1
    if(!Z)      ADD     failures,   1
                // Switching away from an asserted level clears the latch, but an old sample still arrives.
                MOV     selector,   (0x40 | probe_pin)
                TEST    command,    1                           :wz
    if(!Z)      MOV     selector,   (0x80 | probe_pin)
                SETSE{{ event_tracker }}    selector
                WAITX   64
                POLLSE{{ event_tracker }}   :wcz
    if(!C)      ADD     failures,   1
    if(!Z)      ADD     failures,   1
                POLLSE{{ event_tracker }}   :wcz
    if(C)       ADD     failures,   1
    if(Z)       ADD     failures,   1
// Rearming an edge or selecting another stable input must not invent a transition.
                SETSE{{ event_tracker }}    selector
                WAITX   64
                POLLSE{{ event_tracker }}   :wc
    if(C)       ADD     failures,   1
                MOV     selector,   (0x40 | (probe_pin + 1))
                SETSE{{ event_tracker }}    selector
                WAITX   64
                POLLSE{{ event_tracker }}   :wc
    if(C)       ADD     failures,   1
                MOV     selector,   (0x80 | (probe_pin + 1))
                SETSE{{ event_tracker }}    selector
                WAITX   64
                POLLSE{{ event_tracker }}   :wc
    if(C)       ADD     failures,   1

                ADD     command,    1
                CMP     command,    4                           :wz
    if(!Z)      JMP     level_loop
                // Stop the helper after both input levels have been tested.
                WRLONG  command,    PTRA
                CALL    await_ack
                SETQ    0
                MODCZ   _CLR,       _CLR                        :wcz
                JMP     nrel(_end)
// Wait until the writer acknowledges that both input bits have settled.
await_ack:
                RDLONG  ack,    PTRB
                CMP     ack,    command :wz
    if(!Z)      JMP     await_ack
                RET
var image:      LONG    0
var command:    LONG    0
var ack:        LONG    0
var selector:   LONG    0
var failures:   LONG    0
.data
mailbox:        LONG    [0, 0]
.cogexec    0x4000, 0
writer:
                MOV     register(402),  PTRA
                ADD     register(402),  4
                MOV     register(401),  0
writer_wait:
                RDLONG  register(400),  PTRA
                CMP     register(400),  register(401)   :wz
    if(Z)       JMP     writer_wait
                MOV     register(401),  register(400)
                CMP     register(400),  4               :wz
    if(Z)       JMP     writer_stop
                // Selected and neighboring inputs are held opposite; neither changes during reconfiguration.
                TEST    register(400),  1               :wz
    if(Z)       DRVL    probe_pin
    if(Z)       DRVH    (probe_pin + 1)
    if(!Z)      DRVH    probe_pin
    if(!Z)      DRVL    (probe_pin + 1)
                WAITX   64
                WRLONG  register(400),  register(402)
                JMP     writer_wait
writer_stop:
                FLTL    probe_pin
                FLTL    (probe_pin + 1)
                WRLONG  register(400),  register(402)
                COGSTOP probe_writer

