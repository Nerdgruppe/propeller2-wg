//? const: kind = 1
//? const: delta = 4
//? post: cog[*].reg[landed] == 1
//?
//? run: "lut-call-5-cog0"
//? macro: pop set POP return_error
//? macro: sub set SUB return_error, aug(0x80000000 | pcaddr(after))
//? macro: domain set SETQ2 7
//? macro: domain_2 set RDLONG register(0), aug(hubaddr(entry))
//? macro: domain_3 set WRLUT branch_word, aug(pcaddr(site))
//? cog: 0
//? const: domain = 1
//? const: kind = 1
//? const: delta = 5
//? post: cog[*].reg[landed] == 1
//?
//? run: "lut-call-6-cog0"
//? macro: pop set POP return_error
//? macro: sub set SUB return_error, aug(0x80000000 | pcaddr(after))
//? macro: domain set SETQ2 7
//? macro: domain_2 set RDLONG register(0), aug(hubaddr(entry))
//? macro: domain_3 set WRLUT branch_word, aug(pcaddr(site))
//? cog: 0
//? const: domain = 1
//? const: kind = 1
//? const: delta = 6
//? post: cog[*].reg[landed] == 1
//?
//? run: "lut-call-7-cog0"
//? macro: pop set POP return_error
//? macro: sub set SUB return_error, aug(0x80000000 | pcaddr(after))
//? macro: domain set SETQ2 7
//? macro: domain_2 set RDLONG register(0), aug(hubaddr(entry))
//? macro: domain_3 set WRLUT branch_word, aug(pcaddr(site))
//? cog: 0
//? const: domain = 1
//? const: kind = 1
//? const: delta = 7
//? post: cog[*].reg[landed] == 1

                // Raw A fields exercise byte displacements that ordinary labels cannot emit.
                // Distinct adjacent branch targets expose the local displacement conversion.
                JMP     nrel(setup)
hit_minus2:
                MOV     landed, 102
                JMP     nrel(finish)
hit_minus1:
                MOV     landed, 101
                JMP     nrel(finish)
hit_zero:
                MOV     landed, 0
                JMP     nrel(finish)
hit_plus1:
                MOV     landed, 1
                JMP     nrel(finish)
hit_plus2:
                MOV     landed, 2
                JMP     nrel(finish)
finish:
                GETCT   elapsed
                SUB     elapsed,        start
                {{ pop }}
                {{ sub }}
                MOV     completed,      1
                JMP     nrel(_end)

// Install the raw JMP/CALL word into a code-marked instruction slot.
setup:
                MODCZ   _SET,                       _CLR                :wcz
                {{ domain }}
                {{ domain_2 }}
                {{ domain_3 }}
                GETCT   start
                JMP     nrel(entry)
var branch_word:
                // Raw relative JMP/CALL/CALLA/CALLB: kind selects opcode bits 22:21,
                // and delta supplies A20 verbatim, including unaligned byte displacements.
                // Native relocation scales or validates the field, hiding the low-bit probe.
                LONG    (0xfd900000 + (kind << 21)) | (delta & 0xfffff)
var landed:     LONG    99
var completed:  LONG    0
var return_error:
                LONG    0
var start:      LONG    0
var elapsed:    LONG    0

// Each candidate slot jumps to a safe handler, including negative offsets.
.if domain == 1
.lutexec    0x3000, 0x200
.endif
entry:
                JMP     nrel(site)
minus3:
                JMP     nrel(hit_minus2)
minus2:
                JMP     nrel(hit_minus2)
minus1:
                JMP     nrel(hit_minus1)
site:
                JMP     nrel(hit_zero)
after:
                JMP     nrel(hit_zero)
plus1:
                JMP     nrel(hit_plus1)
plus2:
                JMP     nrel(hit_plus2)
