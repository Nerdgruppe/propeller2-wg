                // Record stable digital pin samples, then let the shared FIFO drain.
                MOV     OUTA,                                   aug(0x87654321)
                MOV     DIRA,                                   aug(0xffffffff)
                WAITX   20
                WRFAST  0,                                      aug(hubaddr(buffer))
                SETXFRQ aug(0x10000000)
                XINIT   aug((mode << 16) | X_WRITE_ON | count), 0
                WAITXFI
                WAITX   100
                MOV     DIRA,                                   0
                JMP     nrel(_end)
.data
.align  4
var buffer:     BYTE    [0xcc] * 16

