//? macro: wypin_3 set WYPIN aug(68), aug(40 | (1 << 6))
//? macro: wypin_4 override WYPIN aug(136), aug(40 | (1 << 6))
//? macro: wypin_5 override WYPIN aug(119), aug(40 | (1 << 6))
//? issues: pin_buffer_overwrite = 4
//? const: mode0 = 118
//? const: mode1 = 118
//? const: x = 4096
//? const: phase = 15
//? const: delay = 16
//? post: cog[0].reg[result] == 4
//? post: cog[0].reg[upper] == 0
//? post: cog[0].reg[flags] == 12
//?
//? run: "p15-n6-d128"
//? macro: wypin set WYPIN aug(17), aug(40 | (1 << 6))
//? macro: wypin_2 set WYPIN aug(34), aug(40 | (1 << 6))
//? macro: wypin_3 set WYPIN aug(68), aug(40 | (1 << 6))
//? macro: wypin_4 override WYPIN aug(136), aug(40 | (1 << 6))
//? macro: wypin_5 override WYPIN aug(119), aug(40 | (1 << 6))
//? issues: pin_buffer_overwrite = 4
//? const: mode0 = 118
//? const: mode1 = 118
//? const: x = 4096
//? const: phase = 15
//? const: delay = 128
//? post: cog[0].reg[result] == 1
//? post: cog[0].reg[upper] == 0
//? post: cog[0].reg[flags] == 28
//?
//? run: "p15-n6-d768"
//? macro: wypin set WYPIN aug(17), aug(40 | (1 << 6))
//? macro: wypin_2 set WYPIN aug(34), aug(40 | (1 << 6))
//? macro: wypin_3 set WYPIN aug(68), aug(40 | (1 << 6))
//? macro: wypin_4 override WYPIN aug(136), aug(40 | (1 << 6))
//? macro: wypin_5 override WYPIN aug(119), aug(40 | (1 << 6))
//? issues: pin_buffer_overwrite = 4
//? const: mode0 = 118
//? const: mode1 = 118
//? const: x = 4096
//? const: phase = 15
//? const: delay = 768
//? post: cog[0].reg[result] == 9
//? post: cog[0].reg[upper] == 0
//? post: cog[0].reg[flags] == 28

                // Configure the physical pair before applying the shared lower-pin baud and role.
                DIRL    aug(40 | (3 << 6))
                WRPIN   0,                  aug(40 | (3 << 6))
                WRPIN   aug(0x60000000),    aug(42 | (1 << 6))
                WRPIN   aug(mode0),         40
                WRPIN   aug(mode1),         41
                WXPIN   aug(x),             40
                DIRH    aug(40 | (1 << 6))
                WYPIN   3,                  aug(40 | (1 << 6))
                WAITX   128
                // Clear startup error history after the pair is held in a driven J state.
                WYPIN   0x80,               aug(40 | (1 << 6))
                WAITX   aug(512)
                WYPIN   3,                  aug(40 | (1 << 6))
                WAITX   128
                // Stress the FIFO with consecutive writes, independently of upper IN acknowledgement.
                WAITX   aug(phase)
                WYPIN   aug(128),           aug(40 | (1 << 6))
                {{ wypin }}
                {{ wypin_2 }}
                {{ wypin_3 }}
                {{ wypin_4 }}
                {{ wypin_5 }}
                WAITX   aug(delay)
                // Preserve result, carry, both engine handshakes and paired physical input aliases.
                RQPIN   result,             40                  :wc
                MOV     flags,              0
                MUXC    flags,              1
                RQPIN   upper,              41                  :wc
                MUXC    flags,              2
                TESTP   40                                      :wc
                MUXC    flags,              4
                TESTP   41                                      :wc
                MUXC    flags,              8
                TESTP   42                                      :wc
                MUXC    flags,              16
                TESTP   43                                      :wc
                MUXC    flags,              32
                // Release every experiment pin before the oracle reporter.
                DIRL    aug(40 | (3 << 6))
                WRPIN   0,                  aug(40 | (3 << 6))
                JMP     nrel(_end)
var result:     LONG    0
var upper:      LONG    0
var flags:      LONG    0
