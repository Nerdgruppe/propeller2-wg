//? WINDTUNNEL CHECK LIST
//? post: cog[*].reg[failures] == 0
//? run: "0"
//? cog: 0
//? const: probe_cog = 0
//? const: other_cog = 1
//? run: "1"
//? cog: 1
//? const: probe_cog = 1
//? const: other_cog = 2
//? run: "2"
//? cog: 2
//? const: probe_cog = 2
//? const: other_cog = 3
//? run: "3"
//? cog: 3
//? const: probe_cog = 3
//? const: other_cog = 4
//? run: "4"
//? cog: 4
//? const: probe_cog = 4
//? const: other_cog = 5
//? run: "5"
//? cog: 5
//? const: probe_cog = 5
//? const: other_cog = 6
//? run: "6"
//? cog: 6
//? const: probe_cog = 6
//? const: other_cog = 7
//? run: "7"
//? cog: 7
//? const: probe_cog = 7
//? const: other_cog = 0

// Measure shared cog/lock command slots with and without returned results.
// Command grants follow the issuing cog ID, separately from hub RAM slice rotation; release locks between samples.
// Raw deltas are 4 clocks without a returned result or 6 with one, plus (6 + cog - start_CT) & 7.

                MOV     offset, 0
cogid_result_loop:
                LOCKNEW lock
                MOV     scratch,    lock
                LOCKTRY lock                    :wc
                GETCT   timer
                // Synchronize safely in the future; offset then selects each CT modulo-eight phase.
                ADD     timer,      128
                ANDN    timer,      7
                ADD     timer,      offset
                ADDCT1  timer,      0
                WAITCT1
                GETCT   start
                COGID   scratch
                GETCT   finish
                SUB     finish,     start
                AND     start,      7
                MOV     expected,   6
                SUB     expected,   start
                ADD     expected,   probe_cog
                AND     expected,   7
                ADD     expected,   6
                CMP     finish,     expected    :wz
    if(!Z)      ADD     failures,   1
                LOCKRET lock
                ADD     offset,     1
                CMP     offset,     8           :wz
    if(!Z)      JMP     cogid_result_loop
                MOV     offset,     0
cogid_status_loop:
                LOCKNEW lock
                MOV     scratch,    lock
                LOCKTRY lock                    :wc
                GETCT   timer
                ADD     timer,      128
                ANDN    timer,      7
                ADD     timer,      offset
                ADDCT1  timer,      0
                WAITCT1
                GETCT   start
                COGID   other_cog               :wc
                GETCT   finish
                SUB     finish,     start
                AND     start,      7
                MOV     expected,   6
                SUB     expected,   start
                ADD     expected,   probe_cog
                AND     expected,   7
                ADD     expected,   6
                CMP     finish,     expected    :wz
    if(!Z)      ADD     failures,   1
                LOCKRET lock
                ADD     offset,     1
                CMP     offset,     8           :wz
    if(!Z)      JMP     cogid_status_loop
                MOV     offset,     0
cogstop_loop:
                LOCKNEW lock
                MOV     scratch,    lock
                LOCKTRY lock                    :wc
                GETCT   timer
                ADD     timer,      128
                ANDN    timer,      7
                ADD     timer,      offset
                ADDCT1  timer,      0
                WAITCT1
                GETCT   start
                COGSTOP other_cog
                GETCT   finish
                SUB     finish,     start
                AND     start,      7
                MOV     expected,   6
                SUB     expected,   start
                ADD     expected,   probe_cog
                AND     expected,   7
                ADD     expected,   4
                CMP     finish,     expected    :wz
    if(!Z)      ADD     failures,   1
                LOCKRET lock
                ADD     offset,     1
                CMP     offset,     8           :wz
    if(!Z)      JMP     cogstop_loop
                MOV     offset,     0
locknew_loop:
                LOCKNEW lock
                MOV     scratch,    lock
                LOCKTRY lock                    :wc
                GETCT   timer
                ADD     timer,      128
                ANDN    timer,      7
                ADD     timer,      offset
                ADDCT1  timer,      0
                WAITCT1
                GETCT   start
                LOCKNEW spare                   :wc
                GETCT   finish
                SUB     finish,     start
                AND     start,      7
                MOV     expected,   6
                SUB     expected,   start
                ADD     expected,   probe_cog
                AND     expected,   7
                ADD     expected,   6
                CMP     finish,     expected    :wz
    if(!Z)      ADD     failures,   1
                LOCKRET spare
                LOCKRET lock
                ADD     offset,     1
                CMP     offset,     8           :wz
    if(!Z)      JMP     locknew_loop
                MOV     offset,     0
locktry_loop:
                LOCKNEW lock
                MOV     scratch,    lock
                LOCKTRY lock                    :wc
                GETCT   timer
                ADD     timer,      128
                ANDN    timer,      7
                ADD     timer,      offset
                ADDCT1  timer,      0
                WAITCT1
                GETCT   start
                LOCKTRY lock                    :wc
                GETCT   finish
                SUB     finish,     start
                AND     start,      7
                MOV     expected,   6
                SUB     expected,   start
                ADD     expected,   probe_cog
                AND     expected,   7
                ADD     expected,   6
                CMP     finish,     expected    :wz
    if(!Z)      ADD     failures,   1
                LOCKRET lock
                ADD     offset,     1
                CMP     offset,     8           :wz
    if(!Z)      JMP     locktry_loop
                MOV     offset,     0
lockrel_query_loop:
                LOCKNEW lock
                MOV     scratch,    lock
                LOCKTRY lock                    :wc
                GETCT   timer
                ADD     timer,      128
                ANDN    timer,      7
                ADD     timer,      offset
                ADDCT1  timer,      0
                WAITCT1
                GETCT   start
                LOCKREL scratch                 :wc
                GETCT   finish
                SUB     finish,     start
                AND     start,      7
                MOV     expected,   6
                SUB     expected,   start
                ADD     expected,   probe_cog
                AND     expected,   7
                ADD     expected,   6
                CMP     finish,     expected    :wz
    if(!Z)      ADD     failures,   1
                LOCKRET lock
                ADD     offset,     1
                CMP     offset,     8           :wz
    if(!Z)      JMP     lockrel_query_loop
                MOV     offset,     0
lockrel_loop:
                LOCKNEW lock
                MOV     scratch,    lock
                LOCKTRY lock                    :wc
                GETCT   timer
                ADD     timer,      128
                ANDN    timer,      7
                ADD     timer,      offset
                ADDCT1  timer,      0
                WAITCT1
                GETCT   start
                LOCKREL lock
                GETCT   finish
                SUB     finish,     start
                AND     start,      7
                MOV     expected,   6
                SUB     expected,   start
                ADD     expected,   probe_cog
                AND     expected,   7
                ADD     expected,   4
                CMP     finish,     expected    :wz
    if(!Z)      ADD     failures,   1
                LOCKRET lock
                ADD     offset,     1
                CMP     offset,     8           :wz
    if(!Z)      JMP     lockrel_loop
                MOV     offset,     0
lockret_loop:
                LOCKNEW lock
                MOV     scratch,    lock
                LOCKTRY lock                    :wc
                GETCT   timer
                ADD     timer,      128
                ANDN    timer,      7
                ADD     timer,      offset
                ADDCT1  timer,      0
                WAITCT1
                GETCT   start
                LOCKRET lock
                GETCT   finish
                SUB     finish,     start
                AND     start,      7
                MOV     expected,   6
                SUB     expected,   start
                ADD     expected,   probe_cog
                AND     expected,   7
                ADD     expected,   4
                CMP     finish,     expected    :wz
    if(!Z)      ADD     failures,   1
                LOCKRET lock
                ADD     offset,     1
                CMP     offset,     8           :wz
    if(!Z)      JMP     lockret_loop
                JMP     nrel(_end)
var offset:     LONG    0
var timer:      LONG    0
var start:      LONG    0
var finish:     LONG    0
var scratch:    LONG    0
var spare:      LONG    0
var lock:       LONG    0
var expected:   LONG    0
var failures:   LONG    0

