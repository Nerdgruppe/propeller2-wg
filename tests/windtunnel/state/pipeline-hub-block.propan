//? WINDTUNNEL CHECK LIST
//? post: cog[*].reg[failures] == 0
//? macro: setq required
//? macro: probe_lut required
//? macro: cmp required
//? macro: mov required
//?
//? run: "0-0"
//? macro: setq set SETQ
//? macro: probe_lut set
//? macro: cmp set
//? macro: mov set
//? cog: 0
//? const: probe_cog = 0
//?
//? run: "0-1"
//? macro: setq set SETQ2
//? macro: probe_lut set // A zero-phase SETQ2 write misses this window during LUT source setup and waits a full rotation.
//? macro: cmp set CMP expected, 0 :wz
//? macro: mov set if(Z) MOV expected, 8
//? cog: 0
//? const: probe_cog = 0
//?
//? run: "1-0"
//? macro: setq set SETQ
//? macro: probe_lut set
//? macro: cmp set
//? macro: mov set
//? cog: 1
//? const: probe_cog = 1
//?
//? run: "1-1"
//? macro: setq set SETQ2
//? macro: probe_lut set // A zero-phase SETQ2 write misses this window during LUT source setup and waits a full rotation.
//? macro: cmp set CMP expected, 0 :wz
//? macro: mov set if(Z) MOV expected, 8
//? cog: 1
//? const: probe_cog = 1
//?
//? run: "2-0"
//? macro: setq set SETQ
//? macro: probe_lut set
//? macro: cmp set
//? macro: mov set
//? cog: 2
//? const: probe_cog = 2
//?
//? run: "2-1"
//? macro: setq set SETQ2
//? macro: probe_lut set // A zero-phase SETQ2 write misses this window during LUT source setup and waits a full rotation.
//? macro: cmp set CMP expected, 0 :wz
//? macro: mov set if(Z) MOV expected, 8
//? cog: 2
//? const: probe_cog = 2
//?
//? run: "3-0"
//? macro: setq set SETQ
//? macro: probe_lut set
//? macro: cmp set
//? macro: mov set
//? cog: 3
//? const: probe_cog = 3
//?
//? run: "3-1"
//? macro: setq set SETQ2
//? macro: probe_lut set // A zero-phase SETQ2 write misses this window during LUT source setup and waits a full rotation.
//? macro: cmp set CMP expected, 0 :wz
//? macro: mov set if(Z) MOV expected, 8
//? cog: 3
//? const: probe_cog = 3
//?
//? run: "4-0"
//? macro: setq set SETQ
//? macro: probe_lut set
//? macro: cmp set
//? macro: mov set
//? cog: 4
//? const: probe_cog = 4
//?
//? run: "4-1"
//? macro: setq set SETQ2
//? macro: probe_lut set // A zero-phase SETQ2 write misses this window during LUT source setup and waits a full rotation.
//? macro: cmp set CMP expected, 0 :wz
//? macro: mov set if(Z) MOV expected, 8
//? cog: 4
//? const: probe_cog = 4
//?
//? run: "5-0"
//? macro: setq set SETQ
//? macro: probe_lut set
//? macro: cmp set
//? macro: mov set
//? cog: 5
//? const: probe_cog = 5
//?
//? run: "5-1"
//? macro: setq set SETQ2
//? macro: probe_lut set // A zero-phase SETQ2 write misses this window during LUT source setup and waits a full rotation.
//? macro: cmp set CMP expected, 0 :wz
//? macro: mov set if(Z) MOV expected, 8
//? cog: 5
//? const: probe_cog = 5
//?
//? run: "6-0"
//? macro: setq set SETQ
//? macro: probe_lut set
//? macro: cmp set
//? macro: mov set
//? cog: 6
//? const: probe_cog = 6
//?
//? run: "6-1"
//? macro: setq set SETQ2
//? macro: probe_lut set // A zero-phase SETQ2 write misses this window during LUT source setup and waits a full rotation.
//? macro: cmp set CMP expected, 0 :wz
//? macro: mov set if(Z) MOV expected, 8
//? cog: 6
//? const: probe_cog = 6
//?
//? run: "7-0"
//? macro: setq set SETQ
//? macro: probe_lut set
//? macro: cmp set
//? macro: mov set
//? cog: 7
//? const: probe_cog = 7
//?
//? run: "7-1"
//? macro: setq set SETQ2
//? macro: probe_lut set // A zero-phase SETQ2 write misses this window during LUT source setup and waits a full rotation.
//? macro: cmp set CMP expected, 0 :wz
//? macro: mov set if(Z) MOV expected, 8
//? cog: 7
//? const: probe_cog = 7

// Measure SETQ/SETQ2 block reads and writes across banks, phases and alignment.
// Lengths 1, 2, 8, 9 and 64 span single transfers and RAM rotations; SETQ2 writes need an extra source-setup clock.
// Hardware block deltas use phase = (bank + 2 - start_CT - cog) & 7, plus length - 1 beats.
// Read/write bases are 13/7 clocks including SETQ; unaligned blocks add one crossing clock.

                MOV     address,        aug(hubaddr(buffer))
                MOV     PTRA,           aug(hubaddr(lengths))
                MOV     length_index,   0
length_loop:
                RDLONG  length, PTRA++
                SUB     length, 1
                MOV     bank,   0
bank_loop:
                MOV     alignment,  0
alignment_loop:
                MOV     crossing,   0
                CMP     alignment,  0   :wz
    if(!Z)      MOV     crossing,   1
                MOV     offset,     0
phase_loop:
                GETCT   timer
                // Synchronize safely in the future; offset then selects each CT modulo-eight phase.
                ADD     timer,          128
                ANDN    timer,          7
                ADD     timer,          offset
                ADDCT1  timer,          0
                WAITCT1
                GETCT   start
                {{ setq }}  length
                RDLONG  register(200),  address
                GETCT   finish
                SUB     finish,         start
                AND     start,          7
                MOV     expected,       bank
                ADD     expected,       2
                SUB     expected,       start
                SUB     expected,       probe_cog
                AND     expected,       7
                ADD     expected,       13
                ADD     expected,       length
                ADD     expected,       crossing
                CMP     finish,         expected                :wz
    if(!Z)      ADD     failures,       1
                GETCT   timer
                ADD     timer,          128
                ANDN    timer,          7
                ADD     timer,          offset
                ADDCT1  timer,          0
                WAITCT1
                GETCT   start
                {{ setq }}  length
                WRLONG  register(200),  address
                GETCT   finish
                SUB     finish,         start
                AND     start,          7
                MOV     expected,       bank
                ADD     expected,       2
                SUB     expected,       start
                SUB     expected,       probe_cog
                AND     expected,       7
                {{ probe_lut }}
                {{ cmp }}
                {{ mov }}
                ADD     expected,       7
                ADD     expected,       length
                ADD     expected,       crossing
                CMP     finish,         expected                :wz
    if(!Z)      ADD     failures,       1
                ADD     offset,         1
                CMP     offset,         8                       :wz
    if(!Z)      JMP     phase_loop
                ADD     address,        1
                ADD     alignment,      1
                CMP     alignment,      4                       :wz
    if(!Z)      JMP     alignment_loop
                ADD     bank,           1
                CMP     bank,           8                       :wz
    if(!Z)      JMP     bank_loop
                MOV     address,        aug(hubaddr(buffer))
                ADD     length_index,   1
                CMP     length_index,   5                       :wz
    if(!Z)      JMP     length_loop
                JMP     nrel(_end)
var length_index:
                LONG    0
var length:     LONG    0
var bank:       LONG    0
var alignment:  LONG    0
var crossing:   LONG    0
var offset:     LONG    0
var address:    LONG    0
var start:      LONG    0
var finish:     LONG    0
var expected:   LONG    0
var failures:   LONG    0
var timer:      LONG    0
.data
lengths:        LONG    1,  2,  8,  9,  64
// A 32-byte-aligned base makes successive longs select hub slices 0 through 7.
.align  32
buffer:         LONG    [0x12345678] * 73

