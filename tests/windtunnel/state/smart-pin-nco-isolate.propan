// Use nominal 20 MHz RCFAST and retain the ROM-calibrated UART divider.

                WRPIN   aug((6 << 1) | (tt << 6)),  4
                WXPIN   1,                          4
                DIRH    4
                WYPIN   aug(y),                     4
                WAITX   100
                RQPIN   result,                     4
                MOV     marker,                     123
                DIRL    4
                WAITX   16
                RQPIN   held,                       4

                // Restore RCFAST before the shared reporter uses the ROM-calibrated UART.
                HUBSET  0xF0
                WAITX   64
                JMP     nrel(_end)

var result:     LONG    0
var marker:     LONG    0
var held:       LONG    0

