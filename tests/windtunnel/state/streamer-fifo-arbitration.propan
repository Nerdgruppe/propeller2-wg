                // Software writes share the FIFO with a full-rate pin capture command.
                MOV     OUTA,                                       0
                MOV     DIRA,                                       aug(0xffffffff)
                WAITX   20
                WRFAST  0,                                          aug(hubaddr(buffer))
                SETXFRQ aug(0x80000000)
                XINIT   aug(X_32P_4DAC8_WFLONG | X_WRITE_ON | 64),  0
                MOV     count,                                      20
loop:
                WFLONG  aug(0xa5a5a5a5)
                DJNZ    count,  loop
                WAITXFI
                GETPTR  amount
                SUB     amount, aug(hubaddr(buffer))
                WAITX   aug(1000)
                MOV     DIRA,   0
                JMP     nrel(_end)
var count:      LONG    0
var amount:     LONG    0
.data
.align  4
var buffer:     LONG    [0xcc] * 128

