//? post: hub[buffer] == u32 [
//?     0x0 0x0 0x0 0x0 0xa5a5a5a5 0x0 0x0 0x0
//?     0x0 0x0 0x0 0x0 0xa5a5a5a5 0x0 0x0 0x0
//?     0x0 0x0 0x0 0x0 0xa5a5a5a5 0x0 0x0 0x0
//?     0x0 0x0 0x0 0x0 0xa5a5a5a5 0x0 0x0 0x0
//?     0x0 0x0 0x0 0x0 0xa5a5a5a5 0x0 0x0 0x0
//?     0x0 0x0 0x0 0x0 0xa5a5a5a5 0x0 0x0 0x0
//?     0x0 0x0 0x0 0x0 0xa5a5a5a5 0x0 0x0 0x0
//?     0x0 0x0 0x0 0x0 0xa5a5a5a5 0x0 0x0 0x0
