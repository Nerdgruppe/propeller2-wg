//? post: cog[*].reg[falling] == 0x00000000

// Use nominal 20 MHz RCFAST and retain the ROM-calibrated UART divider.

                // Sweep individual clocks around the GPIO output/input boundary.
                DRVL    0
                WRPIN   aug(out_sync << 16),                0
                WRPIN   aug(0x70000000 | (in_sync << 16)),  1
                WAITX   32
                OUTH    0
.if gap
                WAITX   gap
.endif
                TESTP   1                                       :wc
                WRC     rising
                WAITX   32
                OUTL    0
.if gap
                WAITX   gap
.endif
                TESTP   1                                       :wc
                WRC     falling
                DIRL    0

                // Restore RCFAST before the shared reporter uses the ROM-calibrated UART.
                HUBSET  0xF0
                WAITX   64
                JMP     nrel(_end)

var rising:     LONG    0
var falling:    LONG    0

