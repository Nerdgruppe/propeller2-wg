//? WINDTUNNEL CHECK LIST
//? timeout-ms: 10000
//? max-cycles: 4000000
//? post: cog[*].reg[failures] == 0
//?
//? run: "cog0"
//? cog: 0
//? const: probe_cog = 0
//?
//? run: "cog1"
//? cog: 1
//? const: probe_cog = 1
//?
//? run: "cog2"
//? cog: 2
//? const: probe_cog = 2
//?
//? run: "cog3"
//? cog: 3
//? const: probe_cog = 3
//?
//? run: "cog4"
//? cog: 4
//? const: probe_cog = 4
//?
//? run: "cog5"
//? cog: 5
//? const: probe_cog = 5
//?
//? run: "cog6"
//? cog: 6
//? const: probe_cog = 6
//?
//? run: "cog7"
//? cog: 7
//? const: probe_cog = 7

                // Sweep outstanding-write handover across all data banks and CT phases.
                MOV     address,    aug(hubaddr(payload))
                MOV     bank,       0
bank_loop:
                MOV     phase,  0
phase_loop:
                WRLONG  0,      address
                WRFAST  0,      address
                GETCT   timer
                ADD     timer,  128
                ANDN    timer,  7
                ADD     timer,  phase
                ADDCT1  timer,  0
                WAITCT1
                GETCT   start
                WFLONG  value
                JMP     nrel(hub_code)
local_return:
                GETPTR  returned
                MOV     expected,   aug(hubaddr(hub_return) + 8)
                CMP     returned,   expected                                    :wz
    if(!Z)      ADD     failures,   1
                SUB     finish,     start
                // JMP executes at start+4; the pending write becomes ready on that same edge.
                MOV     grant,      bank
                SUB     grant,      start
                SUB     grant,      probe_cog
                SUB     grant,      4
                AND     grant,      7
                ADD     grant,      4
                ADD     grant,      start
                // Fetch setup overlaps draining; allow five clocks from JMP and two from the last write.
                ADD     grant,      2
                MOV     minimum,    start
                ADD     minimum,    9
                FGE     grant,      minimum
                MOV     expected,   aug(hubaddr(hub_code) >> 2)
                SUB     expected,   grant
                SUB     expected,   probe_cog
                AND     expected,   7
                ADD     expected,   grant
                ADD     expected,   8
                SUB     expected,   start
                CMP     finish,     expected                                    :wz
    if(!Z)      ADD     failures,   1
                MOV     expected,   aug(hubaddr(hub_pointer_instruction) + 4)
                CMP     pointer,    expected                                    :wz
    if(!Z)      ADD     failures,   1
                // Returning to cog execution leaves the prefetched instruction stream readable as data.
                RFLONG  loaded
                CMP     loaded,     value                                       :wz
    if(!Z)      ADD     failures,   1
                RDLONG  loaded,     address
                CMP     loaded,     value                                       :wz
    if(!Z)      ADD     failures,   1
                ADD     phase,      1
                CMP     phase,      8                                           :wz
    if(!Z)      JMP     phase_loop
                ADD     address,    4
                ADD     bank,       1
                CMP     bank,       8                                           :wz
    if(!Z)      JMP     bank_loop
                JMP     nrel(_end)
var address:    LONG    0
var bank:       LONG    0
var phase:      LONG    0
var timer:      LONG    0
var start:      LONG    0
var finish:     LONG    0
var grant:      LONG    0
var minimum:    LONG    0
var expected:   LONG    0
var pointer:    LONG    0
var returned:   LONG    0
var loaded:     LONG    0
var value:      LONG    0x12345678
var failures:   LONG    0
.data
.align  32
payload:        LONG    [0] * 32
.hubexec    0x2000
hub_code:
                GETCT   finish
                WAITX   32
                RDLONG  loaded, address
hub_pointer_instruction:
                GETPTR  pointer
hub_return:
                JMP     nrel(local_return)
                NOP
                LONG    0x12345678

