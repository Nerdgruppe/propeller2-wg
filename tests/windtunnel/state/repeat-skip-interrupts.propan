//? WINDTUNNEL CHECK LIST
//? timeout-ms: 1000
//? macro: selected_kind required
//? macro: selected_kind_2 required
//? macro: skip default
//?
//? run: "kind0-cog0"
//? macro: selected_kind set REP 3, 3
//? macro: selected_kind_2 set NOP
//? cog: 0
//? post: cog[*].reg[count] == 3
//? post: cog[*].reg[observed] == 3
//? post: cog[*].reg[finish] == 52
//? post: cog[*].reg[stamp] == 26
//? post: cog[*].reg[saved] == 7
//? post: cog[*].reg[inside] == 0
//? post: cog[*].reg[inside_pattern] == 0
//? post: cog[*].reg[nested] == 0
//? post: cog[*].reg[nested_pattern] == 0
//? post: cog[*].reg[after_pattern] == 0
//? post: cog[*].reg[sequence] == 1
//?
//? run: "kind0-cog7"
//? macro: selected_kind set REP 3, 3
//? macro: selected_kind_2 set NOP
//? cog: 7
//? post: cog[*].reg[count] == 3
//? post: cog[*].reg[observed] == 3
//? post: cog[*].reg[finish] == 52
