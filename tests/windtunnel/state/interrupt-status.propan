//? WINDTUNNEL CHECK LIST
//? timeout-ms: 1000
//? post: cog[3].reg[ct1] == 2
//? post: cog[3].reg[ct2] == 4
//? post: cog[3].reg[ct3] == 8
//? post: cog[3].reg[zero] == 0
//? post: cog[3].reg[zflag] == 1
//?
//? run: "event-view"
//? cog: 3

                // Normalize reset and bootloader event latches before testing GETBRK.
                GETCT   future
                ADD     future, aug(100000)
                ADDCT1  future, 0
                ADDCT2  future, 0
                ADDCT3  future, 0
                SETSE1  0
                SETSE2  0
                SETSE3  0
                SETSE4  0
                POLLATN
                ADDCT1  future, aug(-100000)
                NOP
                GETBRK  ct1                     :wc
                ADDCT1  future, aug(100000)
                ADDCT2  future, aug(-100000)
                NOP
                GETBRK  ct2                     :wc
                ADDCT2  future, aug(100000)
                ADDCT3  future, aug(-100000)
                NOP
                GETBRK  ct3                     :wc
                GETBRK  zero                    :wz
                WRZ     zflag
                JMP     nrel(_end)
var future:     LONG    0
var ct1:        LONG    0
var ct2:        LONG    0
var ct3:        LONG    0
var zero:       LONG    0
var zflag:      LONG    0

