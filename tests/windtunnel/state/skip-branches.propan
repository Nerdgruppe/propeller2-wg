// Observe nonlinear branch bases, absolute-target behavior and saved returns.
.if fast
                SKIPF   2
.else
                SKIP    2
.endif
.if kind == 0
                JMP     destination
.elif   kind == 1
                JMP     nrel(destination)
.elif   kind == 2
                JMP     target
.elif   kind == 3
                JMPREL  distance
.elif   kind == 4
                CALL    target
.elif   kind == 5
                CALL    destination
.elif   kind == 6
                TJZ     value,  destination
.else
                CALLD   link,   target
.endif
                NOP
                MOV     after,  1
                JMP     nrel(checked)
destination:
                ADD     landed, 1
                ADD     landed, 2
.if kind == 4
                POP     link
.elif   kind == 5
                POP     link
.endif
                JMP     nrel(checked)
checked:
                GETBRK  inside                  :wc
                GETBRK  pattern_out             :wz
                SKIP    0
                AND     inside, aug(0xF8000000)
                JMP     nrel(_end)
var target:     LONG    pcaddr(destination)
var distance:   LONG    3
var landed:     LONG    0
var value:      LONG    0
var link:       LONG    0
var elapsed:    LONG    0
var a:          LONG    0
var b:          LONG    0
var inside:     LONG    0
var after:      LONG    0
var pattern_out:
                LONG    0

