//? post: cog[*].reg[after] == 0
//? post: cog[*].reg[pattern_out] == 0

// Observe nonlinear branch bases, absolute-target behavior and saved returns.
                {{ skip }}  2
                {{ selected_kind }}
                NOP
                MOV     after,  1
                JMP     nrel(checked)
destination:
                ADD     landed, 1
                ADD     landed, 2
                {{ pop }}
                JMP     nrel(checked)
checked:
                GETBRK  inside                  :wc
                GETBRK  pattern_out             :wz
                SKIP    0
                AND     inside, aug(0xF8000000)
                JMP     nrel(_end)
var target:     LONG    pcaddr(destination)
var distance:   LONG    3
var landed:     LONG    0
var value:      LONG    0
var link:       LONG    0
var elapsed:    LONG    0
var a:          LONG    0
var b:          LONG    0
var inside:     LONG    0
var after:      LONG    0
var pattern_out:
                LONG    0

