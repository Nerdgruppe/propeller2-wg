//? macro: nop_6 override NOP
//? cog: 0
//? post: cog[*].reg[pa_out] == 1
//? post: cog[*].reg[pb_out] == 16385
//? post: cog[*].reg[elapsed] == 28
//? post: cog[*].reg[status] == 33554432
//? post: cog[*].reg[q_out] == 0
