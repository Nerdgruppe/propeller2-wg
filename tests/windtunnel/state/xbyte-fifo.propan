//? run: "cog0-gap3"
//? macro: nop set NOP
//? macro: nop_2 set NOP
//? macro: nop_3 set NOP
//? macro: nop_4 set
//? cog: 0
//? post: cog[*].reg[pa_out] == 0
//? post: cog[*].reg[pb_out] == 16384
//? post: cog[*].reg[elapsed] == 22
//? post: cog[*].reg[status] == 33554432
//? post: cog[*].reg[q_out] == 0
//?
//? run: "cog7-gap5"
//? macro: nop set NOP
//? macro: nop_2 set NOP
//? macro: nop_3 set NOP
//? macro: nop_4 set NOP
//? macro: nop_5 override NOP
//? cog: 7
//? post: cog[*].reg[pa_out] == 1
//? post: cog[*].reg[pb_out] == 16385
//? post: cog[*].reg[elapsed] == 26
//? post: cog[*].reg[status] == 33554432
//? post: cog[*].reg[q_out] == 0
//?
//? run: "cog7-gap1"
//? macro: nop set NOP
//? macro: nop_2 set
//? macro: nop_3 set
//? macro: nop_4 set
//? cog: 7
//? post: cog[*].reg[pa_out] == 0
//? post: cog[*].reg[pb_out] == 16384
//? post: cog[*].reg[elapsed] == 18
//? post: cog[*].reg[status] == 33554432
//? post: cog[*].reg[q_out] == 0

                // Both possible bytes reach the same handler; PA and PB reveal empty-FIFO behavior.
                WRLUT   nrel(handler),      0
                WRLUT   nrel(handler),      1
                PUSH    0x1ff
                GETCT   start
                RDFAST  aug(0x80000000),    aug(hubaddr(bytecodes))
                {{ nop }}
                {{ nop_2 }}
                {{ nop_3 }}
                {{ nop_4 }}
                {{ nop_5 }}
                {{ nop_6 }}
                {{ nop_7 }}
    return      SETQ    0
handler:
                GETCT   elapsed
                MOV     pa_out,     PA
                MOV     pb_out,     PB
                GETBRK  status                      :wc
                MOV     q_out,      0
                MUXQ    q_out,      all_bits
                POP     discarded
                SUB     elapsed,    start
                AND     status,     aug(0xffff0000)
                JMP     nrel(_end)
var pa_out:     LONG    0
var pb_out:     LONG    0
var elapsed:    LONG    0
var start:      LONG    0
var status:     LONG    0
var q_out:      LONG    0
var all_bits:   LONG    0xffffffff
var discarded:  LONG    0
.hubexec    0x4000
bytecodes:      BYTE    1,  1,  1,  1

