//? post: cog[*].reg[q_out] == 0

                // Both possible bytes reach the same handler; PA and PB reveal empty-FIFO behavior.
                WRLUT   nrel(handler),      0
                WRLUT   nrel(handler),      1
                PUSH    0x1ff
                GETCT   start
                RDFAST  aug(0x80000000),    aug(hubaddr(bytecodes))
.if gap >= 1
                NOP
.endif
.if gap >= 2
                NOP
.endif
.if gap >= 3
                NOP
.endif
.if gap >= 4
                NOP
.endif
.if gap >= 5
                NOP
.endif
.if gap >= 6
                NOP
.endif
.if gap >= 7
                NOP
.endif
    return      SETQ    0
handler:
                GETCT   elapsed
                MOV     pa_out,     PA
                MOV     pb_out,     PB
                GETBRK  status                      :wc
                MOV     q_out,      0
                MUXQ    q_out,      all_bits
                POP     discarded
                SUB     elapsed,    start
                AND     status,     aug(0xffff0000)
                JMP     nrel(_end)
var pa_out:     LONG    0
var pb_out:     LONG    0
var elapsed:    LONG    0
var start:      LONG    0
var status:     LONG    0
var q_out:      LONG    0
var all_bits:   LONG    0xffffffff
var discarded:  LONG    0
.hubexec    0x4000
bytecodes:      BYTE    1,  1,  1,  1

