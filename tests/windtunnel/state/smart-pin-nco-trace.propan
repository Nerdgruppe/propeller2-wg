// Select the test clock while retaining the ROM-calibrated UART divider for reporting.
.if pll
                HUBSET  aug(0x010009f8)
                WAITX   aug(200000)
                HUBSET  aug(0x010009fb)
                WAITX   64
.endif

                WRPIN   12,     4
                WXPIN   aug(x), 4
                DIRH    4
                WYPIN   aug(y), 4
                RQPIN   z0,     4
                RQPIN   z1,     4
                RQPIN   z2,     4
                RQPIN   z3,     4
                RQPIN   z4,     4
                RQPIN   z5,     4
                RQPIN   z6,     4
                RQPIN   z7,     4
                RQPIN   z8,     4
                RQPIN   z9,     4
                RQPIN   z10,    4
                RQPIN   z11,    4
                RQPIN   z12,    4
                RQPIN   z13,    4
                RQPIN   z14,    4
                RQPIN   z15,    4
                DIRL    4

                // Restore RCFAST before the shared reporter uses the ROM-calibrated UART.
                HUBSET  0xF0
                WAITX   64
                JMP     nrel(_end)

var z0:         LONG    0
var z1:         LONG    0
var z2:         LONG    0
var z3:         LONG    0
var z4:         LONG    0
var z5:         LONG    0
var z6:         LONG    0
var z7:         LONG    0
var z8:         LONG    0
var z9:         LONG    0
var z10:        LONG    0
var z11:        LONG    0
var z12:        LONG    0
var z13:        LONG    0
var z14:        LONG    0
var z15:        LONG    0

