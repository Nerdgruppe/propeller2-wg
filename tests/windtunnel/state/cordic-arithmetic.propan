//? macro: selected_operation set QEXP input_d
//? cog: 7
//? const: operation = 7

                // Hardware measurements from the local P2AAS board, 2026-10-10.
                // Original captures and reproduction instructions: data/cordic/README.md.
                // Each row is Q, D, S, expected X, expected Y. Includes boundaries and seeded random inputs.
                // Check both result words and their sign/zero flags through the instruction pipeline.
                MOV     PTRB,       aug(hubaddr(vectors))
                MOV     remaining,  vector_count
loop:
                SETQ    4
                RDLONG  input_q,    PTRB++
                SETQ    input_q
                {{ selected_operation }}
                GETQX   actual                  :wcz
                WRC     actual_c
                WRZ     actual_z
                MOV     expected,   expected_x
                CALL    check
                GETQY   actual                  :wcz
                WRC     actual_c
                WRZ     actual_z
                MOV     expected,   expected_y
                CALL    check
                DJNZ    remaining,  loop
                SETQ    0
                JMP     nrel(_end)

// Compare flags against the measured result as well as the value itself.
check:
                CMP     actual,     expected    :wz
    if(!Z)      ADD     failures,   1
                MOV     sign,       expected
                SHR     sign,       31
                CMP     actual_c,   sign        :wz
    if(!Z)      ADD     failures,   1
                CMP     expected,   0           :wz
                WRZ     sign
                CMP     actual_z,   sign        :wz
    if(!Z)      ADD     failures,   1
                RET
var failures:   LONG    0
var remaining:  LONG    0
var actual:     LONG    0
var actual_c:   LONG    0
var actual_z:   LONG    0
var expected:   LONG    0
var sign:       LONG    0
var input_q:    LONG    0
var input_d:    LONG    0
var input_s:    LONG    0
var expected_x: LONG    0
var expected_y: LONG    0
.data
