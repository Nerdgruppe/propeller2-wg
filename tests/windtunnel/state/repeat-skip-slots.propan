                // Measure canceled slots and PC stepping, without branch destinations in the pattern.
                GETCT   start
                {{ selected_kind }}
                ADD     value,      1
                ADD     value,      1
                ADD     value,      1
                ADD     value,      1
                ADD     value,      1
                ADD     value,      1
                ADD     value,      1
                ADD     value,      1
                ADD     value,      1
                ADD     value,      1
                ADD     value,      1
                ADD     value,      1
                ADD     value,      1
                ADD     value,      1
                ADD     value,      1
                ADD     value,      1
                ADD     value,      1
                ADD     value,      1
                ADD     value,      1
                ADD     value,      1
                ADD     value,      1
                ADD     value,      1
                ADD     value,      1
                ADD     value,      1
                ADD     value,      1
                ADD     value,      1
                ADD     value,      1
                ADD     value,      1
                ADD     value,      1
                ADD     value,      1
                ADD     value,      1
                ADD     value,      1
                GETCT   finish
                MOV     elapsed,    finish
                SUB     elapsed,    start
                GETBRK  status                      :wc
                GETBRK  pattern_out                 :wz
                AND     status,     aug(0xF8000000)
                JMP     nrel(_end)
var value:      LONG    0
var elapsed:    LONG    0
var status:     LONG    0
var pattern_out:
                LONG    0
var start:      LONG    0
var finish:     LONG    0

