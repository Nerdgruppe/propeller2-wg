                // Retain background values while freezing the first raw 32-bit sample.
                SETDACS aug(0x78563412)
                SETXFRQ 0
                XINIT   aug(X_IMM_1X32_4DAC8 | (selector << 24) | 0xffff),  aug(0xefcdab89)
                WAITX   10
                JMP     nrel(_end)

