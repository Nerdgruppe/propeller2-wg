                // A fast neighbor is observed using the selected receiver path; no wiring changes are needed.
                DIRL    aug(40 | (1 << 6))
                OUTL    40
                WRPIN   0,              40
                WRPIN   aug(0x168000),  41
                DIRH    41
                WAITX   100
                DIRL    41
                WRPIN   aug(config),    41
                DIRH    40
.if !level
                OUTH    40
.endif
                WAITX   200
.if level
                OUTH    40
.else
                OUTL    40
.endif
                WAITX   delay
                TESTP   41                                  :wc
                MOV     value,          0
                MUXC    value,          1
                DIRL    aug(40 | (1 << 6))
                WRPIN   0,              aug(40 | (1 << 6))
                JMP     nrel(_end)
var value:      LONG    0

