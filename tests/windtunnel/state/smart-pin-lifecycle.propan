//? post: cog[*].reg[held_ready] == 0x00000000
//? post: cog[*].reg[initial] == 0x00000000
//? post: cog[*].reg[initial_flag] == 0x00000000
//? post: cog[*].reg[changed_y] == 0x00000000
//? post: cog[*].reg[changed_x] == 0x00000000
//? post: cog[*].reg[ack_ready] == 0x00000000
//? post: cog[*].reg[reconfigured] == 0x00000000
//? post: cog[*].reg[reset] == 0x00000000
//? post: cog[*].reg[reset_flag] == 0x00000000
//? post: cog[*].reg[restarted] == 0x00000000

// Select the test clock while retaining the ROM-calibrated UART divider for reporting.
.if pll
                HUBSET  aug(0x010009f8)
                WAITX   aug(200000)
                HUBSET  aug(0x010009fb)
                WAITX   64
.endif

                // Hold reset while establishing parameters; P3/P5 are independent GPIO inputs.
                DRVL    3
                DRVL    5
                WRPIN   aug(0x71000000 | (mode << 1) | P_TT_01),    4
                WXPIN   aug(x),                                     4
                WYPIN   aug(y),                                     4
                WAITX   16
                RQPIN   held,                                       4   :wc
                WRC     held_flag
                TESTP   4                                               :wc
                WRC     held_ready
                // Exercise edges and change Y and X while the engine is running.
                DIRH    4
                WYPIN   aug(y),                                     4
                OUTH    3
                WAITX   4
                OUTH    5
                WAITX   6
                RQPIN   initial,                                    4   :wc
                WRC     initial_flag
                WYPIN   aug(ny),                                    4
                WAITX   3
                RQPIN   changed_y,                                  4
                WXPIN   aug(nx),                                    4
                WAITX   5
                RQPIN   changed_x,                                  4
                AKPIN   4
                WAITX   4
                TESTP   4                                               :wc
                WRC     ack_ready
                // Reconfigure an enabled engine, then reset and re-enable without rewriting parameters.
                WRPIN   aug(0x71000000 | (mode << 1) | P_TT_01),    4
                OUTL    3
                WAITX   8
                OUTL    5
                WAITX   4
                RQPIN   reconfigured,                               4
                DIRL    4
                WAITX   16
                RQPIN   reset,                                      4   :wc
                WRC     reset_flag
                DIRH    4
                WAITX   16
                RQPIN   restarted,                                  4
                DIRL    4
                DIRL    3
                DIRL    5

                // Restore RCFAST before the shared reporter uses the ROM-calibrated UART.
                HUBSET  0xF0
                WAITX   64
                JMP     nrel(_end)

var held:       LONG    0
var held_flag:  LONG    0
var held_ready: LONG    0
var initial:    LONG    0
var initial_flag:
                LONG    0
var changed_y:  LONG    0
var changed_x:  LONG    0
var ack_ready:  LONG    0
var reconfigured:
                LONG    0
var reset:      LONG    0
var reset_flag: LONG    0
var restarted:  LONG    0

