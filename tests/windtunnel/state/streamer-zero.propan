//? WINDTUNNEL CHECK LIST
//? macro: xinit required
//? macro: cont required
//?
//? run: "XINIT zero from idle"
//? macro: xinit set
//? macro: cont set XSTOP
//? post: cog[*].reg[result] == 0
//?
//? run: "XINIT zero from active"
//? macro: xinit set XINIT aug(X_IMM_1X32_4DAC8 | 8), 0
//? macro: cont set XSTOP
//? post: cog[*].reg[result] == 6
//?
//? run: "XCONT zero from idle"
//? macro: xinit set
//? macro: cont set XCONT 0, 0
//? post: cog[*].reg[result] == 1
//?
//? run: "XCONT zero from active"
//? macro: xinit set XINIT aug(X_IMM_1X32_4DAC8 | 8), 0
//? macro: cont set XCONT 0, 0
//? post: cog[*].reg[result] == 7

                // Read event latches after a zero-duration stop command.
                MOV     result,                     0
                SETXFRQ aug(0x40000000)
                {{ xinit }}
                {{ cont }}
                WAITX   100
                POLLXMT :wc
                MUXC    result,                     1
                POLLXFI :wc
                MUXC    result,                     2
                POLLXRO :wc
                MUXC    result,                     4
                JMP     nrel(_end)
var result:     LONG    0
