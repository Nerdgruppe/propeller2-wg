//? post: cog[0].reg[r10] == 6
//? post: cog[0].reg[r11] == 10

                // Set a stable digital input and constant sine/cosine table at a 1 MHz DUT clock.
                HUBSET  aug(0x01000098)
                WAITX   aug(300000)
                HUBSET  aug(0x0100009b)
                DRVH    0
                MOV     index,  0
fill_table:
                WRLUT   aug(0x05030000),                        index
                ADD     index,                                  1
                CMP     index,                                  aug(512)    :wz
    if(!Z)      JMP     fill_table
                SETQ    aug(0x10000000)
                XINIT   aug(0xf007ffff | (sinc << 23)),         aug(0x1000)
                WAITX   delay
                // Capture repeatedly while active; the following instruction consumes the full sine value.
                GETXACC r0
                MOV     r1,                                     0
                GETXACC r2
                MOV     r3,                                     0
                // Queue a command with new SINC selection and verify captures across its activation.
                XCONT   aug(0xf007ffff | ((1 - sinc) << 23)),   aug(0x1000)
                GETXACC r4
                MOV     r5,                                     0
                WAITXMT
                GETXACC r6
                MOV     r7,                                     0
                // Explicit stop and a zero-count command retain stopped arithmetic registers.
                XSTOP
                GETXACC r8
                MOV     r9,                                     0
                XINIT   0,                                      0
                GETXACC r10
                MOV     r11,                                    0
                HUBSET  0xf0
                WAITX   aug(50000)
                DIRL    0
                JMP     nrel(_end)
var index:      LONG    0
var r0:         LONG    0
var r1:         LONG    0
var r2:         LONG    0
var r3:         LONG    0
var r4:         LONG    0
var r5:         LONG    0
var r6:         LONG    0
var r7:         LONG    0
var r8:         LONG    0
var r9:         LONG    0
var r10:        LONG    0
var r11:        LONG    0

