//? WINDTUNNEL CHECK LIST
//? timeout-ms: 1000
//? max-cycles: 500000
//?
//? run: "pll0-n1-p524288-phase0"
//? const: bits = 1
//? const: period = 524288
//? const: phase = 0
//? post: cog[*].reg[wave0] == 0xcfffffff
//? post: cog[*].reg[wave1] == 0xffffffff
//? post: cog[*].reg[wave2] == 0xffffffff
//? post: cog[*].reg[result] == 0x80000000
//? post: cog[*].reg[carry] == 0x00000001
//? post: cog[*].reg[ready] == 0x00000001
//? post: cog[*].reg[tx_result] == 0xe26af37b
//? post: cog[*].reg[busy] == 0x00000000
//?
//? run: "pll0-n8-p524288-phase0"
//? const: bits = 8
//? const: period = 524288
//? const: phase = 0
//? post: cog[*].reg[wave0] == 0xcff3ffff
//? post: cog[*].reg[wave1] == 0xffffffff
//? post: cog[*].reg[wave2] == 0xffffffff
//? post: cog[*].reg[result] == 0xef000000
//? post: cog[*].reg[carry] == 0x00000001
//? post: cog[*].reg[ready] == 0x00000001
//? post: cog[*].reg[tx_result] == 0xf7c4d5e6
//? post: cog[*].reg[busy] == 0x00000000
//?
//? run: "pll0-n32-p524288-phase0"
//? const: bits = 32
//? const: period = 524288
//? const: phase = 0
//? post: cog[*].reg[wave0] == 0xcff3fcf0
//? post: cog[*].reg[wave1] == 0xff333c30
//? post: cog[*].reg[wave2] == 0x3fffffff
//? post: cog[*].reg[result] == 0x89abcdef
//? post: cog[*].reg[carry] == 0x00000001
//? post: cog[*].reg[ready] == 0x00000001
//? post: cog[*].reg[tx_result] == 0xc4d5e6f7
//? post: cog[*].reg[busy] == 0x00000000
//?
//? run: "pll0-n8-p491520-phase0"
//? const: bits = 8
//? const: period = 491520
//? const: phase = 0
//? post: cog[*].reg[wave0] == 0xcfe7ffff
//? post: cog[*].reg[wave1] == 0xffffffff
//? post: cog[*].reg[wave2] == 0xffffffff
//? post: cog[*].reg[result] == 0xef000000
//? post: cog[*].reg[carry] == 0x00000001
//? post: cog[*].reg[ready] == 0x00000001
//? post: cog[*].reg[tx_result] == 0xf7c4d5e6
//? post: cog[*].reg[busy] == 0x00000000

// Use nominal 20 MHz RCFAST and retain the ROM-calibrated UART divider.

                // Initialize a UART loopback through physical routed pads, without endpoint injection.
                WRPIN   P_TT_01 | P_ASYNC_TX,           4
                WRPIN   aug(0x70000000 | P_ASYNC_RX),   5
                WRPIN   aug(0x60000000),                6
                WXPIN   aug(period | (bits - 1)),       4
                WXPIN   aug(period | (bits - 1)),       5
                DIRH    4
                DIRH    5
                WAITX   32
                WAITX   phase
                WYPIN   aug(0x89abcdef),                4

                // Observe 128 clocks of the transmitted physical level.
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1

                // Observe 128 clocks of the transmitted physical level.
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1

                // Observe 128 clocks of the transmitted physical level.
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1

                // Read completion, modal carry and result, then release pins.
                RQPIN   result,                         5                   :wc
                WRC     carry
                TESTP   5                                                   :wc
                WRC     ready
                RQPIN   tx_result,                      4                   :wc
                WRC     busy
                DIRL    4
                DIRL    5

                // TT-enabled smart outputs still drive in reset; restore GPIO before reporting.
                DIRL    aug(0 | (7 << 6))
                WRPIN   0,                              aug(0 | (7 << 6))

                // Restore RCFAST before the shared reporter uses the ROM-calibrated UART.
                HUBSET  0xF0
                WAITX   64
                JMP     nrel(_end)

var wave0:      LONG    0
var wave1:      LONG    0
var wave2:      LONG    0
var result:     LONG    0
var carry:      LONG    0
var ready:      LONG    0
var tx_result:  LONG    0
var busy:       LONG    0

