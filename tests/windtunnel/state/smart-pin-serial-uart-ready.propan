//? post: cog[*].reg[busy] == 0x0000c000
//? post: cog[*].reg[event] == 0x00002000
//? post: cog[*].reg[result] == 0xa5000000
//? post: cog[*].reg[ack] == 0x00000080
//? post: cog[*].reg[sample] == 0xd2800000
//? run: "pll1-phase6"
//? const: pll = 1
