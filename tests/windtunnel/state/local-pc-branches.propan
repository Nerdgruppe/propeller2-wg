//? WINDTUNNEL CHECK LIST
//? issues: pc_domain = 2
//? timeout-ms: 3000
//? macro: selected_kind required
//?
//? run: "kind0-cog0"
//? macro: selected_kind set CALLD link, target
//? post: cog[*].reg[link] == 0x401
//? post: cog[*].reg[hits] == 0x0
//? post: cog[*].reg[stamp_a] == 0x0
//? post: cog[*].reg[stamp_b] == 0x0
//? post: cog[*].reg[elapsed] == 0xe
//? post: cog[*].reg[landed] == 0x0
//? cog: 0
//?
//? run: "kind0-cog7"
//? macro: selected_kind set CALLD link, target
//? post: cog[*].reg[link] == 0x401
//? post: cog[*].reg[hits] == 0x0
//? post: cog[*].reg[stamp_a] == 0x0
//? post: cog[*].reg[stamp_b] == 0x0
//? post: cog[*].reg[elapsed] == 0xe
//? post: cog[*].reg[landed] == 0x0
//? cog: 7
//?
//? run: "kind1-cog0"
//? macro: selected_kind set CALLD PA, nrel(done)
//? post: cog[*].reg[link] == 0x0
//? post: cog[*].reg[hits] == 0x0
//? post: cog[*].reg[stamp_a] == 0x401
//? post: cog[*].reg[stamp_b] == 0x0
//? post: cog[*].reg[elapsed] == 0xe
//? post: cog[*].reg[landed] == 0x0
//? cog: 0
//?
//? run: "kind1-cog7"
//? macro: selected_kind set CALLD PA, nrel(done)
//? post: cog[*].reg[link] == 0x0
//? post: cog[*].reg[hits] == 0x0
//? post: cog[*].reg[stamp_a] == 0x401
//? post: cog[*].reg[stamp_b] == 0x0
//? post: cog[*].reg[elapsed] == 0xe
//? post: cog[*].reg[landed] == 0x0
//? cog: 7
//?
//? run: "kind2-cog0"
//? macro: selected_kind set LONG 0xfe100000 | (((pcaddr(done) - 0x401) * 4) & 0xfffff)
//? post: cog[*].reg[link] == 0x0
//? post: cog[*].reg[hits] == 0x0
//? post: cog[*].reg[stamp_a] == 0x401
//? post: cog[*].reg[stamp_b] == 0x0
//? post: cog[*].reg[elapsed] == 0xe
//? post: cog[*].reg[landed] == 0x0
//? cog: 0
//?
//? run: "kind2-cog7"
//? macro: selected_kind set LONG 0xfe100000 | (((pcaddr(done) - 0x401) * 4) & 0xfffff)
//? post: cog[*].reg[link] == 0x0
//? post: cog[*].reg[hits] == 0x0
//? post: cog[*].reg[stamp_a] == 0x401
//? post: cog[*].reg[stamp_b] == 0x0
//? post: cog[*].reg[elapsed] == 0xe
//? post: cog[*].reg[landed] == 0x0
//? cog: 7
//?
//? run: "kind3-cog0"
//? macro: selected_kind set RET
//? post: cog[*].reg[link] == 0x0
//? post: cog[*].reg[hits] == 0x0
//? post: cog[*].reg[stamp_a] == 0x0
//? post: cog[*].reg[stamp_b] == 0x0
//? post: cog[*].reg[elapsed] == 0xe
//? post: cog[*].reg[landed] == 0x0
//? cog: 0
//?
//? run: "kind3-cog7"
//? macro: selected_kind set RET
//? post: cog[*].reg[link] == 0x0
//? post: cog[*].reg[hits] == 0x0
//? post: cog[*].reg[stamp_a] == 0x0
//? post: cog[*].reg[stamp_b] == 0x0
//? post: cog[*].reg[elapsed] == 0xe
//? post: cog[*].reg[landed] == 0x0
//? cog: 7
//?
//? run: "kind4-cog0"
//? macro: selected_kind set return ADD hits, 1
//? post: cog[*].reg[link] == 0x0
//? post: cog[*].reg[hits] == 0x1
//? post: cog[*].reg[stamp_a] == 0x0
//? post: cog[*].reg[stamp_b] == 0x0
//? post: cog[*].reg[elapsed] == 0xe
//? post: cog[*].reg[landed] == 0x0
//? cog: 0
//?
//? run: "kind4-cog7"
//? macro: selected_kind set return ADD hits, 1
//? post: cog[*].reg[link] == 0x0
//? post: cog[*].reg[hits] == 0x1
//? post: cog[*].reg[stamp_a] == 0x0
//? post: cog[*].reg[stamp_b] == 0x0
//? post: cog[*].reg[elapsed] == 0xe
//? post: cog[*].reg[landed] == 0x0
//? cog: 7
//?
//? run: "kind5-cog0"
//? macro: selected_kind set CALLD PB, nrel(done)
//? post: cog[*].reg[link] == 0x0
//? post: cog[*].reg[hits] == 0x0
//? post: cog[*].reg[stamp_a] == 0x0
//? post: cog[*].reg[stamp_b] == 0x401
//? post: cog[*].reg[elapsed] == 0xe
//? post: cog[*].reg[landed] == 0x0
//? cog: 0
//?
//? run: "kind5-cog7"
//? macro: selected_kind set CALLD PB, nrel(done)
//? post: cog[*].reg[link] == 0x0
//? post: cog[*].reg[hits] == 0x0
//? post: cog[*].reg[stamp_a] == 0x0
//? post: cog[*].reg[stamp_b] == 0x401
//? post: cog[*].reg[elapsed] == 0xe
//? post: cog[*].reg[landed] == 0x0
//? cog: 7

// Raw CALLD PA, relative A20, is retained for the kind2 runs. Its displacement
// is relative to the overflow execution PC $400, not the emitted template PC.
// Native CALLD can select the short form and cannot request this exact A20 form.
                // Compare absolute/relative CALLD and stack returns from the first overflow instruction.
                // Keep setup beyond the cog-zero template that it installs.
                JMP     nrel(setup)
                NOP
                NOP
                NOP
                NOP
                NOP
                NOP
                NOP
                NOP
                NOP
                NOP
                NOP
                NOP
                NOP
                NOP
                NOP
                NOP
setup:
                // Install controlled instruction sources before entering the local boundary.
                SETQ    6
                RDLONG  register(0),    aug(hubaddr(cog_template))
                MOV     PTRA,           aug(hubaddr(tail_template))
                RDLONG  word,           PTRA++
                WRLUT   word,           aug(510)
                RDLONG  word,           PTRA++
                WRLUT   word,           aug(511)
                PUSH    target
                GETCT   start
                JMP     nrel(tail_template)
done:
                GETCT   elapsed
                SUB     elapsed,    start
                MOV     stamp_a,    PA
                MOV     stamp_b,    PB
                MOV     stamp_c,    PTRA
                JMP     nrel(_end)
hit1:
                MOV     landed, 1
                JMP     nrel(done)
hit2:
                MOV     landed, 2
                JMP     nrel(done)
hit3:
                MOV     landed, 3
                JMP     nrel(done)
hit4:
                MOV     landed, 4
                JMP     nrel(done)
hit5:
                MOV     landed, 5
                JMP     nrel(done)
hit6:
                MOV     landed, 6
                JMP     nrel(done)
var landed:     LONG    0
var target1:    LONG    pcaddr(hit1)
var target2:    LONG    pcaddr(hit2)
var target3:    LONG    pcaddr(hit3)
var target4:    LONG    pcaddr(hit4)
var target5:    LONG    pcaddr(hit5)
var target6:    LONG    pcaddr(hit6)
var link:       LONG    0
var target:     LONG    pcaddr(done)
var word:       LONG    0
var hits:       LONG    0
var stamp_a:    LONG    0
var stamp_b:    LONG    0
var stamp_c:    LONG    0
var start:      LONG    0
var elapsed:    LONG    0
.cogexec    0x3000, 0
cog_template:
                // These words are loaded into the physical cog instruction slots above.
                {{ selected_kind }}
                CALLD   link,   target1
                CALLD   link,   target2
                CALLD   link,   target3
                CALLD   link,   target4
                CALLD   link,   target5
                CALLD   link,   target6
.lutexec    0x3100, 0x3fe
tail_template:
                // Enter the final LUT words and continue with a retained logical PC.
                NOP
                NOP
