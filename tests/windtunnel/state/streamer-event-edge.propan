//? const: frequency = 536870912
//? const: mode = 4026990592
//? const: event = 1
//? const: consumer = 0
//? const: threshold = 0
//? run: "freq20000000-modef0070000-event1-consumer1"
//? const: frequency = 536870912
//? const: mode = 4026990592
//? const: event = 1
//? const: consumer = 1
//? const: threshold = 0
//? run: "freq20000000-modef0070000-event2-consumer0"
//? const: frequency = 536870912
//? const: mode = 4026990592
//? const: event = 2
//? const: consumer = 0
//? const: threshold = 0
//? run: "freq20000000-modef0070000-event2-consumer1"
//? const: frequency = 536870912
//? const: mode = 4026990592
//? const: event = 2
//? const: consumer = 1
//? const: threshold = 0

                // Compare POLL/WAIT at identical instruction positions against measured transition delays.
                // Each run probes twelve offsets. A set bit in errors identifies a failing offset.
                HUBSET  aug(0x01000098)
                WAITX   aug(300000)
                HUBSET  aug(0x0100009b)
probe:
                SETQ    aug(frequency)
.if event == 1
                XINIT   aug(mode | 1),      0
                NOP
.else
                XINIT   aug(mode | 0xffff), 0
                XCONT   aug(mode | 0xffff), 0
.endif
                WAITX   delay
                GETCT   stamp
.if consumer == 0
.if event == 0
                POLLXMT                                         :wc
.elif   event == 1
                POLLXFI                                         :wc
.else
                POLLXRO                                         :wc
.endif
.else
.if event == 0
                WAITXMT
.elif   event == 1
                WAITXFI
.else
                WAITXRO
.endif
.endif
                GETCT   elapsed
                WRC     seen
                SUB     elapsed,            stamp
                XSTOP

                // Polling is true from threshold onward; waits cost four baseline clocks plus any gap.
.if consumer == 0
                CMP     delay,              aug(threshold)      :wc
                WRNC    expected
                CMP     seen,               expected            :wz
.else
                MOV     expected,           delay
                FLE     expected,           aug(threshold)
                NEG     expected,           expected
                ADD     expected,           aug(4 + threshold)
                CMP     elapsed,            expected            :wz
.endif
    if(!Z)      BITH    errors,             delay
                ADD     delay,              1
                CMP     delay,              12                  :wz
    if(!Z)      JMP     probe
                HUBSET  0xf0
                WAITX   aug(50000)
                JMP     nrel(_end)
var delay:      LONG    0
var stamp:      LONG    0
var elapsed:    LONG    0
var seen:       LONG    0
var expected:   LONG    0
var errors:     LONG    0

