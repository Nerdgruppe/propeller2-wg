//? run: "freq20000000-modef0070000-event2-consumer1"
//? macro: xinit_operand set 0xffff)
//? macro: event set XCONT aug(mode | 0xffff), 0
//? macro: consumer set WAITXRO
//? macro: consumer_2 set MOV expected, delay
//? macro: consumer_3 set FLE expected, aug(threshold)
//? macro: consumer_4 set NEG expected, expected
//? macro: add set ADD expected, aug(4 + threshold)
//? macro: cmp set CMP elapsed, expected :wz
//? const: frequency = 536870912
//? const: mode = 4026990592
//? const: threshold = 0

                // Compare POLL/WAIT at identical instruction positions against measured transition delays.
                // Each run probes twelve offsets. A set bit in errors identifies a failing offset.
                HUBSET  aug(0x01000098)
                WAITX   aug(300000)
                HUBSET  aug(0x0100009b)
probe:
                SETQ    aug(frequency)
                XINIT   aug(mode | {{ xinit_operand }}, 0
                {{ event }}
                WAITX   delay
                GETCT   stamp
                {{ consumer }}
                GETCT   elapsed
                WRC     seen
                SUB     elapsed,            stamp
                XSTOP

                // Polling is true from threshold onward; waits cost four baseline clocks plus any gap.
                {{ consumer_2 }}
                {{ consumer_3 }}
                {{ consumer_4 }}
                {{ add }}
                {{ cmp }}
    if(!Z)      BITH    errors,             delay
                ADD     delay,              1
                CMP     delay,              12                  :wz
    if(!Z)      JMP     probe
                HUBSET  0xf0
                WAITX   aug(50000)
                JMP     nrel(_end)
var delay:      LONG    0
var stamp:      LONG    0
var elapsed:    LONG    0
var seen:       LONG    0
var expected:   LONG    0
var errors:     LONG    0

