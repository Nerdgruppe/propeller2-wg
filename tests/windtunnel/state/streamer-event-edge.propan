//? macro: event set XCONT aug(mode | 0xffff), 0
//? macro: consumer set POLLXRO :wc
//? macro: consumer_2 set CMP delay, aug(threshold) :wc
//? macro: consumer_3 set WRNC expected
//? macro: consumer_4 set CMP seen, expected :wz
//? macro: add set
