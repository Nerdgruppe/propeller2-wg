//? macro: pop set POP stack_out
//? macro: pop_2 set POP next_stack
//? macro: selected_kind set ADD count, 1
//? macro: selected_kind_2 set return RDFAST 0, new_stream
//? cog: 7
//? const: in_lut = 1
//? const: kind = 5
//? post: cog[*].reg[count] == 1
//? post: cog[*].reg[elapsed] == 35
//? post: cog[*].reg[bad] == 0
//? post: cog[*].reg[depth] == 0
//? post: cog[*].reg[stack_out] == 511
//? post: cog[*].reg[next_stack] == 12
//? post: cog[*].reg[last_pa] == 1
//? post: cog[*].reg[last_pb] == 16389
//?
//? run: "cog0-lut1-kind1"
//? macro: setq set SETQ2 31
//? macro: rdlong set RDLONG register(0x180), aug(hubaddr(handler))
//? macro: pop set POP stack_out
//? macro: pop_2 set POP next_stack
//? macro: selected_kind set ADD count, 1
//? macro: selected_kind_2 set RET
//? cog: 0
//? const: in_lut = 1
//? const: kind = 1
//? post: cog[*].reg[count] == 3
//? post: cog[*].reg[elapsed] == 40
//? post: cog[*].reg[bad] == 0
//? post: cog[*].reg[depth] == 0
//? post: cog[*].reg[stack_out] == 511
//? post: cog[*].reg[next_stack] == 12
//? post: cog[*].reg[last_pa] == 1
//? post: cog[*].reg[last_pb] == 16388

                // Load LUT handlers above the 256-entry bytecode table when requested.
                {{ setq }}
                {{ rdlong }}
                WRLUT   entry,              0
                WRLUT   nrel(finish),       1
                RDFAST  0,                  aug(hubaddr(bytecodes))
                PUSH    nrel(finish)
                PUSH    0x1ff
                GETCT   start
    return      SETQ    0
finish:
                GETCT   elapsed
                MOV     last_pa,    PA
                MOV     last_pb,    PB
                {{ pop }}
                {{ pop_2 }}
                SUB     elapsed,    start
                JMP     nrel(_end)
var count:      LONG    0
var elapsed:    LONG    0
var start:      LONG    0
var bad:        LONG    0
var depth:      LONG    0
var stack_out:  LONG    0
var next_stack: LONG    0
var last_pa:    LONG    0
var last_pb:    LONG    0
var marker:     LONG    0
var new_stream: LONG    hubaddr(terminator)
var discarded:  LONG    0
.if kind == 2
var entry:      LONG    pcaddr(handler) | (0x1a << 10)
.elif kind == 3
var entry:      LONG    pcaddr(handler) | (0x80 << 10)
.else
var entry:      LONG    pcaddr(handler)
.endif
.if in_lut
.lutexec    0x3800, 0x380
.endif
handler:
                // Exercise retained sentinel returns, trailing skip cancellation, calls, and explicit POP escape.
                {{ selected_kind }}
                {{ selected_kind_2 }}
                {{ mov }}
                ADD     bad,    2
                ADD     bad,    4
sub:
                GETBRK  depth                   :wc
                AND     depth,  aug(0xfe000000)
                RET
.hubexec    0x4000
bytecodes:      BYTE    0,  0,  0,  1
terminator:     BYTE    1,  0,  0,  0

