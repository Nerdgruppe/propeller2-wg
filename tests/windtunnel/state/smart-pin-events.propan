// Use nominal 20 MHz RCFAST and retain the ROM-calibrated UART divider.

                // Observe smart completion through the ordinary pin-event and interrupt machinery.
                WRPIN   aug(P_TT_01 | (mode << 1)), 4
                WRPIN   aug(0x60000000),            6
                WXPIN   aug((2 << 16) | 5),         4
                // Normalize any loader/configuration notification before arming the first sensor.
                SETSE1  0
                WAITX   64
                POLLSE1
                SETSE1  (0x40 | 4)
                GETCT   started
                DIRH    4
                WAITX   phase
                WYPIN   3,                          4
                WAITSE1
                GETCT   elapsed
                SUB     elapsed,                    started
                TESTP   4                                               :wc
                WRC     ready
                RDPIN   result,                     4                   :wc
                WRC     flag
                WAITX   8
                TESTP   4                                               :wc
                WRC     acknowledged
                // A second finite request must generate a fresh completion event without rearming the selector.
                WYPIN   3,                          4
                WAITSE1
                TESTP   4                                               :wc
                WRC     second_ready
                RDPIN   second_result,              4
                WAITX   8
                TESTP   6                                               :wc
                WRC     second_pad
                // Deliver one more completion as INT1 and retain the ISR's observable side effect.
                SETSE1  (0x40 | 4)
                STALLI
                NIXINT1
                MOV     IJMP1,                      aug(cogaddr(isr))
                SETINT1 4
                ALLOWI
                WYPIN   3,                          4
                WAITX   100
                DIRL    4
                JMP     finished
isr:
                SETINT1 0
                ADD     irq_count,  1
                RETI1
finished:

                // Restore RCFAST before the shared reporter uses the ROM-calibrated UART.
                HUBSET  0xF0
                WAITX   64
                JMP     nrel(_end)

var elapsed:    LONG    0
var ready:      LONG    0
var result:     LONG    0
var flag:       LONG    0
var acknowledged:
                LONG    0
var second_ready:
                LONG    0
var second_result:
                LONG    0
var second_pad: LONG    0
var irq_count:  LONG    0

var started:    LONG    0

