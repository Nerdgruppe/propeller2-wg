                // Two GPIO inputs with DIR low share one global setting but retain their own histories.
                DRVL    8
                HUBSET  aug(0x40000000 | (index << 7) | (length << 5) | 2)
                WRPIN   aug(0x60000000 | ((4 + index) << 21)),  10
                WRPIN   aug(0x50000000 | ((4 + index) << 21)),  11
                WAITX   128
                DRVH    8
                WAITX   128
                TESTP   10                                                  :wc
                RCL     highs,                                  1
                TESTP   11                                                  :wc
                RCL     highs,                                  1
                DRVL    8
                WAITX   128
                TESTP   10                                                  :wc
                RCL     lows,                                   1
                TESTP   11                                                  :wc
                RCL     lows,                                   1
                JMP     nrel(_end)
var highs:      LONG    0
var lows:       LONG    0

