                DIRH    8
                OUTL    8
                HUBSET  aug(0x40000000)
                WRPIN   aug(0x40000000 | (logic << 21)),    8
                WAITX   64
                OUTH    8
                {{ nop }}
                {{ nop_2 }}
                {{ nop_3 }}
                {{ nop_4 }}
                {{ nop_5 }}
                {{ nop_6 }}
                {{ nop_7 }}
                TESTP   8                                       :wc
                WRC     result
                JMP     nrel(_end)
var result:     LONG    0
