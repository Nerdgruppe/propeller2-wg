//? WINDTUNNEL CHECK LIST
//? post: cog[*].reg[failures] == 0
//? macro: pin_family_pin_operation required
//? macro: mov_operand required
//? macro: and default AND sample, aug(0xf00)
//? macro: cmp required
//? macro: add default if(!Z) ADD failures, 1
//? macro: cmp_2 required
//? macro: add_2 default if(!Z) ADD failures, 1
//?
//? run: "DIRL, initial 0x55555555"
//? macro: pin_family_pin_operation set DIRL
//? macro: mov_operand set DIRA
//? macro: cmp set CMP sample, aug(0) :wz
//? macro: cmp_2 set
//? macro: add_2 override
//? const: initial_bits = 1431655765
