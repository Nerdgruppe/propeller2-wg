//? run: "DRVNC, initial 0xaaaaaaaa"
//? macro: pin_family_pin_operation set DRVNC
//? macro: mov_operand set OUTA
//? macro: cmp set CMP sample, aug(0) :wz
//? macro: cmp_2 set CMP DIRA, aug(initial_bits | 0xf00) :wz
//? const: initial_bits = 2863311530
//?
//? run: "DRVZ, initial 0xaaaaaaaa"
//? macro: pin_family_pin_operation set DRVZ
//? macro: mov_operand set OUTA
//? macro: cmp set CMP sample, aug(0) :wz
//? macro: cmp_2 set CMP DIRA, aug(initial_bits | 0xf00) :wz
//? const: initial_bits = 2863311530
//?
//? run: "DRVNZ, initial 0xaaaaaaaa"
//? macro: pin_family_pin_operation set DRVNZ
//? macro: mov_operand set OUTA
//? macro: cmp set CMP sample, aug(3840) :wz
//? macro: cmp_2 set CMP DIRA, aug(initial_bits | 0xf00) :wz
//? const: initial_bits = 2863311530
//?
//? run: "DRVRND, initial 0xaaaaaaaa"
//? macro: pin_family_pin_operation set DRVRND
//? macro: mov_operand set OUTA
//? macro: and override
//? macro: cmp set
//? macro: add override
//? macro: cmp_2 set CMP DIRA, aug(initial_bits | 0xf00) :wz
//? const: initial_bits = 2863311530
//?
//? run: "DRVNOT, initial 0xaaaaaaaa"
//? macro: pin_family_pin_operation set DRVNOT
//? macro: mov_operand set OUTA
//? macro: cmp set CMP sample, aug((~initial_bits) & 0xf00) :wz
//? macro: cmp_2 set CMP DIRA, aug(initial_bits | 0xf00) :wz
//? const: initial_bits = 2863311530

                // Field mutation, unchanged surrounding bits, ORIGINAL base-bit flags, SETQ and wrapping.
                MOV     DIRA,       aug(initial_bits)
                MOV     OUTA,       aug(initial_bits)
                MODCZ   _SET,       _CLR                            :wcz
                {{ pin_family_pin_operation }}  aug(8 | (3 << 6)) :wcz
                WRC     op_c
                WRZ     op_z
                MOV     sample, {{ mov_operand }}
                MOV     outside,    sample
                ANDN    outside,    aug(0xf00)
                CMP     outside,    aug(initial_bits & ~0xf00)      :wz
    if(!Z)      ADD     failures,   1
                MOV     actual,     ((initial_bits >> 8) & 1)
                CMP     actual,     op_c                            :wz
    if(!Z)      ADD     failures,   1
                CMP     op_c,       op_z                            :wz
    if(!Z)      ADD     failures,   1
                {{ and }}
                {{ cmp }}
                {{ add }}
                {{ cmp_2 }}
                {{ add_2 }}
                MOV     DIRA,       0
                SETQ    1
                DIRH    aug(8 | (3 << 6))
                CMP     DIRA,       aug(0x300)                      :wz
    if(!Z)      ADD     failures,   1
                MOV     DIRA,       0
                DIRH    aug(31 | (1 << 6))
                CMP     DIRA,       aug(0x80000001)                 :wz
    if(!Z)      ADD     failures,   1
                SETQ    31
                DIRH    8
                CMP     DIRA,       aug(0xffffffff)                 :wz
    if(!Z)      ADD     failures,   1
                JMP     nrel(_end)
var failures:   LONG    0
var sample:     LONG    0
var outside:    LONG    0
var actual:     LONG    0
var op_c:       LONG    0
var op_z:       LONG    0

