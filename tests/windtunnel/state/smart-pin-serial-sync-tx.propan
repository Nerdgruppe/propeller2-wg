// Use nominal 20 MHz RCFAST and retain the ROM-calibrated UART divider.

                // P5 clocks the P4 USART transmitter; P6 observes its physical output.
                DRVL    5
                WRPIN   aug(0x01000000 | P_TT_01 | P_SYNC_TX),  4
                WRPIN   aug(0x60000000),                        6
                WXPIN   mode,                                   4
                WYPIN   aug(0x89abcdef),                        4
                WAITX   32
                DIRH    4
                WAITX   32
                TESTP   6                                                           :wc
                WRC     initial_output
                RQPIN   initial_result,                         4
                WYPIN   aug(0x12345678),                        4
                WAITX   16
                TESTP   6                                                           :wc
                WRC     updated_output

                // Clock one bit, observe the settled output, and acknowledge any buffer transfer.
                DRVH    5
                WAITX   8
                TESTP   6                                                           :wc
                RCL     waveform,                               1
                TESTP   4                                                           :wc
                RCL     completions,                            1
                RDPIN   result0,                                4
                DRVL    5
                WAITX   8

.if write
                WYPIN   aug(0x76543210),                        4
.endif

                // Clock one bit, observe the settled output, and acknowledge any buffer transfer.
                DRVH    5
                WAITX   8
                TESTP   6                                                           :wc
                RCL     waveform,                               1
                TESTP   4                                                           :wc
                RCL     completions,                            1
                RDPIN   result1,                                4
                DRVL    5
                WAITX   8

                // Clock one bit, observe the settled output, and acknowledge any buffer transfer.
                DRVH    5
                WAITX   8
                TESTP   6                                                           :wc
                RCL     waveform,                               1
                TESTP   4                                                           :wc
                RCL     completions,                            1
                RDPIN   result2,                                4
                DRVL    5
                WAITX   8

                // Clock one bit, observe the settled output, and acknowledge any buffer transfer.
                DRVH    5
                WAITX   8
                TESTP   6                                                           :wc
                RCL     waveform,                               1
                TESTP   4                                                           :wc
                RCL     completions,                            1
                RDPIN   result3,                                4
                DRVL    5
                WAITX   8

                // Clock one bit, observe the settled output, and acknowledge any buffer transfer.
                DRVH    5
                WAITX   8
                TESTP   6                                                           :wc
                RCL     waveform,                               1
                TESTP   4                                                           :wc
                RCL     completions,                            1
                RDPIN   result4,                                4
                DRVL    5
                WAITX   8

                // Clock one bit, observe the settled output, and acknowledge any buffer transfer.
                DRVH    5
                WAITX   8
                TESTP   6                                                           :wc
                RCL     waveform,                               1
                TESTP   4                                                           :wc
                RCL     completions,                            1
                RDPIN   result5,                                4
                DRVL    5
                WAITX   8

                // Clock one bit, observe the settled output, and acknowledge any buffer transfer.
                DRVH    5
                WAITX   8
                TESTP   6                                                           :wc
                RCL     waveform,                               1
                TESTP   4                                                           :wc
                RCL     completions,                            1
                RDPIN   result6,                                4
                DRVL    5
                WAITX   8

                // Clock one bit, observe the settled output, and acknowledge any buffer transfer.
                DRVH    5
                WAITX   8
                TESTP   6                                                           :wc
                RCL     waveform,                               1
                TESTP   4                                                           :wc
                RCL     completions,                            1
                RDPIN   result7,                                4
                DRVL    5
                WAITX   8

                // Clock one bit, observe the settled output, and acknowledge any buffer transfer.
                DRVH    5
                WAITX   8
                TESTP   6                                                           :wc
                RCL     waveform,                               1
                TESTP   4                                                           :wc
                RCL     completions,                            1
                RDPIN   result8,                                4
                DRVL    5
                WAITX   8

                // Clock one bit, observe the settled output, and acknowledge any buffer transfer.
                DRVH    5
                WAITX   8
                TESTP   6                                                           :wc
                RCL     waveform,                               1
                TESTP   4                                                           :wc
                RCL     completions,                            1
                RDPIN   result9,                                4
                DRVL    5
                WAITX   8

                // Clock one bit, observe the settled output, and acknowledge any buffer transfer.
                DRVH    5
                WAITX   8
                TESTP   6                                                           :wc
                RCL     waveform,                               1
                TESTP   4                                                           :wc
                RCL     completions,                            1
                RDPIN   result10,                               4
                DRVL    5
                WAITX   8

                // Clock one bit, observe the settled output, and acknowledge any buffer transfer.
                DRVH    5
                WAITX   8
                TESTP   6                                                           :wc
                RCL     waveform,                               1
                TESTP   4                                                           :wc
                RCL     completions,                            1
                RDPIN   result11,                               4
                DRVL    5
                WAITX   8

                // Clock one bit, observe the settled output, and acknowledge any buffer transfer.
                DRVH    5
                WAITX   8
                TESTP   6                                                           :wc
                RCL     waveform,                               1
                TESTP   4                                                           :wc
                RCL     completions,                            1
                RDPIN   result12,                               4
                DRVL    5
                WAITX   8

                // Clock one bit, observe the settled output, and acknowledge any buffer transfer.
                DRVH    5
                WAITX   8
                TESTP   6                                                           :wc
                RCL     waveform,                               1
                TESTP   4                                                           :wc
                RCL     completions,                            1
                RDPIN   result13,                               4
                DRVL    5
                WAITX   8

                // Clock one bit, observe the settled output, and acknowledge any buffer transfer.
                DRVH    5
                WAITX   8
                TESTP   6                                                           :wc
                RCL     waveform,                               1
                TESTP   4                                                           :wc
                RCL     completions,                            1
                RDPIN   result14,                               4
                DRVL    5
                WAITX   8

                // Clock one bit, observe the settled output, and acknowledge any buffer transfer.
                DRVH    5
                WAITX   8
                TESTP   6                                                           :wc
                RCL     waveform,                               1
                TESTP   4                                                           :wc
                RCL     completions,                            1
                RDPIN   result15,                               4
                DRVL    5
                WAITX   8

                DIRL    4
                DIRL    5
                WAITX   8
                RQPIN   reset_result,                           4
                TESTP   6                                                           :wc
                WRC     reset_output

                // TT-enabled smart outputs still drive in reset; restore GPIO before reporting.
                DIRL    aug(0 | (7 << 6))
                WRPIN   0,                                      aug(0 | (7 << 6))

                // Restore RCFAST before the shared reporter uses the ROM-calibrated UART.
                HUBSET  0xF0
                WAITX   64
                JMP     nrel(_end)

var initial_output:
                LONG    0
var initial_result:
                LONG    0
var updated_output:
                LONG    0
var waveform:   LONG    0
var completions:
                LONG    0
var reset_result:
                LONG    0
var reset_output:
                LONG    0
var result0:    LONG    0
var result1:    LONG    0
var result2:    LONG    0
var result3:    LONG    0
var result4:    LONG    0
var result5:    LONG    0
var result6:    LONG    0
var result7:    LONG    0
var result8:    LONG    0
var result9:    LONG    0
var result10:   LONG    0
var result11:   LONG    0
var result12:   LONG    0
var result13:   LONG    0
var result14:   LONG    0
var result15:   LONG    0

