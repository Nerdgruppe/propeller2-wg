                // Observe alternate instruction phases to reconstruct every digital output clock.
                MOV     DIRA,                               255
                SETCMOD aug(video)
                SETXFRQ aug(0x0ccccccd)
                XINIT   aug((mode << 16) | X_PINS_ON | 32), aug(data)
                WAITX   phase
                MOV     s0,                                 INA
                MOV     s1,                                 INA
                MOV     s2,                                 INA
                MOV     s3,                                 INA
                MOV     s4,                                 INA
                MOV     s5,                                 INA
