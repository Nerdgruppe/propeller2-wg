//? post: cog[0].reg[r5] == 8014

                // A ramp LUT makes phase reset, continuation, table offsets and live frequency changes visible.
                HUBSET  aug(0x01000098)
                WAITX   aug(300000)
                HUBSET  aug(0x0100009b)
                DRVH    0
                MOV     index,  0
                MOV     value,  0
fill_table:
                WRLUT   value,                      index
                ADD     value,                      aug(0x01010000)
                ADD     index,                      1
                CMP     index,                      aug(512)                                                :wz
    if(!Z)      JMP     fill_table
                SETQ    aug(0x12345678)
                XINIT   aug(0xf0070000 | first),    aug(0x1000 | (size << 9) | 511)
                WAITX   3
                SETXFRQ aug(0x23456789)
                MOV     register(cogaddr(command)), aug(opcode | (cogaddr(control) << 9) | cogaddr(config))
                MOV     control,                    aug(0xf0870003)
                MOV     config,                     aug(0x1000 | (size << 9) | 85)
                SETQ    aug(0x08000000)
// Encode either register-operand XZERO or XCONT without adding a conditional instruction slot.
command:
                XZERO   control,            config
                SETQ    aug(0x0ccccccd)
                XCONT   aug(0xf0070004),    aug(0x1000 | (size << 9) | 3)
                GETXACC r0
                MOV     r1,                 0
                // A third queued command stalls until space exists; captured frequency and operands must survive.
                XCONT   0,                  0
                GETXACC r2
                MOV     r3,                 0
                WAITXFI
                GETXACC r4
                MOV     r5,                 0
                HUBSET  0xf0
                WAITX   aug(50000)
                DIRL    0
                JMP     nrel(_end)
var index:      LONG    0
var value:      LONG    0
var control:    LONG    0
var config:     LONG    0
var r0:         LONG    0
var r1:         LONG    0
var r2:         LONG    0
var r3:         LONG    0
var r4:         LONG    0
var r5:         LONG    0

