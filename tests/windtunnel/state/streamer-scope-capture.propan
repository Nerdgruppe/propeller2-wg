                // Capture deterministic repository bytes through the cog scope bus and mixed pin formats.
                WRPIN   P_REPOSITORY,                       aug(40 | (3 << 6))
                DIRH    aug(40 | (3 << 6))
                WXPIN   0x12,                               40
                WXPIN   0x34,                               41
                WXPIN   0x56,                               42
                WXPIN   0x78,                               43
                WAITX   16
                SETSCP  0x68
                MOV     OUTA,                               aug(0x87654321)
                MOV     DIRA,                               aug(0xffffffff)
                WRFAST  0,                                  aug(hubaddr(buffer))
                SETXFRQ aug(0x10000000)
                XINIT   aug((mode << 16) | X_WRITE_ON | 4), sel
                WAITXFI
                WAITX   100
                GETSCP  value
                DIRL    aug(40 | (3 << 6))
                WRPIN   0,                                  aug(40 | (3 << 6))
                MOV     DIRA,                               0
                JMP     nrel(_end)
var value:      LONG    0
.data
.align  4
var buffer:     BYTE    [0xcc] * 32

