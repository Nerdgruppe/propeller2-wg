//? cog: 0
//? pre: cog[*].c = true
//? pre: cog[*].z = true
//? post: cog[*].reg[hits] == 10
//? post: cog[*].reg[saved] == 0xc0000404
//? post: cog[*].reg[return_state] == 0xc0000404
//? post: cog[*].reg[landed] == 1
//? post: cog[*].reg[hub_pc] == 0x40c
//? post: cog[*].c == true
//? post: cog[*].z == true
//?
//? run: "int3-cog7"
//? macro: mov_operand set IJMP3
//? macro: event_tracker set 3
//? macro: setint_2 set SETINT3 EVENT_CT1
//? macro: mov_2 set MOV return_state, IRET3
//? macro: event_tracker_2 set 3
//? macro: mov_3_operand set IRET3
//? cog: 7
//? pre: cog[*].c = true
//? pre: cog[*].z = true
//? post: cog[*].reg[hits] == 10
//? post: cog[*].reg[saved] == 0xc0000404
//? post: cog[*].reg[return_state] == 0xc0000404
//? post: cog[*].reg[landed] == 1
//? post: cog[*].reg[hub_pc] == 0x40c
//? post: cog[*].c == true
//? post: cog[*].z == true
//?
//? run: "int1-overflow-400-cog0"
//? macro: mov_operand set IJMP1
//? macro: event_tracker set 1
//? macro: setint_2 set SETINT1 EVENT_CT1
//? macro: mov_2 set MOV return_state, IRET1
//? macro: event_tracker_2 set 1
//? macro: mov_3_operand set IRET1
//? issues: pc_domain = 1
//? cog: 0
//? const: phase = 12
//? pre: cog[*].c = true
//? pre: cog[*].z = true
//? post: cog[*].reg[hits] == 0
//? post: cog[*].reg[saved] == 0xc0000400
//? post: cog[*].reg[return_state] == 0xc0000400
//? post: cog[*].reg[landed] == 2
//? post: cog[*].reg[hub_pc] == 0
//? post: cog[*].c == true
//? post: cog[*].z == true
//?
//? run: "int1-overflow-400-cog7"
//? macro: mov_operand set IJMP1
//? macro: event_tracker set 1
//? macro: setint_2 set SETINT1 EVENT_CT1
//? macro: mov_2 set MOV return_state, IRET1
//? macro: event_tracker_2 set 1
//? macro: mov_3_operand set IRET1
//? issues: pc_domain = 1
//? cog: 7
//? const: phase = 12
//? pre: cog[*].c = true
//? pre: cog[*].z = true
//? post: cog[*].reg[hits] == 0
//? post: cog[*].reg[saved] == 0xc0000400
//? post: cog[*].reg[return_state] == 0xc0000400
//? post: cog[*].reg[landed] == 2
//? post: cog[*].reg[hub_pc] == 0
//? post: cog[*].c == true
//? post: cog[*].z == true

                // Run a finite S-port chain beyond local PC $3FF. With no interrupt it finishes
                // locally; an unmodified RETIx to saved PC $404 instead runs hub RAM at $404.
                JMP     nrel(setup)
                NOP
                NOP
                NOP
                NOP
                NOP
                NOP
                NOP
setup:
    // Install seven cog instructions and the two final LUT instructions.
                SETQ    6
                RDLONG  register(0),    aug(hubaddr(cog_template))
                MOV     PTRA,           aug(hubaddr(tail_template))
                RDLONG  word,           PTRA++
                WRLUT   word,           aug(510)
                RDLONG  word,           PTRA++
                WRLUT   word,           aug(511)

                // CT1 phase 12 saves $400; phase 20 saves $404. Only its deadline varies.
                STALLI
                MOV     {{ mov_operand }}, vector
                SETINT{{ event_tracker }}   0
                GETCT   timer
                ADD     timer,          128
                ADDCT2  timer,          0
                ADD     timer,          phase
                ADDCT1  timer,          0
                {{ setint_2 }}
                NIXINT{{ event_tracker }}
                WAITCT2
                ALLOWI
                GETCT   start
                JMP     nrel(tail_template)
done:
    // Check the actual return register as well as the ISR's saved copy.
                {{ mov_2 }}
                JMP     nrel(_end)
isr:
    // Disable the event source, copy IRETx, and return without modifying it.
                SETINT{{ event_tracker_2 }} 0
                MOV     saved, {{ mov_3_operand }}
                RETI{{ event_tracker_2 }}
var vector:     LONG    pcaddr(isr)
var word:       LONG    0
var timer:      LONG    0
var start:      LONG    0
var hits:       LONG    0
var saved:      LONG    0
var return_state:
                LONG    0
var landed:     LONG    0
var hub_pc:     LONG    0

.cogexec    0x3000, 0
cog_template:
    // Each immediate S selects the next physical cog register after overflow.
                ADD     hits,   1
                ADD     hits,   2
                ADD     hits,   3
                ADD     hits,   4
                ADD     hits,   5
                ADD     hits,   6
                JMP     nrel(done)
.lutexec    0x3100, 0x3fe
tail_template:
    // Sequential execution crosses $3FF without changing the execution mode.
                NOP
                NOP
.hubexec    0x400
                // An interrupt return to $400 must fetch the HUB branch, not
                // cog register zero via the overflowing local S-port path.
                // This added instruction keeps the existing $404 path unchanged.
                JMP     nrel(hub_from_400)
                // These instructions are reachable only when RETIx selects hub execution.
                MOV     landed, 1
                LOC     PB,     hub_after
hub_after:
                MOV     hub_pc, PB
                JMP     nrel(done)
hub_from_400:
                MOV     landed, 2
                JMP     nrel(done)
