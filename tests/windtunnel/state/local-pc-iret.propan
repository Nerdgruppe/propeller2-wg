//? pre: cog[*].z = true
//? post: cog[*].reg[hits] == 10
//? post: cog[*].reg[saved] == 0xc0000404
//? post: cog[*].reg[return_state] == 0xc0000404
//? post: cog[*].reg[landed] == 1
//? post: cog[*].reg[hub_pc] == 0x40c
//? post: cog[*].c == true
//? post: cog[*].z == true
//?
//? run: "int2-cog7"
//? macro: mov_operand set IJMP2
//? macro: event_tracker set 2
//? macro: setint_2 set SETINT2 EVENT_CT1
//? macro: mov_2 set MOV return_state, IRET2
//? macro: event_tracker_2 set 2
