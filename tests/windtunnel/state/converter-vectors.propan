                // Configure from independently measured vectors; bypass clears carrier phase.
                SETCMOD 0
                SETCFRQ 0
                SETDACS aug(dacs)
                SETCY   aug(cy)
                SETCI   aug(ci)
                SETCQ   aug(cq)
                SETCMOD mode
                // Advance exactly two carrier clocks, then retain the selected phase.
                SETCFRQ aug(angle << 23)
                SETCFRQ 0
                WAITX   12
                JMP     nrel(_end)

