//? post: cog[*].reg[ready] == 0x00000001

// Use nominal 20 MHz RCFAST and retain the ROM-calibrated UART divider.

                // Configure all four unanimous histories with a one-clock sample interval.
                HUBSET  aug(0x40000000)
                HUBSET  aug(0x40000000 | (1 << 7) | (1 << 5))
                HUBSET  aug(0x40000000 | (2 << 7) | (2 << 5))
                HUBSET  aug(0x40000000 | (3 << 7) | (3 << 5))
                DRVL    3
                DRVL    5
                WRPIN   aug(0x71000000 | (invert << 31) | (logic << 21) | (mode << 1)), 4
                WXPIN   0,                                                              4
                WYPIN   0,                                                              4
                WAITX   32
                DIRH    4
                MOV     OUTA,                                                           0
                WAITX   32
                MOV     OUTA,                                                           8
                WAITX   32
                MOV     OUTA,                                                           40
                WAITX   32
                MOV     OUTA,                                                           32
                WAITX   32
                MOV     OUTA,                                                           0
                WAITX   32
                MOV     OUTA,                                                           32
                WAITX   32
                MOV     OUTA,                                                           40
                WAITX   32
                MOV     OUTA,                                                           8
                WAITX   32
                MOV     OUTA,                                                           0
                WAITX   32

                RQPIN   result,                                                         4   :wc
                WRC     flag
                TESTP   4                                                                   :wc
                WRC     ready
                DIRL    4
                DIRL    3
                DIRL    5

                // Restore RCFAST before the shared reporter uses the ROM-calibrated UART.
                HUBSET  0xF0
                WAITX   64
                JMP     nrel(_end)

var result:     LONG    0
var flag:       LONG    0
var ready:      LONG    0

