                // Keep the same program timing in sample/filter modes and capture 64 result snapshots.
                DIRL    40
                OUTL    40
                WRPIN   aug(0x40000030),                    40
                WXPIN   x,                                  40
                DIRH    40
                WAITX   100
                OUTH    40
                WAITX   width
                OUTL    40
                RQPIN   register(localaddr(results) + 0),   40
