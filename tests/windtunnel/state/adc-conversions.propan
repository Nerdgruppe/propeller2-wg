                // Isolate the documented digital accumulator modes without a WYPIN override.
                DIRL    40
                OUTL    40
                WRPIN   aug(0x40000030),    40
                WXPIN   x,                  40
.if level
                OUTH    40
.endif
                DIRH    40
                WAITX   aug(200000)
                RQPIN   value,              40  :wc
                MOV     flag,               0
                MUXC    flag,               1
                TESTP   40                      :wc
                MUXC    flag,               2
                DIRL    40
                WRPIN   0,                  40
                JMP     nrel(_end)
var value:      LONG    0
var flag:       LONG    0

