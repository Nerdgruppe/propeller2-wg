//? post: cog[0].reg[first] == 1
//? post: cog[0].reg[second] == 0
//? post: cog[0].reg[third] == 1

                // Finite rollovers distinguish coalescing from acknowledgement coincident with a new event.
                // At delay12, the first POLLXRO acknowledges the old flag as the second rollover is delivered.
                // The new flag survives for the second poll. At delay13 both rollovers have already coalesced.
                HUBSET  aug(0x01000098)
                WAITX   aug(300000)
                HUBSET  aug(0x0100009b)
                SETQ    aug(0x10000000)
                XINIT   aug(mode | count),  0
                NOP
                WAITX   delay
                POLLXRO                         :wc
                WRC     first
                POLLXRO                         :wc
                WRC     second
                POLLXRO                         :wc
                WRC     third
                XSTOP
                HUBSET  0xf0
                WAITX   aug(50000)
                JMP     nrel(_end)
var first:      LONG    0
var second:     LONG    0
var third:      LONG    0

