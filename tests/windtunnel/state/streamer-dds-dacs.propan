//? const: background = 1868451132
//? const: stop = 1
//? post: cog[0].dacs == u8 [60 77 94 111]

                // Hold phase zero while outputting four signed LUT bytes through the selected DAC route.
                SETDACS aug(background)
                WRLUT   aug(lut_word),  0
                SETQ    0
                XINIT   aug(control),   0
                WAITX   10
                // Optional explicit stop restores background after the registered DDS override drains.
                MOV     stopping,       stop
                CMP     stopping,       0       :wz
    if(!Z)      XSTOP
                WAITX   10
                JMP     nrel(_end)
var stopping:   LONG    0

