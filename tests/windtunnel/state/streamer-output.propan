                // Freeze the initial sample to inspect digital output without changing OUTA.
                MOV     OUTA,                                   0
                MOV     DIRA,                                   aug(0xffffffff)
                {{ wrlut }}
                {{ rdfast }}
                SETXFRQ 0
                XINIT   aug((mode << 16) | X_PINS_ON | 0xffff), {{ xinit_operand }}
                WAITX   20
                MOV     result,                                 INA
                MOV     original,                               OUTA
                // Restore ordinary GPIO before the fixture reporter takes over.
                XSTOP
                MOV     DIRA,                                   0
                JMP     nrel(_end)
var result:     LONG    0
var original:   LONG    0
.data
.align  4
var data:       LONG    0x87654321, 0

