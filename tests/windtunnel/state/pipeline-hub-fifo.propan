//? WINDTUNNEL CHECK LIST
//? post: cog[*].reg[throughput] == 130
//? post: cog[*].reg[prefetched] == 1
//? post: cog[*].reg[result] == 2
//? post: cog[*].reg[visits] == 2
//? run: "0"
//? cog: 0
//? const: probe_alignment = 0
//? run: "1"
//? cog: 0
//? const: probe_alignment = 1
//? run: "2"
//? cog: 0
//? const: probe_alignment = 2
//? run: "3"
//? cog: 0
//? const: probe_alignment = 3

    CALL hub_entry
cog_return:
    JMP nrel(_end)
var start: LONG 0
var throughput: LONG 0
var prefetched: LONG 0
var result: LONG 0
var visits: LONG 0
var replacement: LONG 0xf6040002 | (pcaddr(result) << 9)
.pack byte
.hubexec 0x5000 + probe_alignment
hub_entry:
    GETCT start
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    GETCT throughput
    SUB throughput, start
    MOV PTRA, aug(hubaddr(target))
    WRLONG replacement, PTRA
    NOP
    NOP
target:
    MOV result, 1
    ADD visits, 1
    CMP visits, 2 :wz
if(Z) JMP nrel(cog_return)
    MOV prefetched, result
    JMP target
