//? post: cog[*].reg[local] == 1
//? post: cog[*].reg[relative] == 1

                // Drive the paired pad low and invert feedback output, making the local pad high.
                // Reading low therefore proves that pad-mode input selection precedes A/B selection.
                DRVL    (pin ^ 1)
                WRPIN   aug((mode << 17) | (sync << 16) | (invert << 15) | (1 << 14)),  pin
                DIRH    pin
                WRPIN   aug(0x60000000),                                                (pin + 2)
                WAITX   64
                TESTP   pin                                                                         :wc
                WRC     local
                TESTP   (pin + 2)                                                                   :wc
                WRC     relative
                JMP     nrel(_end)
var local:      LONG    0
var relative:   LONG    0

