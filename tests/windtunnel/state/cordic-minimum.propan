                // Hardware measurements of the signed-minimum coordinate normalization/negation erratum.
                // The minimum value can disappear during normalization or survive with a wrapping negation.
                QVECTOR aug(2147483648),    aug(1)
                GETQX   out_x0
                GETQY   out_y0
                SETQ    aug(1)
                QROTATE aug(2147483648),    aug(0x23456789)
                GETQX   out_rx0
                GETQY   out_ry0
                QVECTOR aug(1),             aug(2147483648)
                GETQX   out_x1
                GETQY   out_y1
                SETQ    aug(2147483648)
                QROTATE aug(1),             aug(0x23456789)
                GETQX   out_rx1
                GETQY   out_ry1
                QVECTOR aug(2147483648),    aug(2147483647)
                GETQX   out_x2
                GETQY   out_y2
                SETQ    aug(2147483647)
                QROTATE aug(2147483648),    aug(0x23456789)
                GETQX   out_rx2
                GETQY   out_ry2
                QVECTOR aug(2147483647),    aug(2147483648)
                GETQX   out_x3
                GETQY   out_y3
                SETQ    aug(2147483648)
                QROTATE aug(2147483647),    aug(0x23456789)
                GETQX   out_rx3
                GETQY   out_ry3
                QVECTOR aug(2147483648),    aug(2147483649)
                GETQX   out_x4
                GETQY   out_y4
                SETQ    aug(2147483649)
                QROTATE aug(2147483648),    aug(0x23456789)
                GETQX   out_rx4
                GETQY   out_ry4
                QVECTOR aug(2147483649),    aug(2147483648)
                GETQX   out_x5
                GETQY   out_y5
                SETQ    aug(2147483648)
                QROTATE aug(2147483649),    aug(0x23456789)
                GETQX   out_rx5
                GETQY   out_ry5
                QVECTOR aug(0),             aug(2147483648)
                GETQX   out_x6
                GETQY   out_y6
                SETQ    aug(2147483648)
                QROTATE aug(0),             aug(0x23456789)
                GETQX   out_rx6
                GETQY   out_ry6
                QVECTOR aug(2147483648),    aug(0)
                GETQX   out_x7
                GETQY   out_y7
                SETQ    aug(0)
                QROTATE aug(2147483648),    aug(0x23456789)
                GETQX   out_rx7
                GETQY   out_ry7
                JMP     nrel(_end)
