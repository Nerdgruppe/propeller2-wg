                // Probe XMT wait qualification at the command activation edge for ordinary and DDS modes.
                HUBSET  aug(0x01000098)
                WAITX   aug(300000)
                HUBSET  aug(0x0100009b)
                SETQ    aug(0x10000000)
                XINIT   aug(mode | 0xffff), 0
                XCONT   aug(mode | 0xffff), 0
                WAITX   delay
                GETCT   elapsed
                WAITXMT
                GETCT   stamp
                SUB     elapsed,            stamp
                NEG     elapsed,            elapsed
                XSTOP
                HUBSET  0xf0
                WAITX   aug(50000)
                JMP     nrel(_end)
var elapsed:    LONG    0
var stamp:      LONG    0

