//? post: cog[*].reg[z7] == 0xa2b3c4d6

// Use nominal 20 MHz RCFAST and retain the ROM-calibrated UART divider.

                // Read both the running NCO bus and its final retained value across DIR reset.
                WRPIN   (6 << 1),           4
                WXPIN   x,                  4
                DIRH    4
                WYPIN   aug(0x87654321),    4
                WAITX   100
                WAITX   phase
                RQPIN   running,            4
                DIRL    4
                RQPIN   z0,                 4
                RQPIN   z1,                 4
                RQPIN   z2,                 4
                RQPIN   z3,                 4
                RQPIN   z4,                 4
                RQPIN   z5,                 4
                RQPIN   z6,                 4
                RQPIN   z7,                 4

                // Restore RCFAST before the shared reporter uses the ROM-calibrated UART.
                HUBSET  0xF0
                WAITX   64
                JMP     nrel(_end)

var running:    LONG    0
var z0:         LONG    0
var z1:         LONG    0
var z2:         LONG    0
var z3:         LONG    0
var z4:         LONG    0
var z5:         LONG    0
var z6:         LONG    0
var z7:         LONG    0

