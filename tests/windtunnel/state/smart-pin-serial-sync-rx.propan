//? post: cog[*].reg[result31] == 0x89abcdef

// Use nominal 20 MHz RCFAST and retain the ROM-calibrated UART divider.

                // P3 supplies A and P5 supplies B; P4's physical output stays disabled.
                DRVL    3
                DRVL    5
                WRPIN   aug(0x71000000 | P_SYNC_RX),    4
                WXPIN   old - 1,                        4
                WAITX   32
                DIRH    4
                WAITX   32
                MOV     data,                           aug(0x89abcdef)

// Supply bit 0 and capture readiness before acknowledging the received result.
                SHR     data,                           1                   :wc
                DRVC    3
                WAITX   8
                DRVH    5
                WAITX   8
                TESTP   4                                                   :wc
                RCL     completions,                    1
                RDPIN   result0,                        4
                DRVL    5
                WAITX   8

// Supply bit 1 and capture readiness before acknowledging the received result.
                SHR     data,                           1                   :wc
                DRVC    3
                WAITX   8
                DRVH    5
                WAITX   8
                TESTP   4                                                   :wc
                RCL     completions,                    1
                RDPIN   result1,                        4
                DRVL    5
                WAITX   8

// Supply bit 2 and capture readiness before acknowledging the received result.
                {{ wxpin }}
                SHR     data,                           1                   :wc
                DRVC    3
                WAITX   8
                DRVH    5
                WAITX   8
                TESTP   4                                                   :wc
                RCL     completions,                    1
                RDPIN   result2,                        4
                DRVL    5
                WAITX   8

// Supply bit 3 and capture readiness before acknowledging the received result.
                SHR     data,                           1                   :wc
                DRVC    3
                WAITX   8
                DRVH    5
                WAITX   8
                TESTP   4                                                   :wc
                RCL     completions,                    1
                RDPIN   result3,                        4
                DRVL    5
                WAITX   8

// Supply bit 4 and capture readiness before acknowledging the received result.
                {{ wxpin_2 }}
                SHR     data,                           1                   :wc
                DRVC    3
                WAITX   8
                DRVH    5
                WAITX   8
                TESTP   4                                                   :wc
                RCL     completions,                    1
                RDPIN   result4,                        4
                DRVL    5
                WAITX   8

// Supply bit 5 and capture readiness before acknowledging the received result.
                SHR     data,                           1                   :wc
                DRVC    3
                WAITX   8
                DRVH    5
                WAITX   8
                TESTP   4                                                   :wc
                RCL     completions,                    1
                RDPIN   result5,                        4
                DRVL    5
                WAITX   8

// Supply bit 6 and capture readiness before acknowledging the received result.
                SHR     data,                           1                   :wc
                DRVC    3
                WAITX   8
                DRVH    5
                WAITX   8
                TESTP   4                                                   :wc
                RCL     completions,                    1
                RDPIN   result6,                        4
                DRVL    5
                WAITX   8

// Supply bit 7 and capture readiness before acknowledging the received result.
                SHR     data,                           1                   :wc
                DRVC    3
                WAITX   8
                DRVH    5
                WAITX   8
                TESTP   4                                                   :wc
                RCL     completions,                    1
                RDPIN   result7,                        4
                DRVL    5
                WAITX   8

// Supply bit 8 and capture readiness before acknowledging the received result.
                SHR     data,                           1                   :wc
                DRVC    3
                WAITX   8
                DRVH    5
                WAITX   8
                TESTP   4                                                   :wc
                RCL     completions,                    1
                RDPIN   result8,                        4
                DRVL    5
                WAITX   8

// Supply bit 9 and capture readiness before acknowledging the received result.
                SHR     data,                           1                   :wc
                DRVC    3
                WAITX   8
                DRVH    5
                WAITX   8
                TESTP   4                                                   :wc
                RCL     completions,                    1
                RDPIN   result9,                        4
                DRVL    5
                WAITX   8

// Supply bit 10 and capture readiness before acknowledging the received result.
                SHR     data,                           1                   :wc
                DRVC    3
                WAITX   8
                DRVH    5
                WAITX   8
                TESTP   4                                                   :wc
                RCL     completions,                    1
                RDPIN   result10,                       4
                DRVL    5
                WAITX   8

// Supply bit 11 and capture readiness before acknowledging the received result.
                SHR     data,                           1                   :wc
                DRVC    3
                WAITX   8
                DRVH    5
                WAITX   8
                TESTP   4                                                   :wc
                RCL     completions,                    1
                RDPIN   result11,                       4
                DRVL    5
                WAITX   8

// Supply bit 12 and capture readiness before acknowledging the received result.
                SHR     data,                           1                   :wc
                DRVC    3
                WAITX   8
                DRVH    5
                WAITX   8
                TESTP   4                                                   :wc
                RCL     completions,                    1
                RDPIN   result12,                       4
                DRVL    5
                WAITX   8

// Supply bit 13 and capture readiness before acknowledging the received result.
                SHR     data,                           1                   :wc
                DRVC    3
                WAITX   8
                DRVH    5
                WAITX   8
                TESTP   4                                                   :wc
                RCL     completions,                    1
                RDPIN   result13,                       4
                DRVL    5
                WAITX   8

// Supply bit 14 and capture readiness before acknowledging the received result.
                SHR     data,                           1                   :wc
                DRVC    3
                WAITX   8
                DRVH    5
                WAITX   8
                TESTP   4                                                   :wc
                RCL     completions,                    1
                RDPIN   result14,                       4
                DRVL    5
                WAITX   8

// Supply bit 15 and capture readiness before acknowledging the received result.
