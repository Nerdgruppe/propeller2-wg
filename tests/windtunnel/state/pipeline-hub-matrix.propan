//? WINDTUNNEL CHECK LIST
//? post: cog[*].reg[failures] == 0
//? run: "0-1"
//? cog: 0
//? const: probe_cog = 0
//? const: probe_size = 1
//? run: "0-2"
//? cog: 0
//? const: probe_cog = 0
//? const: probe_size = 2
//? run: "0"
//? cog: 0
//? const: probe_cog = 0
//? const: probe_size = 4
//? run: "1-1"
//? cog: 1
//? const: probe_cog = 1
//? const: probe_size = 1
//? run: "1-2"
//? cog: 1
//? const: probe_cog = 1
//? const: probe_size = 2
//? run: "1"
//? cog: 1
//? const: probe_cog = 1
//? const: probe_size = 4
//? run: "2-1"
//? cog: 2
//? const: probe_cog = 2
//? const: probe_size = 1
//? run: "2-2"
