//? run: "waitx-cog7"
//? macro: selected_kind set WAITX 32
//? macro: selected_kind_2 set MOV result, 7
//? macro: cmp set CMP saved_return, (pcaddr(sequence_start) - 1) :wz
//? macro: cmp_2_operand set 42
//? macro: cmp_3_operand set 64
//? cog: 7
//?
//? run: "setq2-cog0"
//? macro: selected_kind set SETQ2 0
//? macro: selected_kind_2 set MOV result, 7
//? macro: cmp set CMP saved_return, pcaddr(sequence_start) :wz
//? macro: cmp_2_operand set 12
//? macro: cmp_3_operand set 32
//? cog: 0
//?
//? run: "setq2-cog7"
//? macro: selected_kind set SETQ2 0
//? macro: selected_kind_2 set MOV result, 7
//? macro: cmp set CMP saved_return, pcaddr(sequence_start) :wz
//? macro: cmp_2_operand set 12
//? macro: cmp_3_operand set 32
//? cog: 7
//?
//? run: "scas-cog0"
//? macro: selected_kind set SCAS value, 0
//? macro: selected_kind_2 set MOV result, 7
//? macro: cmp set CMP saved_return, pcaddr(sequence_start) :wz
//? macro: cmp_2_operand set 12
//? macro: cmp_3_operand set 32
//? cog: 0
//?
//? run: "scas-cog7"
//? macro: selected_kind set SCAS value, 0
//? macro: selected_kind_2 set MOV result, 7
//? macro: cmp set CMP saved_return, pcaddr(sequence_start) :wz
//? macro: cmp_2_operand set 12
//? macro: cmp_3_operand set 32
//? cog: 7

                // Prefix consumers must stay ahead of the synthetic CALLD. Canceled prefixes add no shield.
                MOV     IJMP1,  vector
                GETCT   start
                TRGINT1
                {{ selected_kind }}
                {{ selected_kind_2 }}
sequence_start:
                MOV     sequence,       1
                MOV     sequence,       2
                MOV     sequence,       3
                MOV     sequence,       4
                MOV     sequence,       5
                GETCT   elapsed
                SUB     elapsed,        start
                SUB     stamp,          start
                STALLI
                // Assert the hardware-measured entry boundary, with no interrupted instruction lost.
                CMP     observed,       0                               :wz
    if(!Z)      ADD     failures,       1
                {{ cmp }}
    if(!Z)      ADD     failures,       1
                CMP     stamp, {{ cmp_2_operand }} :wz
    if(!Z)      ADD     failures,       1
                CMP     elapsed, {{ cmp_3_operand }} :wz
    if(!Z)      ADD     failures,       1
                CMP     sequence,       5                               :wz
    if(!Z)      ADD     failures,       1
                SETQ    0
                MODCZ   _CLR,           _CLR                            :wcz
                JMP     nrel(_end)
isr:
                GETCT   stamp
                MOV     observed,       sequence
                MOV     saved_return,   IRET1
                RETI1
var vector:     LONG    pcaddr(isr)
var source:     LONG    7
var start:      LONG    0
var sequence:   LONG    0
var observed:   LONG    0
var elapsed:    LONG    0
var stamp:      LONG    0
var saved_return:
                LONG    0
var result:     LONG    0
var value:      LONG    0
var failures:   LONG    0

