                // Streamer output creates exact one-clock bits, observed through the existing physical GPIO path.
                DIRL    aug(40 | (1 << 6))
                OUTL    aug(40 | (1 << 6))
                WRPIN   0,                                                      41
                WRPIN   aug(0x10000034),                                        40
                WXPIN   f,                                                      40
                DIRH    aug(40 | (1 << 6))
                WAITX   160
                SETXFRQ aug(0x80000000)
                XINIT   aug(X_IMM_32X1_1DAC1 | X_PINS_ON | (41 << 17) | count), aug(pattern)
                WAITX   delay
                RQPIN   value,                                                  40
                WAITXFI
                DIRL    aug(40 | (1 << 6))
                WRPIN   0,                                                      aug(40 | (1 << 6))
                JMP     nrel(_end)
var value:      LONG    0

