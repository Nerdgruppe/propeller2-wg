                // Independent step-response samples reconstruct exact integer scope filter weights and transport.
                DIRL    40
                OUTL    40
                WRPIN   aug(0x40000034),    40
                WXPIN   f,                  40
                DIRH    40
                {{ outh }}
                WAITX   160
                {{ out }}   40
                WAITX   delay
                RQPIN   value,              40  :wc
                MOV     flag,               0
                MUXC    flag,               1
                DIRL    40
                WRPIN   0,                  40
                JMP     nrel(_end)
var value:      LONG    0
var flag:       LONG    0

