                // Use the OUT-bit selector to test logical input independently of pad electrical levels.
                WRPIN   aug(P_OUTBIT_A),    40
                OUTH    40
                DIRH    40
                WAITX   32
                MODCZ   _CLR,               _SET    :wcz
                {{ testp }}
                WRC     got_c
                WRZ     got_z
                JMP     nrel(_end)
var got_c:      LONG    0
var got_z:      LONG    0

