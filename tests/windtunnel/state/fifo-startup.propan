//? WINDTUNNEL CHECK LIST
//? timeout-ms: 5000
//? max-cycles: 2000000
//? post: cog[*].reg[failures] == 0
//? macro: nop required
//? macro: nop_2 required
//? macro: nop_3 required
//? macro: nop_4 required
//? macro: nop_5 default
//? macro: nop_6 default
//? macro: nop_7 default
//? macro: probe_kind required
//? macro: cmp default
//? macro: add default
//?
//? run: "cog0-kind0-gap0"
//? macro: nop set
//? macro: nop_2 set
//? macro: nop_3 set
//? macro: nop_4 set
//? macro: probe_kind set RFLONG loaded
//? macro: cmp override CMP expected_pointer, address :wz
