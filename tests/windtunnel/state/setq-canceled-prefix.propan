//? WINDTUNNEL CHECK LIST
//? post: cog[*].reg[copied0] == 11
//? post: cog[*].reg[copied1] == 2
//? post: cog[*].reg[copied2] == 3
//? post: cog[*].reg[copied3] == 4
//? post: cog[*].reg[lut_value] == 17
//? macro: setq required
//? macro: canceled_aug required
//?
//? run: "cog=0 lut=0 aug=0"
//? macro: setq set SETQ
//? macro: canceled_aug set if(C) MOV scratch, 0
//? cog: 0
//?
//? run: "cog=0 lut=0 aug=1"
//? macro: setq set SETQ
//? macro: canceled_aug set if(C) AUGS 0
//? cog: 0
//?
//? run: "cog=0 lut=1 aug=0"
//? macro: setq set SETQ2
//? macro: canceled_aug set if(C) MOV scratch, 0
//? cog: 0
//?
//? run: "cog=0 lut=1 aug=1"
//? macro: setq set SETQ2
//? macro: canceled_aug set if(C) AUGS 0
//? cog: 0
//?
//? run: "cog=2 lut=0 aug=0"
//? macro: setq set SETQ
//? macro: canceled_aug set if(C) MOV scratch, 0
//? cog: 2
//?
//? run: "cog=2 lut=0 aug=1"
//? macro: setq set SETQ
//? macro: canceled_aug set if(C) AUGS 0
//? cog: 2
//?
//? run: "cog=2 lut=1 aug=0"
//? macro: setq set SETQ2
//? macro: canceled_aug set if(C) MOV scratch, 0
//? cog: 2
//?
//? run: "cog=2 lut=1 aug=1"
//? macro: setq set SETQ2
//? macro: canceled_aug set if(C) AUGS 0
//? cog: 2

                // A canceled instruction consumes either block-transfer prefix.
                MODCZ   _CLR,           _CLR                    :wcz
                WRLUT   17,             100
                {{ setq }}  3
                {{ canceled_aug }}
                RDLONG  register(100),  aug(hubaddr(source))
                RDLUT   lut_value,      100
                SETQ    0
                JMP     nrel(_end)
var scratch:    LONG    0
var lut_value:  LONG    0
.org    100
var copied0:    LONG    1
var copied1:    LONG    2
var copied2:    LONG    3
var copied3:    LONG    4
.data
source:         LONG    11, 22, 33, 44

