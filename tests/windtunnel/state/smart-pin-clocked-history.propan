//? WINDTUNNEL CHECK LIST
//? timeout-ms: 1000
//? max-cycles: 500000
//? macro: drv required
//?
//? run: "pll0-initial0-phase0"
//? macro: drv set DRVL
//? const: phase = 0
//? post: cog[*].reg[enabled] == 0x00000000
//? post: cog[*].reg[bypassed] == 0x00000000
//?
//? run: "pll0-initial0-phase1"
//? macro: drv set DRVL
//? const: phase = 1
//? post: cog[*].reg[enabled] == 0x00000000
//? post: cog[*].reg[bypassed] == 0x00000000
//?
//? run: "pll0-initial1-phase0"
//? macro: drv set DRVH
//? const: phase = 0
//? post: cog[*].reg[enabled] == 0x0000ffff
//? post: cog[*].reg[bypassed] == 0x0000ffff
//?
//? run: "pll0-initial1-phase1"
//? macro: drv set DRVH
//? const: phase = 1
//? post: cog[*].reg[enabled] == 0x0000ffff
//? post: cog[*].reg[bypassed] == 0x0000ffff

// Use nominal 20 MHz RCFAST and retain the ROM-calibrated UART divider.

                // Establish a known sampled low before changing modes; configure physical pads only with DIR low.
                DIRL    40
                WRPIN   aug(1 << 16),       40
                WAITX   16
                DRVL    40
                WAITX   64
                DIRL    40
                WAITX   16
                WRPIN   0,                  40
                WAITX   16
                {{ drv }}   40
                WRPIN   aug(0x70000000),    41
                WAITX   64
                DIRL    40
                WAITX   16
                WRPIN   aug(1 << 16),       40
                WAITX   16
                DIRH    40
                WAITX   32
                WAITX   phase
                TESTP   41                      :wc
                RCL     enabled,            1
                TESTP   41                      :wc
                RCL     enabled,            1
                TESTP   41                      :wc
                RCL     enabled,            1
                TESTP   41                      :wc
                RCL     enabled,            1
                TESTP   41                      :wc
                RCL     enabled,            1
                TESTP   41                      :wc
                RCL     enabled,            1
                TESTP   41                      :wc
                RCL     enabled,            1
                TESTP   41                      :wc
                RCL     enabled,            1
                TESTP   41                      :wc
                RCL     enabled,            1
                TESTP   41                      :wc
                RCL     enabled,            1
                TESTP   41                      :wc
                RCL     enabled,            1
                TESTP   41                      :wc
                RCL     enabled,            1
                TESTP   41                      :wc
                RCL     enabled,            1
                TESTP   41                      :wc
                RCL     enabled,            1
                TESTP   41                      :wc
                RCL     enabled,            1
                TESTP   41                      :wc
                RCL     enabled,            1

                DIRL    40
                WAITX   16
                WRPIN   0,                  40
                WAITX   16
                DIRH    40
                WAITX   32
                TESTP   41                      :wc
                RCL     bypassed,           1
                TESTP   41                      :wc
                RCL     bypassed,           1
                TESTP   41                      :wc
                RCL     bypassed,           1
                TESTP   41                      :wc
                RCL     bypassed,           1
                TESTP   41                      :wc
                RCL     bypassed,           1
                TESTP   41                      :wc
                RCL     bypassed,           1
                TESTP   41                      :wc
                RCL     bypassed,           1
                TESTP   41                      :wc
                RCL     bypassed,           1
                TESTP   41                      :wc
                RCL     bypassed,           1
                TESTP   41                      :wc
                RCL     bypassed,           1
                TESTP   41                      :wc
                RCL     bypassed,           1
                TESTP   41                      :wc
                RCL     bypassed,           1
                TESTP   41                      :wc
                RCL     bypassed,           1
                TESTP   41                      :wc
                RCL     bypassed,           1
                TESTP   41                      :wc
                RCL     bypassed,           1
                TESTP   41                      :wc
                RCL     bypassed,           1
                DIRL    40

                // Restore RCFAST before the shared reporter uses the ROM-calibrated UART.
                HUBSET  0xF0
                WAITX   64
                JMP     nrel(_end)

var enabled:    LONG    0
var bypassed:   LONG    0

