//? WINDTUNNEL CHECK LIST
//? timeout-ms: 1000
//? max-cycles: 500000
//? run: "pll0-initial0-phase0"
//? const: pll = 0
//? const: initial = 0
//? const: phase = 0
//? post: cog[*].reg[enabled] == 0x00000000
//? post: cog[*].reg[bypassed] == 0x00000000
//? run: "pll0-initial0-phase1"
//? const: pll = 0
//? const: initial = 0
//? const: phase = 1
//? post: cog[*].reg[enabled] == 0x00000000
//? post: cog[*].reg[bypassed] == 0x00000000
//? run: "pll0-initial1-phase0"
//? const: pll = 0
//? const: initial = 1
//? const: phase = 0
//? post: cog[*].reg[enabled] == 0x0000ffff
//? post: cog[*].reg[bypassed] == 0x0000ffff
//? run: "pll0-initial1-phase1"
//? const: pll = 0
//? const: initial = 1
//? const: phase = 1
//? post: cog[*].reg[enabled] == 0x0000ffff
//? post: cog[*].reg[bypassed] == 0x0000ffff
//? run: "pll1-initial0-phase0"
//? const: pll = 1
//? const: initial = 0
//? const: phase = 0
//? post: cog[*].reg[enabled] == 0x00000000
//? post: cog[*].reg[bypassed] == 0x00000000
//? run: "pll1-initial0-phase1"
//? const: pll = 1
//? const: initial = 0
//? const: phase = 1
//? post: cog[*].reg[enabled] == 0x00000000
//? post: cog[*].reg[bypassed] == 0x00000000
//? run: "pll1-initial1-phase0"
//? const: pll = 1
//? const: initial = 1
//? const: phase = 0
//? post: cog[*].reg[enabled] == 0x0000ffff
//? post: cog[*].reg[bypassed] == 0x0000ffff
//? run: "pll1-initial1-phase1"
//? const: pll = 1
//? const: initial = 1
//? const: phase = 1
//? post: cog[*].reg[enabled] == 0x0000ffff
//? post: cog[*].reg[bypassed] == 0x0000ffff

// Select the test clock while retaining the ROM-calibrated UART divider for reporting.
.if pll
                HUBSET  aug(0x010009f8)
                WAITX   aug(200000)
                HUBSET  aug(0x010009fb)
                WAITX   64
.endif

                // Establish a known sampled low before changing modes; configure physical pads only with DIR low.
                DIRL    40
                WRPIN   aug(1 << 16),       40
                WAITX   16
                DRVL    40
                WAITX   64
                DIRL    40
                WAITX   16
                WRPIN   0,                  40
                WAITX   16
.if initial
                DRVH    40
.else
                DRVL    40
.endif
                WRPIN   aug(0x70000000),    41
                WAITX   64
                DIRL    40
                WAITX   16
                WRPIN   aug(1 << 16),       40
                WAITX   16
                DIRH    40
                WAITX   32
                WAITX   phase
                TESTP   41                      :wc
                RCL     enabled,            1
                TESTP   41                      :wc
                RCL     enabled,            1
                TESTP   41                      :wc
                RCL     enabled,            1
                TESTP   41                      :wc
                RCL     enabled,            1
                TESTP   41                      :wc
                RCL     enabled,            1
                TESTP   41                      :wc
                RCL     enabled,            1
                TESTP   41                      :wc
                RCL     enabled,            1
                TESTP   41                      :wc
                RCL     enabled,            1
                TESTP   41                      :wc
                RCL     enabled,            1
                TESTP   41                      :wc
                RCL     enabled,            1
                TESTP   41                      :wc
                RCL     enabled,            1
                TESTP   41                      :wc
                RCL     enabled,            1
                TESTP   41                      :wc
                RCL     enabled,            1
                TESTP   41                      :wc
                RCL     enabled,            1
                TESTP   41                      :wc
                RCL     enabled,            1
                TESTP   41                      :wc
                RCL     enabled,            1

                DIRL    40
                WAITX   16
                WRPIN   0,                  40
                WAITX   16
                DIRH    40
                WAITX   32
                TESTP   41                      :wc
                RCL     bypassed,           1
                TESTP   41                      :wc
                RCL     bypassed,           1
                TESTP   41                      :wc
                RCL     bypassed,           1
                TESTP   41                      :wc
                RCL     bypassed,           1
                TESTP   41                      :wc
                RCL     bypassed,           1
                TESTP   41                      :wc
                RCL     bypassed,           1
                TESTP   41                      :wc
                RCL     bypassed,           1
                TESTP   41                      :wc
                RCL     bypassed,           1
                TESTP   41                      :wc
                RCL     bypassed,           1
                TESTP   41                      :wc
                RCL     bypassed,           1
                TESTP   41                      :wc
                RCL     bypassed,           1
                TESTP   41                      :wc
                RCL     bypassed,           1
                TESTP   41                      :wc
                RCL     bypassed,           1
                TESTP   41                      :wc
                RCL     bypassed,           1
                TESTP   41                      :wc
                RCL     bypassed,           1
                TESTP   41                      :wc
                RCL     bypassed,           1
                DIRL    40

                // Restore RCFAST before the shared reporter uses the ROM-calibrated UART.
                HUBSET  0xF0
                WAITX   64
                JMP     nrel(_end)

var enabled:    LONG    0
var bypassed:   LONG    0

