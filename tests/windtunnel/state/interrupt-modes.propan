//? const: probe_cog = 7
//? const: caller_mode = 2
//? const: handler_mode = 2
//? const: alignment = 3

                // Compare entry and return against the hardware CALLD refill formula in every execution-mode pair.
                // Hub paths cover all byte alignments; the phase loop changes the bank arbitration edge.
                SETQ2   127
                RDLONG  register(0),    aug(hubaddr(lut_block))
                MOV     IJMP1,          vector
phase_loop:
                MOV     sequence,   0
                MOV     stamp,      0
                GETCT   target
                ADD     target,     128
                ANDN    target,     7
                ADD     target,     phase
                ADDCT1  target,     0
                WAITCT1
                JMP     caller
checked:
                // TRGINT executes at start+2; its injected CALLD executes at start+6.
                MOV     expected,       10
                {{ mov }}
                {{ sub }}
                {{ sub_2 }}
                {{ add }}
                {{ and }}
                {{ add_2 }}
                SUB     stamp,          start
                CMP     stamp,          expected                    :wz
    if(!Z)      ADD     failures,       1
                // RETIx uses the same target refill as an ordinary CALLD.
                MOV     expected,       6
                {{ mov_2 }}
                {{ sub_3 }}
                {{ sub_4 }}
                {{ add_3 }}
                {{ and_2 }}
                {{ add_4 }}
                SUB     returned,       retstart
                CMP     returned,       expected                    :wz
    if(!Z)      ADD     failures,       1
                CMP     observed,       1                           :wz
    if(!Z)      ADD     failures,       1
                CMP     saved_return,   aug(pcaddr(resume))         :wz
    if(!Z)      ADD     failures,       1
                CMP     sequence,       5                           :wz
    if(!Z)      ADD     failures,       1
                ADD     phase,          1
                CMP     phase,          8                           :wz
    if(!Z)      JMP     phase_loop
                STALLI
                SETQ    0
                MODCZ   _CLR,           _CLR                        :wcz
                JMP     nrel(_end)
var vector:     LONG    pcaddr(isr)
var start:      LONG    0
var stamp:      LONG    0
var retstart:   LONG    0
var returned:   LONG    0
var observed:   LONG    0
var saved_return:
                LONG    0
var sequence:   LONG    0
var expected:   LONG    0
var failures:   LONG    0
var phase:      LONG    0
var target:     LONG    0

// Reserve the entire shared LUT image, including speculative reads after both routines.
.lutexec    0x3000, 0x200
lut_block:
.if caller_mode == 0
.cogexec    0x440, 0x100
.elif caller_mode == 1
.lutexec    0x3000, 0x200
.else
.pack   byte
.hubexec    0x4000 + alignment
.endif
caller:
                GETCT   start
                TRGINT1
                MOV     sequence,   1
resume:
                GETCT   returned
                MOV     sequence,   2
                MOV     sequence,   3
                MOV     sequence,   4
                MOV     sequence,   5
                JMP     nrel(checked)
                NOP
.if handler_mode == 0
.cogexec    0x540, 0x140
.elif handler_mode == 1
.lutexec    0x3100, 0x240
.else
.pack   byte
.hubexec    0x5000 + alignment
.endif
isr:
                GETCT   stamp
                MOV     observed,       sequence
                MOV     saved_return,   IRET1
                GETCT   retstart
                RETI1
                NOP

