//? post: cog[*].reg[early_qmt] == 0
//? post: cog[*].reg[late_qmt] == 1

// Cog reset clears readiness/tracking, retains result words, and leaves hub computations running.
// Reloading cog RAM also allows the older result to arrive during startup.
.if mode == 2
                RDLONG  state,              aug(hubaddr(flag))
                CMP     state,              0                       :wz
    if(!Z)      JMP     restarted
                WRLONG  1,                  aug(hubaddr(flag))
.endif
                QMUL    6,                  7
.if mode == 1
                WAITX   100
.endif
.if mode == 2
                COGINIT probe_cog,          aug(hubaddr(_wt_start))
.else
                COGINIT (probe_cog | 0x20), restarted
.endif
restarted:
                GETQX   early_x
                POLLQMT             :wc
                WRC     early_qmt
                WAITX   100
                GETQX   late_x
                GETQY   late_y
                POLLQMT             :wc
                WRC     late_qmt
                JMP     nrel(_end)
var state:      LONG    0
var early_x:    LONG    0
var early_qmt:  LONG    0
var late_x:     LONG    0
var late_y:     LONG    0
var late_qmt:   LONG    0
.data
flag:           LONG    0

