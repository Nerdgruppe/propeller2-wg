//? post: cog[*].reg[late_qmt] == 1

// Cog reset clears readiness/tracking, retains result words, and leaves hub computations running.
// Reloading cog RAM also allows the older result to arrive during startup.
                {{ rdlong }}
                {{ cmp }}
                {{ jmp }}
                {{ wrlong }}
                QMUL    6,                  7
                {{ selected_mode }}
                {{ coginit }}
restarted:
                GETQX   early_x
                POLLQMT :wc
                WRC     early_qmt
                WAITX   100
                GETQX   late_x
                GETQY   late_y
                POLLQMT :wc
                WRC     late_qmt
                JMP     nrel(_end)
var state:      LONG    0
var early_x:    LONG    0
var early_qmt:  LONG    0
var late_x:     LONG    0
var late_y:     LONG    0
var late_qmt:   LONG    0
.data
flag:           LONG    0

