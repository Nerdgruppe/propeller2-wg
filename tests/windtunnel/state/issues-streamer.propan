//? const: cancelled = 1

    // A rejected command must retire and allow the following marker write.
.if cancelled
    if(C)       XINIT   aug(mode),  0
.else
.if start_kind == 0
                XINIT   aug(mode),  0
.elif   start_kind == 1
                XZERO   aug(mode),  0
.else
                XCONT   aug(mode),  0
.endif
.endif
                MOV     marker,     23
                JMP     nrel(_end)
                // Keep marker data outside the jump prefetch window.
                NOP
var marker:     LONG    0

