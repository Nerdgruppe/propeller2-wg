// Use nominal 20 MHz RCFAST and retain the ROM-calibrated UART divider.

                // Extend RX during the final data sample and the following completion interval.
                WRPIN   P_TT_01 | P_ASYNC_TX,           3
                WRPIN   aug(0x70000000 | P_ASYNC_RX),   4
                WXPIN   aug((64 << 16) | 31),           3
                WXPIN   aug((64 << 16) | 7),            4
                DIRH    3
                DIRH    4
                WAITX   32
                WYPIN   aug(0x89abcdef),                3
                WAITX   aug(delay)
                WXPIN   aug((64 << 16) | 15),           4
                WAITX   aug(640)
                RQPIN   result,                         4
                TESTP   4                                                   :wc
                WRC     ready
                DIRL    3
                DIRL    4

                // TT-enabled smart outputs still drive in reset; restore GPIO before reporting.
                DIRL    aug(0 | (7 << 6))
                WRPIN   0,                              aug(0 | (7 << 6))

                // Restore RCFAST before the shared reporter uses the ROM-calibrated UART.
                HUBSET  0xF0
                WAITX   64
                JMP     nrel(_end)

var result:     LONG    0
var ready:      LONG    0

