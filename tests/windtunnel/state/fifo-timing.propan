//? run: "cog7-kind0"
//? macro: probe_kind set RDFAST
//? macro: probe_kind_2 set ADD expected, 15
//? cog: 7
//? const: probe_cog = 7
//? const: probe_kind = 0
//?
//? run: "cog7-kind1"
//? macro: probe_kind set WRFAST
//? macro: probe_kind_2 set ADD expected, 15
//? cog: 7
//? const: probe_cog = 7
//? const: probe_kind = 1
//?
//? run: "cog7-kind2"
//? macro: probe_kind set RDFAST
//? macro: probe_kind_2 set ADD expected, 15
//? cog: 7
//? const: probe_cog = 7
//? const: probe_kind = 2
//?
//? run: "cog7-kind3"
//? macro: probe_kind set WRFAST
//? macro: probe_kind_2 set ADD expected, 15
//? cog: 7
//? const: probe_cog = 7
//? const: probe_kind = 3
//?
//? run: "cog7-kind4"
//? macro: wrfast override WRFAST 0, address
//? macro: wflong override WFLONG aug(0x12121212)
//? macro: probe_kind set WRFAST
//? macro: probe_kind_2 set CMP alignment, 0 :wz
//? macro: add override if(!Z) ADD expected, 1
//? macro: add_2 override ADD expected, 2
//? macro: fge override FGE expected, 5
//? cog: 7
//? const: probe_cog = 7
//? const: probe_kind = 4
//?
//? run: "cog7-kind5"
//? macro: wrfast override WRFAST 0, address
//? macro: wflong override WFLONG aug(0x12121212)
//? macro: probe_kind set RDFAST
//? macro: probe_kind_2 set ADD expected, 15
//? cog: 7
//? const: probe_cog = 7
//? const: probe_kind = 5

                // Sweep setup latency across banks, byte alignments and CT phase; WAITX isolates each case's background state.
                MOV     address,    aug(hubaddr(payload))
                MOV     bank,       0
bank_loop:
                MOV     alignment,  0
alignment_loop:
                MOV     phase,  0
phase_loop:
                GETCT   timer
                ADD     timer,      128
                ANDN    timer,      7
                ADD     timer,      phase
                ADDCT1  timer,      0
                WAITCT1
                {{ wrfast }}
                {{ wflong }}
                GETCT   start
                {{ probe_kind }}    config, address
                GETCT   finish
                SUB     finish,     start
                AND     start,      7
.if probe_kind == 0
                MOV     expected,   bank
                SUB     expected,   start
                SUB     expected,   probe_cog
                SUB     expected,   5
                AND     expected,   7
                ADD     expected,   12
.elif probe_kind == 1
                MOV     expected,   5
.elif probe_kind == 2 or probe_kind == 3
                MOV     expected,   4
.else
                MOV     expected,   bank
                SUB     expected,   start
                SUB     expected,   probe_cog
                AND     expected,   7
                {{ probe_kind_2 }}
                {{ add }}
                {{ add_2 }}
                {{ fge }}
.endif
                CMP     finish,     expected        :wz
    if(!Z)      ADD     failures,   1
                WAITX   100
                GETPTR  pointer
                MOV     expected,   address
                AND     expected,   aug(0xfffff)
                CMP     pointer,    expected        :wz
    if(!Z)      ADD     failures,   1
                ADD     phase,      1
                CMP     phase,      8               :wz
    if(!Z)      JMP     phase_loop
                ADD     address,    1
                ADD     alignment,  1
                CMP     alignment,  4               :wz
    if(!Z)      JMP     alignment_loop
                ADD     bank,       1
                CMP     bank,       8               :wz
    if(!Z)      JMP     bank_loop
                JMP     nrel(_end)
var address:    LONG    0
var bank:       LONG    0
var alignment:  LONG    0
var phase:      LONG    0
var timer:      LONG    0
var start:      LONG    0
var finish:     LONG    0
var expected:   LONG    0
var pointer:    LONG    0
var failures:   LONG    0
.if probe_kind == 2 or probe_kind == 3
var config:     LONG    0xffffc000
.else
var config:     LONG    0x7fffc000
.endif
.data
.align  32
payload:        LONG    [0x12121212] * 128

