// Use nominal 20 MHz RCFAST and retain the ROM-calibrated UART divider.

                // Exercise the minimum supported UART divider, fractional cutoff and maximum integer divider.
                WRPIN   P_TT_01 | P_ASYNC_TX,           4
                WRPIN   aug(0x70000000 | P_ASYNC_RX),   5
                WXPIN   aug(x | 7),                     4
                WXPIN   aug(x | 7),                     5
                DIRH    4
                DIRH    5
                WAITX   32
                WYPIN   aug(0x89abcdef),                4
                WAITX   aug(wait)
                RQPIN   result,                         5                   :wc
                WRC     carry
                TESTP   5                                                   :wc
                WRC     ready
                RQPIN   tx_result,                      4                   :wc
                WRC     busy
                DIRL    4
                DIRL    5

                // TT-enabled smart outputs still drive in reset; restore GPIO before reporting.
                DIRL    aug(0 | (7 << 6))
                WRPIN   0,                              aug(0 | (7 << 6))

                // Restore RCFAST before the shared reporter uses the ROM-calibrated UART.
                HUBSET  0xF0
                WAITX   64
                JMP     nrel(_end)

var result:     LONG    0
var carry:      LONG    0
var ready:      LONG    0
var tx_result:  LONG    0
var busy:       LONG    0

