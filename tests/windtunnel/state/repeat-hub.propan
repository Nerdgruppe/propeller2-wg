// Each phase changes the final instruction's clock relative to hub arbitration.
// Three timestamped iterations expose both hidden jumps independently.
phase_loop:
                MOV     index,  &stamp0
                JMP     target
checked:
                MOV     expected,   start
                ADD     expected,   8
                ADD     expected,   phase
                CMP     stamp0,     expected                    :wz
    if(!Z)      ADD     failures,   1
                MOV     expected,   ((hubaddr(body) >> 2) & 7)
                SUB     expected,   stamp0
                SUB     expected,   probe_cog
                SUB     expected,   7
                AND     expected,   7
                ADD     expected,   stamp0
                ADD     expected,   19
                ADD     expected,   phase
                CMP     stamp1,     expected                    :wz
    if(!Z)      ADD     failures,   1
                MOV     expected,   ((hubaddr(body) >> 2) & 7)
                SUB     expected,   stamp1
                SUB     expected,   probe_cog
                SUB     expected,   7
                AND     expected,   7
                ADD     expected,   stamp1
                ADD     expected,   19
                ADD     expected,   phase
                CMP     stamp2,     expected                    :wz
    if(!Z)      ADD     failures,   1
                MOV     expected,   stamp2
                ADD     expected,   4
                CMP     finish,     expected                    :wz
    if(!Z)      ADD     failures,   1
                ADD     phase,      1
                CMP     phase,      8                           :wz
    if(!Z)      JMP     phase_loop
                JMP     nrel(_end)
var target:     LONG    pcaddr(probe)
var index:      LONG    0
var start:      LONG    0
var finish:     LONG    0
var stamp0:     LONG    0
var stamp1:     LONG    0
var stamp2:     LONG    0
var expected:   LONG    0
var failures:   LONG    0
var phase:      LONG    0

.pack   byte
.hubexec    0x4000 + 4 * bank + alignment
probe:
                GETCT   start
                REP     4,  3
body:
                WAITX   phase
                ALTD    index,  0
                GETCT   stamp0
                ADD     index,  1
                GETCT   finish
                JMP     nrel(checked)
                NOP

