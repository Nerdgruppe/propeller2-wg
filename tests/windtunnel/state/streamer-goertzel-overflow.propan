//? post: cog[0].reg[y] == 0

                // The one-MHz region includes finite duration, signed extremes, and SINC2 wraparound.
                HUBSET  aug(0x01000098)
                WAITX   aug(300000)
                HUBSET  aug(0x0100009b)
                DRVH    aug(0 | (2 << 6))
                MOV     index,  0
fill_table:
                WRLUT   aug(0x7f800000),    index
                ADD     index,              1
                CMP     index,              aug(512)    :wz
    if(!Z)      JMP     fill_table
                SETQ    aug(frequency)
                XINIT   aug(control),       aug(0x7000)
                WAITXFI
                GETXACC x
                MOV     y,                  0
                HUBSET  0xf0
                WAITX   aug(50000)
                MOV     DIRA,               0
                JMP     nrel(_end)
var index:      LONG    0
var x:          LONG    0
var y:          LONG    0

