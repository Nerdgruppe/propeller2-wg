//? WINDTUNNEL CHECK LIST
//? issues: pc_domain = 2
//? post: cog[0].reg[wrapped] == 1
//? post: cog[0].reg[lut_wrap] == 0

// Check overflow from LUT address $3FF through its S-selected cog register 1.
// Different cog-zero and LUT-zero fallback branches reveal which memory supplies the wrapped instruction.

                WRLUT   lut_fallback,   0
                WRLUT   last_word,      aug(511)
                // MOV #1 at $3FF selects register 1; keep register 0 safe as well.
                MOV     register(0),    cog_fallback
                MOV     register(1),    cog_fallback
                JMP     nrel(lut_last)
done:
                JMP     nrel(_end)
unexpected_lut_wrap:
                MOV     lut_wrap,   1
                JMP     done
var wrapped:    LONG    0
var lut_wrap:   LONG    0
var last_word:
                MOV     wrapped,    1
var cog_fallback:
                JMP     nrel(done)
var lut_fallback:
                JMP     nrel(unexpected_lut_wrap)
.lutexec    0x4000, 0x3ff
lut_last:
                MOV     wrapped,    1
.lutexec    0x4100, 0x200
                JMP     nrel(unexpected_lut_wrap)
.data

