// Select the test clock while retaining the ROM-calibrated UART divider for reporting.
.if pll
                HUBSET  aug(0x010009f8)
                WAITX   aug(200000)
                HUBSET  aug(0x010009fb)
                WAITX   64
.endif

                // Unit increment exposes exact start and return-bus delays without phase aliasing.
                WRPIN   aug(mode << 1), 4
                WXPIN   x,              4
                WYPIN   1,              4
                WAITX   16
                DIRH    4
                WYPIN   1,              4
.if gap
                WAITX   gap
.endif
                RQPIN   first,          4
                WAITX   5
                RQPIN   second,         4
                DIRL    4
                WAITX   16
                RQPIN   held,           4

                // Restore RCFAST before the shared reporter uses the ROM-calibrated UART.
                HUBSET  0xF0
                WAITX   64
                JMP     nrel(_end)

var first:      LONG    0
var second:     LONG    0
var held:       LONG    0

