//? post: cog[*].reg[elapsed] == 20

                // _RET_ setup and EXECF must install the pattern for the destination stream.
                PUSH    nrel(destination)
                GETCT   a
.if kind == 0
    return      SKIP    15
.elif   kind == 1
    return      SKIPF   15
.elif   kind == 2
                EXECF   target
.elif   kind == 3
                REP     4,      3
                SKIP    2
.elif   kind == 4
                REP     3,      3
                SKIPF   2
.else
                REP     2,      3
                SKIPF   2
.endif
                ADD     value,  1
                ADD     value,  1
                ADD     value,  1
                ADD     value,  1
                GETCT   b
                JMP     nrel(checked)
destination:
                ADD     value,  1
                ADD     value,  1
                ADD     value,  1
                ADD     value,  1
                GETCT   b
checked:
                MOV     elapsed,    b
                SUB     elapsed,    a
                GETBRK  inside                      :wc
                GETBRK  pattern_out                 :wz
                SKIP    0
                AND     inside,     aug(0xF8000000)
                JMP     nrel(_end)
var target:     LONG    pcaddr(destination) | (15 << 10)
var value:      LONG    0
var inside:     LONG    0
var after:      LONG    0
var pattern_out:
                LONG    0
var elapsed:    LONG    0
var a:          LONG    0
var b:          LONG    0

