//? macro: skip set SKIP 2
//? cog: 0
//? const: fast = 0
//? post: cog[*].reg[value] == 7
//? post: cog[*].reg[inside] == 134217728
//? post: cog[*].reg[pattern_out] == 0
//? post: cog[*].reg[elapsed] == 30
