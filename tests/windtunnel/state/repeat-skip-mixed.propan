//? run: "kind4-fast0-cog7"
//? macro: selected_kind set REP 3, 3
//? macro: skip set SKIPF 2
//? cog: 7
//? const: fast = 0
//? post: cog[*].reg[value] == 7
//? post: cog[*].reg[inside] == 0
//? post: cog[*].reg[pattern_out] == 0
//? post: cog[*].reg[elapsed] == 24
//?
//? run: "kind5-fast0-cog0"
//? macro: selected_kind set REP 2, 3
//? macro: skip set SKIPF 2
//? cog: 0
//? const: fast = 0
//? post: cog[*].reg[value] == 5
//? post: cog[*].reg[inside] == 0
//? post: cog[*].reg[pattern_out] == 0
//? post: cog[*].reg[elapsed] == 20
//?
//? run: "kind5-fast0-cog7"
//? macro: selected_kind set REP 2, 3
//? macro: skip set SKIPF 2
//? cog: 7
//? const: fast = 0
//? post: cog[*].reg[value] == 5
//? post: cog[*].reg[inside] == 0
//? post: cog[*].reg[pattern_out] == 0
//? post: cog[*].reg[elapsed] == 20

                // _RET_ setup and EXECF must install the pattern for the destination stream.
                PUSH    nrel(destination)
                GETCT   a
                {{ selected_kind }}
                {{ skip }}
                ADD     value,  1
                ADD     value,  1
                ADD     value,  1
                ADD     value,  1
                GETCT   b
                JMP     nrel(checked)
destination:
                ADD     value,  1
                ADD     value,  1
                ADD     value,  1
                ADD     value,  1
                GETCT   b
checked:
                MOV     elapsed,    b
                SUB     elapsed,    a
                GETBRK  inside                      :wc
                GETBRK  pattern_out                 :wz
                SKIP    0
                AND     inside,     aug(0xF8000000)
                JMP     nrel(_end)
var target:     LONG    pcaddr(destination) | (15 << 10)
var value:      LONG    0
var inside:     LONG    0
var after:      LONG    0
var pattern_out:
                LONG    0
var elapsed:    LONG    0
var a:          LONG    0
var b:          LONG    0

