//? WINDTUNNEL CHECK LIST
//? timeout-ms: 1000
//? pre: cog[0].c = false
//? post: cog[0].reg[value] == 42
//? post: cog[0].reg[copied] == 42
//? post: cog[0].reg[skipped] == 0
//? post: cog[0].reg[first] == 0x12345678
//? post: cog[0].reg[second] == 0x101

_start:
    AUGS 0x12345678
    MOV copied, value
if(C) MOV skipped, 1
    MOV first, 0x12345678 & 0x1ff
    MOV second, 0x101
    JMP nrel(_end)
var value: LONG 42
var copied: LONG 0
var skipped: LONG 0
var first: LONG 0
var second: LONG 0
