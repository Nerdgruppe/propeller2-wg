//?
//? run: "dds-lut 39"
//? const: frequency = 0x10000000
//? const: control = 0xf0070004
//? const: config = 0x1fff
//? const: lut = 0x0
//? const: increment = 0x1010000
//? const: pins = 0xf
//? post: cog[0].reg[x] == 0xffffffb1
//? post: cog[0].reg[y] == 0xffffffd0
//? post: cog[0].reg[again] == 0xffffffb1
//? post: cog[0].reg[qval] == 0xffffffd0

                // Drive known digital input bits; no electrical ADC model participates in these vectors.
                HUBSET  aug(0x01000098)
                WAITX   aug(300000)
                HUBSET  aug(0x0100009b)
                MOV     OUTA,   aug(pins)
                DIRH    aug(0 | (3 << 6))
                WAITX   20
                // Fill the whole LUT so phase, table base, offset and signed byte overflow are observable.
                MOV     index,  0
                MOV     value,  aug(lut)
fill_table:
                WRLUT   value,          index
                ADD     value,          aug(increment)
                ADD     index,          1
                CMP     index,          aug(512)        :wz
    if(!Z)      JMP     fill_table
                // A fresh finite command freezes its final integration state when it ends.
                SETQ    aug(frequency)
                XINIT   aug(control),   aug(config)
                WAITXFI
                GETXACC x
                MOV     y,              0
                GETXACC again
                MOV     qval,           0
                // Restore the oracle's terminal clock before returning its register snapshot.
                HUBSET  0xf0
                WAITX   aug(50000)
                MOV     DIRA,           0
                JMP     nrel(_end)
var index:      LONG    0
var value:      LONG    0
var x:          LONG    0
var y:          LONG    0
var again:      LONG    0
var qval:       LONG    0

