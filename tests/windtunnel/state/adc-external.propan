                // An independently driven B signal clocks a constant A-selected OUT value.
                DIRL    aug(40 | (1 << 6))
                WRPIN   aug(0x41000032),    40
                WRPIN   0,                  41
                WXPIN   x,                  40
                OUTL    aug(40 | (1 << 6))
.if level
                OUTH    40
.endif
                DIRH    aug(40 | (1 << 6))
                MOV     count,              64
sampling_loop:
                OUTH    41
                WAITX   8
                OUTL    41
                WAITX   8
                DJNZ    count,  sampling_loop
                WAITX   16
                RQPIN   value,  40                  :wc
                MOV     flag,   0
                MUXC    flag,   1
                TESTP   40                          :wc
                MUXC    flag,   2
                DIRL    aug(40 | (1 << 6))
                WRPIN   0,      aug(40 | (1 << 6))
                JMP     nrel(_end)
var value:      LONG    0
var flag:       LONG    0
var count:      LONG    0

