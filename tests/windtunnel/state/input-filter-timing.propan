//? run: "length3-tap5-phase0"
//? post: cog[*].reg[rising] == 0x0
//? post: cog[*].reg[falling] == 0x0
//? const: length = 3
//? const: tap = 5
//? const: phase = 0
//? run: "length3-tap5-phase1"
