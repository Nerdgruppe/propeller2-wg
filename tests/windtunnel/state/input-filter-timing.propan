//? post: cog[*].reg[falling] == 0x0
//? const: length = 3
//? const: tap = 5
//? const: phase = 1

                // Select the cog OUT bit to isolate filter timing from physical pad latency.
                DIRH    8
                OUTL    8
                HUBSET  aug(0x40000000 | (length << 5) | tap)
                WRPIN   aug(0x40800000),    8
                WAITX   aug(1024)
                GETCT   clock
                ADD     clock,              aug(512)
                ANDN    clock,              511
                ADDCT1  clock,              0
                WAITCT1
                GETCT   clock
                OUTH    8
.if phase != 0
                NOP
.endif
                TESTP   8                                       :wc
                RCL     rising,             1
                TESTP   8                                       :wc
                RCL     rising,             1
                TESTP   8                                       :wc
                RCL     rising,             1
                TESTP   8                                       :wc
                RCL     rising,             1
                TESTP   8                                       :wc
                RCL     rising,             1
                TESTP   8                                       :wc
                RCL     rising,             1
                TESTP   8                                       :wc
                RCL     rising,             1
                TESTP   8                                       :wc
                RCL     rising,             1
                TESTP   8                                       :wc
                RCL     rising,             1
                TESTP   8                                       :wc
                RCL     rising,             1
                TESTP   8                                       :wc
                RCL     rising,             1
                TESTP   8                                       :wc
                RCL     rising,             1
                TESTP   8                                       :wc
                RCL     rising,             1
                TESTP   8                                       :wc
                RCL     rising,             1
                TESTP   8                                       :wc
                RCL     rising,             1
                TESTP   8                                       :wc
                RCL     rising,             1
                TESTP   8                                       :wc
                RCL     rising,             1
                TESTP   8                                       :wc
                RCL     rising,             1
                TESTP   8                                       :wc
                RCL     rising,             1
                TESTP   8                                       :wc
                RCL     rising,             1
                TESTP   8                                       :wc
                RCL     rising,             1
                TESTP   8                                       :wc
                RCL     rising,             1
                TESTP   8                                       :wc
                RCL     rising,             1
                TESTP   8                                       :wc
                RCL     rising,             1
                TESTP   8                                       :wc
                RCL     rising,             1
                TESTP   8                                       :wc
                RCL     rising,             1
                TESTP   8                                       :wc
                RCL     rising,             1
                TESTP   8                                       :wc
                RCL     rising,             1
                TESTP   8                                       :wc
                RCL     rising,             1
                TESTP   8                                       :wc
                RCL     rising,             1
                TESTP   8                                       :wc
                RCL     rising,             1
                TESTP   8                                       :wc
                RCL     rising,             1
                OUTL    8
                TESTP   8                                       :wc
                RCL     falling,            1
                TESTP   8                                       :wc
                RCL     falling,            1
                TESTP   8                                       :wc
                RCL     falling,            1
                TESTP   8                                       :wc
                RCL     falling,            1
                TESTP   8                                       :wc
                RCL     falling,            1
                TESTP   8                                       :wc
                RCL     falling,            1
                TESTP   8                                       :wc
                RCL     falling,            1
                TESTP   8                                       :wc
                RCL     falling,            1
                TESTP   8                                       :wc
                RCL     falling,            1
                TESTP   8                                       :wc
                RCL     falling,            1
                TESTP   8                                       :wc
                RCL     falling,            1
                TESTP   8                                       :wc
                RCL     falling,            1
                TESTP   8                                       :wc
                RCL     falling,            1
                TESTP   8                                       :wc
                RCL     falling,            1
                TESTP   8                                       :wc
                RCL     falling,            1
                TESTP   8                                       :wc
                RCL     falling,            1
                TESTP   8                                       :wc
                RCL     falling,            1
                TESTP   8                                       :wc
                RCL     falling,            1
                TESTP   8                                       :wc
                RCL     falling,            1
                TESTP   8                                       :wc
                RCL     falling,            1
                TESTP   8                                       :wc
                RCL     falling,            1
                TESTP   8                                       :wc
                RCL     falling,            1
                TESTP   8                                       :wc
                RCL     falling,            1
                TESTP   8                                       :wc
                RCL     falling,            1
                TESTP   8                                       :wc
                RCL     falling,            1
                TESTP   8                                       :wc
                RCL     falling,            1
                TESTP   8                                       :wc
                RCL     falling,            1
                TESTP   8                                       :wc
                RCL     falling,            1
                TESTP   8                                       :wc
                RCL     falling,            1
                TESTP   8                                       :wc
                RCL     falling,            1
                TESTP   8                                       :wc
                RCL     falling,            1
                TESTP   8                                       :wc
                RCL     falling,            1
// Normalize the capture if WAITCT1 resumed four clocks later in the CT period.
// Taps 0/1/2 divide that offset exactly and need no normalization.
.if tap >= 3
                TESTB   clock,              3                   :wc
    if(C)       SHR     rising,             1
    if(C)       SAR     falling,            1
.endif
                // Phase normalization is bookkeeping; publish deterministic snapshot flags.
                MODCZ   _CLR,               _CLR                :wcz
                JMP     nrel(_end)
var clock:      LONG    0
var rising:     LONG    0
var falling:    LONG    0

