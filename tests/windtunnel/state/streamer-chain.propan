//? WINDTUNNEL CHECK LIST
//? macro: zero required
//?
//? run: "XCONT fractional"
//? macro: zero set XCONT
//? post: cog[*].reg[elapsed] == 149
//? post: cog[*].reg[frequency] == 149
//? const: frac = 0x30000000
//? const: count = 8
//?
//? run: "XZERO fractional"
//? macro: zero set XZERO
//? post: cog[*].reg[elapsed] == 150
//? post: cog[*].reg[frequency] == 150
//? const: frac = 0x30000000
//? const: count = 8
//?
//? run: "XCONT perpetual"
//? macro: zero set XCONT
//? post: cog[*].reg[elapsed] == 306
//? post: cog[*].reg[frequency] == 306
//? const: frac = 0x10000000
//? const: count = 0xffff
//?
//? run: "XZERO perpetual"
//? macro: zero set XZERO
//? post: cog[*].reg[elapsed] == 306
//? post: cog[*].reg[frequency] == 306
//? const: frac = 0x10000000
//? const: count = 0xffff

                // Fill the command buffer, stall on the third command, and apply its captured SETQ frequency.
                SETXFRQ aug(frac)
                GETCT   elapsed
                XINIT   aug(X_IMM_1X32_4DAC8 | count),  0
                {{ zero }}  aug(X_IMM_1X32_4DAC8 | 32), 0
                SETQ    aug(0x40000000)
                XCONT   aug(X_IMM_1X32_4DAC8 | 16),     0
                WAITXFI
                GETCT   frequency
                SUB     frequency,                      elapsed
                MOV     elapsed,                        frequency
                JMP     nrel(_end)
var elapsed:    LONG    0
var frequency:  LONG    0
