//? post: cog[*].reg[result0] == 0x00000000
//? post: cog[*].reg[result1] == 0x00000000
//? post: cog[*].reg[result2] == 0x00000001
//? post: cog[*].reg[result3] == 0x00000001
//? post: cog[*].reg[result4] == 0x00000001
//? post: cog[*].reg[result5] == 0x00000001
//? post: cog[*].reg[result6] == 0x00000001
//? post: cog[*].reg[result7] == 0x00000001
//? post: cog[*].reg[result8] == 0x00000001
//? post: cog[*].reg[result9] == 0x00000001
//? post: cog[*].reg[result10] == 0x00000001
//? post: cog[*].reg[result11] == 0x00000001
//? post: cog[*].reg[result12] == 0x00000001
//? post: cog[*].reg[result13] == 0x00000001
//? post: cog[*].reg[result14] == 0x00000001
//? post: cog[*].reg[result15] == 0x00000001
//? post: cog[*].reg[flags] == 0x00000000
//? post: cog[*].reg[ready] == 0x00000001
//? post: cog[*].reg[reset_result] == 0x00000000
//? post: cog[*].reg[reset_flag] == 0x00000000

// Select the test clock while retaining the ROM-calibrated UART divider for reporting.
.if pll
                HUBSET  aug(0x010009f8)
                WAITX   aug(200000)
                HUBSET  aug(0x010009fb)
                WAITX   64
.endif

                // P3/P5 supply physical A/B to P4. Each MOV changes both GPIO outputs together.
                DRVL    3
                DRVL    5
                WRPIN   aug(0x71000000 | (mode << 1)),  4
                WXPIN   aug(x),                         4
                WYPIN   aug(y),                         4
                WAITX   32
                DIRH    4

                // Stimulus 0: A=0, B=0.
                MOV     OUTA,                           0
                WAITX   9
                RQPIN   result0,                        4   :wc
                RCL     flags,                          1

                // Stimulus 1: A=1, B=0.
                MOV     OUTA,                           8
                WAITX   9
                RQPIN   result1,                        4   :wc
                RCL     flags,                          1

                // Stimulus 2: A=1, B=1.
                MOV     OUTA,                           40
                WAITX   9
                RQPIN   result2,                        4   :wc
                RCL     flags,                          1

                // Stimulus 3: A=0, B=1.
                MOV     OUTA,                           32
                WAITX   9
                RQPIN   result3,                        4   :wc
                RCL     flags,                          1

                // Stimulus 4: A=0, B=0.
                MOV     OUTA,                           0
                WAITX   9
                RQPIN   result4,                        4   :wc
                RCL     flags,                          1

                // Stimulus 5: A=0, B=1.
                MOV     OUTA,                           32
                WAITX   9
                RQPIN   result5,                        4   :wc
                RCL     flags,                          1

                // Stimulus 6: A=1, B=1.
                MOV     OUTA,                           40
                WAITX   9
                RQPIN   result6,                        4   :wc
                RCL     flags,                          1

                // Stimulus 7: A=1, B=0.
                MOV     OUTA,                           8
                WAITX   9
                RQPIN   result7,                        4   :wc
                RCL     flags,                          1

                // Stimulus 8: A=0, B=0.
                MOV     OUTA,                           0
                WAITX   9
                RQPIN   result8,                        4   :wc
                RCL     flags,                          1

                // Stimulus 9: A=1, B=1.
                MOV     OUTA,                           40
                WAITX   9
                RQPIN   result9,                        4   :wc
                RCL     flags,                          1

                // Stimulus 10: A=0, B=0.
                MOV     OUTA,                           0
                WAITX   9
                RQPIN   result10,                       4   :wc
                RCL     flags,                          1

                // Stimulus 11: A=1, B=0.
                MOV     OUTA,                           8
                WAITX   9
                RQPIN   result11,                       4   :wc
                RCL     flags,                          1

                // Stimulus 12: A=0, B=0.
                MOV     OUTA,                           0
                WAITX   9
                RQPIN   result12,                       4   :wc
                RCL     flags,                          1

                // Stimulus 13: A=0, B=1.
                MOV     OUTA,                           32
                WAITX   9
                RQPIN   result13,                       4   :wc
                RCL     flags,                          1

                // Stimulus 14: A=0, B=0.
                MOV     OUTA,                           0
                WAITX   9
                RQPIN   result14,                       4   :wc
                RCL     flags,                          1

                // Stimulus 15: A=0, B=0.
                MOV     OUTA,                           0
                WAITX   9
                RQPIN   result15,                       4   :wc
                RCL     flags,                          1

                TESTP   4                                   :wc
                WRC     ready
                DIRL    4
                WAITX   8
                RQPIN   reset_result,                   4   :wc
                WRC     reset_flag
                DIRL    3
                DIRL    5

                // Restore RCFAST before the shared reporter uses the ROM-calibrated UART.
                HUBSET  0xF0
                WAITX   64
                JMP     nrel(_end)

var result0:    LONG    0
var result1:    LONG    0
var result2:    LONG    0
var result3:    LONG    0
var result4:    LONG    0
var result5:    LONG    0
var result6:    LONG    0
var result7:    LONG    0
var result8:    LONG    0
var result9:    LONG    0
var result10:   LONG    0
var result11:   LONG    0
var result12:   LONG    0
var result13:   LONG    0
var result14:   LONG    0
var result15:   LONG    0
var flags:      LONG    0
var ready:      LONG    0
var reset_result:
                LONG    0
var reset_flag: LONG    0

