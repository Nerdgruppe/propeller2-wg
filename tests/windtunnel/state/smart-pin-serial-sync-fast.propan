//? post: cog[*].reg[second] == 0x00000000

// Use nominal 20 MHz RCFAST and retain the ROM-calibrated UART divider.

                // P5 generates the fastest deterministic B clock; P3 sends data and P4 receives it.
                WRPIN   aug(0x02000000 | P_TT_01 | P_SYNC_TX),  3
                WRPIN   aug(0x71000000 | P_SYNC_RX),            4
                WRPIN   P_TT_01 | P_NCO_FREQ,                   5
                WXPIN   bits - 1,                               3
                WXPIN   aug((bits - 1) | (sample << 5)),        4
                WXPIN   divider,                                5
                WYPIN   aug(0x89abcdef),                        3
                WYPIN   aug(0xffffffff),                        5
                DIRH    3
                DIRH    4
                WAITX   32
                DIRH    5
                // Bound both observation windows; never wait indefinitely for a receiver indication.
                WAITX   400
                RQPIN   first,                                  4                   :wc
                WRC     carry
                TESTP   4                                                           :wc
                WRC     ready
                RDPIN   tx_result,                              3
                WAITX   400
                RQPIN   second,                                 4
                DIRL    3
                DIRL    4
                DIRL    5

                // TT-enabled smart outputs still drive in reset; restore GPIO before reporting.
                DIRL    aug(0 | (7 << 6))
                WRPIN   0,                                      aug(0 | (7 << 6))

                // Restore RCFAST before the shared reporter uses the ROM-calibrated UART.
                HUBSET  0xF0
                WAITX   64
                JMP     nrel(_end)

var first:      LONG    0
var carry:      LONG    0
var ready:      LONG    0
var tx_result:  LONG    0
var second:     LONG    0

