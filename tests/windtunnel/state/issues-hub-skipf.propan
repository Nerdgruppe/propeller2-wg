//? WINDTUNNEL CHECK LIST
//? oracle: off "Simulator rejection policy for hub SKIPF, not a silicon timing assertion"
//? issues: hub_skipf = 1
//? post: cog[*].reg[value] == 10
//? run: "cog0"
//? cog: 0
//? run: "cog1"
//? cog: 1
//? run: "cog2"
//? cog: 2
//? run: "cog3"
//? cog: 3
//? run: "cog4"
//? cog: 4
//? run: "cog5"
//? cog: 5
//? run: "cog6"
//? cog: 6
//? run: "cog7"
//? cog: 7

                // Reject hub SKIPF without changing skip state; all ten following instructions execute.
                JMP     nrel(probe)
returned:
                JMP     nrel(_end)
var value:      LONG    0
.hubexec    0x4000
probe:
                SKIPF   255
                ADD     value,  1
                ADD     value,  1
                ADD     value,  1
                ADD     value,  1
                ADD     value,  1
                ADD     value,  1
                ADD     value,  1
                ADD     value,  1
                ADD     value,  1
                ADD     value,  1
                JMP     nrel(returned)
                NOP

