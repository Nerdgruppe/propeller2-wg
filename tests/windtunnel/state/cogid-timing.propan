//? macro: cogid set COGID 384
//? macro: add_operand set 4
//? const: phase = 7

                // Sweep every phase of the eight-clock hub command round robin.
                GETCT   start
                ADD     start,          256
                ANDN    start,          255
                ADDCT1  start,          0
                WAITCT1
                WAITX   phase
                GETCT   start
                {{ cogid }}
                GETCT   elapsed
                SUB     elapsed,        start
                // WAITCT1 can resume at a different issue phase. Derive the grant from measured CT.
                MOV     expected,       start
                ADD     expected,       2
                NEG     expected,       expected
                AND     expected,       7
                ADD     expected, {{ add_operand }}
                MOV     timing_error,   elapsed
                SUB     timing_error,   expected
                JMP     nrel(_end)
var start:      LONG    0
var elapsed:    LONG    0
var result:     LONG    0


var expected:   LONG    0
var timing_error:
                LONG    0

