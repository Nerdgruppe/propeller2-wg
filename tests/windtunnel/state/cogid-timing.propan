//? WINDTUNNEL CHECK LIST
//? post: cog[*].reg[timing_error] == 0
//? run: "kind0-phase0"
//? const: kind = 0
//? const: phase = 0
//? run: "kind0-phase1"
//? const: kind = 0
//? const: phase = 1
//? run: "kind0-phase2"
//? const: kind = 0
//? const: phase = 2
//? run: "kind0-phase3"
//? const: kind = 0
//? const: phase = 3
//? run: "kind0-phase4"
//? const: kind = 0
//? const: phase = 4
//? run: "kind0-phase5"
//? const: kind = 0
//? const: phase = 5
//? run: "kind0-phase6"
//? const: kind = 0
//? const: phase = 6
//? run: "kind0-phase7"
//? const: kind = 0
//? const: phase = 7
//? run: "kind1-phase0"
//? const: kind = 1
//? const: phase = 0
//? run: "kind1-phase1"
//? const: kind = 1
//? const: phase = 1
//? run: "kind1-phase2"
//? const: kind = 1
//? const: phase = 2
//? run: "kind1-phase3"
//? const: kind = 1
//? const: phase = 3
//? run: "kind1-phase4"
//? const: kind = 1
//? const: phase = 4
//? run: "kind1-phase5"
//? const: kind = 1
//? const: phase = 5
//? run: "kind1-phase6"
//? const: kind = 1
//? const: phase = 6
//? run: "kind1-phase7"
//? const: kind = 1
//? const: phase = 7
//? run: "kind2-phase0"
//? const: kind = 2
//? const: phase = 0
//? run: "kind2-phase1"
//? const: kind = 2
//? const: phase = 1
//? run: "kind2-phase2"
//? const: kind = 2
//? const: phase = 2
//? run: "kind2-phase3"
//? const: kind = 2
//? const: phase = 3
//? run: "kind2-phase4"
//? const: kind = 2
//? const: phase = 4
//? run: "kind2-phase5"
//? const: kind = 2
//? const: phase = 5
//? run: "kind2-phase6"
//? const: kind = 2
//? const: phase = 6
//? run: "kind2-phase7"
//? const: kind = 2
//? const: phase = 7

                // Sweep every phase of the eight-clock hub command round robin.
                GETCT   start
                ADD     start,          256
                ANDN    start,          255
                ADDCT1  start,          0
                WAITCT1
                WAITX   phase
                GETCT   start
.if kind == 0
                COGID   result
.endif
.if kind == 1
                COGID   0                           :wc
.endif
.if kind == 2
                COGID   384
.endif
                GETCT   elapsed
                SUB     elapsed,        start
                // WAITCT1 can resume at a different issue phase. Derive the grant from measured CT.
                MOV     expected,       start
                ADD     expected,       2
                NEG     expected,       expected
                AND     expected,       7
.if kind == 2
                ADD     expected,       4
.else
                ADD     expected,       6
.endif
                MOV     timing_error,   elapsed
                SUB     timing_error,   expected
                JMP     nrel(_end)
var start:      LONG    0
var elapsed:    LONG    0
var result:     LONG    0


var expected:   LONG    0
var timing_error:
                LONG    0

