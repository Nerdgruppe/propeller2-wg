//? WINDTUNNEL CHECK LIST
//? post: cog[*].reg[amount] == 256
//? macro: write required
//? macro: xinit required
//?
//? run: "read full rate"
//? macro: write set RDFAST
//? macro: xinit set XINIT aug(X_RFLONG_32P_4DAC8 | 64), 0
//? const: freq = 0x80000000
//?
//? run: "read slow"
//? macro: write set RDFAST
//? macro: xinit set XINIT aug(X_RFLONG_32P_4DAC8 | 64), 0
//? const: freq = 0x10000000
//?
//? run: "write full rate"
//? macro: write set WRFAST
//? macro: xinit set XINIT aug(X_32P_4DAC8_WFLONG | X_WRITE_ON | 64), 0
//? const: freq = 0x80000000
//?
//? run: "write slow"
//? macro: write set WRFAST
//? macro: xinit set XINIT aug(X_32P_4DAC8_WFLONG | X_WRITE_ON | 64), 0
//? const: freq = 0x10000000

                // Inspect consumed/enqueued bytes separately from physical FIFO grants.
                MOV     OUTA,                                       0
                MOV     DIRA,                                       aug(0xffffffff)
                WAITX   20
                {{ write }} 0, aug(hubaddr(buffer))
                SETXFRQ aug(freq)
                {{ xinit }}
                WAITXFI
                GETPTR  amount
                SUB     amount,                                     aug(hubaddr(buffer))
                WAITX   aug(1000)
                MOV     DIRA,                                       0
                JMP     nrel(_end)
var amount:     LONG    0
.data
.align  4
var buffer:     LONG    [0] * 128

