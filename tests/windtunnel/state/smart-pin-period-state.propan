//? post: cog[*].reg[second] == 0x00000025

// Use nominal 20 MHz RCFAST and retain the ROM-calibrated UART divider.

                // Separate a single rising/falling A start from B's rising end, with a fresh accumulator.
                DRVL    3
                DRVL    5
                MOV     OUTA,                           (initial << 3)
                WRPIN   aug(0x71000000 | (20 << 1)),    4
                WXPIN   1,                              4
                WYPIN   y,                              4
                WAITX   32
                DIRH    4
                WAITX   32
                MOV     OUTA,                           ((1 - initial) << 3)
                WAITX   delay
                OUTH    5
                WAITX   16
                RQPIN   first,                          4
                // Reset both source levels, then measure another identical interval.
                MOV     OUTA,                           (initial << 3)
                WAITX   32
                MOV     OUTA,                           ((1 - initial) << 3)
                WAITX   delay
                OUTH    5
                WAITX   16
                RQPIN   second,                         4
                DIRL    4
                DIRL    3
                DIRL    5

                // Restore RCFAST before the shared reporter uses the ROM-calibrated UART.
                HUBSET  0xF0
                WAITX   64
                JMP     nrel(_end)

var first:      LONG    0
var second:     LONG    0

