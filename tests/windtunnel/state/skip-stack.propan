//? post: cog[*].reg[inside] == 268435456
//? post: cog[*].reg[after] == 0
//? post: cog[*].reg[p0] == 1073741824
//? post: cog[*].reg[p1] == 1073741824
//? post: cog[*].reg[p2] == 0
//? post: cog[*].reg[link] == 0
//? post: cog[*].reg[value] == 0
//? post: cog[*].reg[count] == 0

// Separate skip suspension from the hardware stack's data and push/pop movement.
.if fast
                SKIPF   aug(0x80000000)
.else
                SKIP    aug(0x80000000)
.endif
                CALL    nrel(sub)
                NOP
                NOP
                NOP
                SKIP    0
                AND     before, aug(0xF8000000)
                AND     inside, aug(0xF8000000)
                AND     after,  aug(0xF8000000)
                JMP     nrel(_end)
sub:
                GETBRK  before      :wc
                GETBRK  p0          :wz
.if kind == 0
                // Pop the return address and jump through it without a RET.
                POP     link
                GETBRK  inside      :wc
                GETBRK  p1          :wz
                JMP     link
.elif   kind == 1
                // A balanced PUSH/POP pair must leave call suspension unchanged.
                PUSH    123
                POP     value
                GETBRK  inside      :wc
                GETBRK  p1          :wz
                RET
.elif   kind == 2
                // Observe both an extra PUSH and its matching POP independently.
                PUSH    123
                GETBRK  inside      :wc
                GETBRK  p1          :wz
                POP     value
                GETBRK  after       :wc
                GETBRK  p2          :wz
                RET
.elif   kind == 3
                // Restoring a popped return address does not restore a suspension flag.
                POP     link
                PUSH    link
                GETBRK  inside      :wc
                GETBRK  p1          :wz
                RET
.elif   kind == 4
                // Inspect depth before and after restoring the return address.
                POP     link
                GETBRK  inside      :wc
                GETBRK  p1          :wz
                PUSH    link
                GETBRK  after       :wc
                GETBRK  p2          :wz
                RET
.elif   kind == 5
                // A synthetic RET decrements depth regardless of the pushed entry.
                PUSH    nrel(done)
                RET
done:
                GETBRK  inside                  :wc
                GETBRK  p1                      :wz
                SKIP    0
                AND     before, aug(0xF8000000)
                AND     inside, aug(0xF8000000)
                AND     after,  aug(0xF8000000)
                JMP     nrel(_end)
.elif   kind == 6
                // Sixteen nested CALLs wrap the independent four-bit depth counter.
                ADD     count,  1
                CMP     count,  16              :wz
    if(!Z)      CALL    nrel(sub)
                GETBRK  inside                  :wc
                GETBRK  p1                      :wz
                SKIP    0
                AND     before, aug(0xF8000000)
                AND     inside, aug(0xF8000000)
                AND     after,  aug(0xF8000000)
                JMP     nrel(_end)
.else
                // Overwrite all eight data-stack entries while the skip counter is held.
                PUSH    nrel(done2)
                PUSH    nrel(done2)
                PUSH    nrel(done2)
                PUSH    nrel(done2)
                PUSH    nrel(done2)
                PUSH    nrel(done2)
                PUSH    nrel(done2)
                PUSH    nrel(done2)
                PUSH    nrel(done2)
                GETBRK  inside                  :wc
                GETBRK  p1                      :wz
                SKIP    0
                AND     before, aug(0xF8000000)
                AND     inside, aug(0xF8000000)
                AND     after,  aug(0xF8000000)
                JMP     nrel(_end)
done2:
                SKIP    0
                AND     before, aug(0xF8000000)
                AND     inside, aug(0xF8000000)
                AND     after,  aug(0xF8000000)
                JMP     nrel(_end)
.endif
var before:     LONG    0
var inside:     LONG    0
var after:      LONG    0
var p0:         LONG    0
var p1:         LONG    0
var p2:         LONG    0
var link:       LONG    0
var value:      LONG    0
var count:      LONG    0
var depth_value:
                LONG    0

