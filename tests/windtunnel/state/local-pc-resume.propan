                //? WINDTUNNEL CHECK LIST
                //? timeout-ms: 3000
                //? run: "kind0-cog0"
                //? post: cog[*].reg[hits] == 0x2
                //? post: cog[*].reg[saved] == 0x404
                //? post: cog[*].reg[landed] == 0x1
                //? post: cog[*].reg[elapsed] == 0x37
                //? cog: 0
                //? const: kind = 0
                //? const: phase = 20
                //? run: "kind0-cog7"
                //? post: cog[*].reg[hits] == 0x2
                //? post: cog[*].reg[saved] == 0x404
                //? post: cog[*].reg[landed] == 0x1
                //? post: cog[*].reg[elapsed] == 0x37
                //? cog: 7
                //? const: kind = 0
                //? const: phase = 20
                //? run: "kind1-cog0"
                //? post: cog[*].reg[hits] == 0x2
                //? post: cog[*].reg[saved] == 0x404
                //? post: cog[*].reg[landed] == 0x1
                //? post: cog[*].reg[elapsed] == 0x37
                //? cog: 0
                //? const: kind = 1
                //? const: phase = 20
                //? run: "kind1-cog7"
                //? post: cog[*].reg[hits] == 0x2
                //? post: cog[*].reg[saved] == 0x404
                //? post: cog[*].reg[landed] == 0x1
                //? post: cog[*].reg[elapsed] == 0x37
                //? cog: 7
                //? const: kind = 1
                //? const: phase = 20
                // Return from CT1 to an overflow PC with a controlled hub landing instruction.
                // Keep setup beyond the cog-zero template that it installs.
                JMP     nrel(setup)
                NOP
                NOP
                NOP
                NOP
                NOP
                NOP
                NOP
                NOP
                NOP
                NOP
                NOP
                NOP
                NOP
                NOP
                NOP
                NOP
setup:
                // Install controlled instruction sources before entering the local boundary.
                SETQ    6
                RDLONG  register(0),    aug(hubaddr(cog_template))
                MOV     PTRA,           aug(hubaddr(tail_template))
                RDLONG  word,           PTRA++
                WRLUT   word,           aug(510)
                RDLONG  word,           PTRA++
                WRLUT   word,           aug(511)
                STALLI
                MOV     IJMP1,          vector
                SETINT1 0
                GETCT   timer
                ADD     timer,          128
                ADDCT2  timer,          0
                ADD     timer,          phase
                ADDCT1  timer,          0
                SETINT1 EVENT_CT1
                NIXINT1
                WAITCT2
                ALLOWI
                GETCT   start
                JMP     nrel(tail_template)
done:
                GETCT   elapsed
                SUB     elapsed,    start
                MOV     stamp_a,    PA
                MOV     stamp_b,    PB
                MOV     stamp_c,    PTRA
                JMP     nrel(_end)
isr:
                // Stop further interrupts before saving or returning through the overflow PC.
                STALLI
                SETINT1 0
                MOV     saved,  IRET1
                AND     saved,  aug(0xfffff)
.if kind == 0
                RETI1
.else
                RESI1
.endif
var landed:     LONG    0
var vector:     LONG    pcaddr(isr)
var saved:      LONG    0
var timer:      LONG    0
var word:       LONG    0
var hits:       LONG    0
var stamp_a:    LONG    0
var stamp_b:    LONG    0
var stamp_c:    LONG    0
var start:      LONG    0
var elapsed:    LONG    0
.cogexec    0x3000, 0
cog_template:
                // These words are loaded into the physical cog instruction slots above.
                ADD     hits,   1
                NOP

                JMP     nrel(done)
                NOP
                NOP
                NOP
                NOP
.lutexec    0x3100, 0x3fe
tail_template:
                // Enter the final LUT words and continue with a retained logical PC.
                NOP
                NOP


.hubexec    0x404
                MOV     landed, 1
                JMP     nrel(done)

