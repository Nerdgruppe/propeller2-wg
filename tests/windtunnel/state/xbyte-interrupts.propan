//? post: cog[*].reg[elapsed] == 80
//? post: cog[*].reg[stack_out] == 511

                // Move CT1 through the initial phantom dispatch and three single-instruction handlers.
                STALLI
                MOV     IJMP1,          vector
                SETINT1 0
                WRLUT   nrel(handler),  0
                WRLUT   nrel(finish),   1
                RDFAST  0,              aug(hubaddr(bytecodes))
                PUSH    0x1ff
                MOV     PA,             0xaa
                MOV     PB,             0xbb
                GETCT   timer
                ADD     timer,          128
                ADDCT2  timer,          0
                ADD     timer,          phase
                ADDCT1  timer,          0
                SETINT1 EVENT_CT1
                NIXINT1
                WAITCT2
                ALLOWI
                GETCT   start
    return      SETQ    0
handler:
                ADD     count,  1
                NOP
                NOP
    return      MOV     marker, 1
finish:
                GETCT   elapsed
                STALLI
                SETINT1 0
                POP     stack_out
                SUB     elapsed,    start
                SUB     stamp,      start
                AND     saved,      aug(0xfffff)
                AND     status,     aug(0xffff0000)
                JMP     nrel(_end)
isr:
                GETCT   stamp
                GETCT   future
                ADD     future,     aug(4096)
                ADDCT1  future,     0
                MOV     saved,      IRET1
                MOV     observed,   count
                MOV     isr_pa,     PA
                MOV     isr_pb,     PB
                GETBRK  status                  :wc
                RETI1
var future:     LONG    0
var marker:     LONG    0
var vector:     LONG    pcaddr(isr)
var timer:      LONG    0
var start:      LONG    0
var count:      LONG    0
var observed:   LONG    0
var stamp:      LONG    0
var saved:      LONG    0
var isr_pa:     LONG    0
var isr_pb:     LONG    0
var status:     LONG    0
var elapsed:    LONG    0
var stack_out:  LONG    0
.hubexec    0x4000
bytecodes:      BYTE    0,  0,  0,  1

