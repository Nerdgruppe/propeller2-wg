                // Exercise packed shifts and refills across several FIFO source words.
                MOV     OUTA,   0
                MOV     DIRA,   aug(0xffffffff)
.if lut
                MOV     index,  0
fill:
                WRLUT   index,                              index
                ADD     index,                              1
                CMP     index,                              aug(512)                :wz
    if(!Z)      JMP     fill
.endif
                RDFAST  0,                                  aug(hubaddr(data))
                SETXFRQ aug(0x04000000)
                XINIT   aug((mode << 16) | X_PINS_ON | 40), 15
                WAITX   10
                MOV     s0,                                 INA
                AND     s0,                                 aug(mask)
                WAITXRO
                WAITX   10
                MOV     s1,                                 INA
