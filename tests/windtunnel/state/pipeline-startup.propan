    MOV PTRA, aug(hubaddr(sources))
    MOV mailbox, aug(hubaddr(stamp))
    MOV mode, 0
mode_loop:
    MOV control, probe_target
    CMP mode, 0 :wz
if(!Z) OR control, 0x20
    MOV bank, 0
bank_loop:
    RDLONG source, PTRA++
    MOV offset, 0
phase_loop:
    MOV control, probe_target
    CMP mode, 0 :wz
if(!Z) OR control, 0x20
    WRLONG 0, mailbox
    GETCT timer
    ADD timer, 128
    ANDN timer, 7
    ADD timer, offset
    ADDCT1 timer, 0
    WAITCT1
    GETCT start
    SETQ mailbox
    COGINIT control, source :wc
    GETCT finish
    SUB finish, start
    WAITX aug(1024)
    RDLONG target_time, mailbox
    SUB target_time, start
    AND start, 7
    MOV command_delay, probe_observer
    SUB command_delay, start
    SUB command_delay, 4
    AND command_delay, 7
    MOV expected, command_delay
    ADD expected, 8
    CMP finish, expected :wz
if(!Z) ADD failures, 1
    SUB target_time, command_delay
    SUB target_time, 4
    MOV expected, 21
    CMP mode, 1 :wz
if(Z) JMP compare_startup
    MOV expected, bank
    SUB expected, probe_observer
    SUB expected, probe_target
    CMP mode, 0 :wz
if(Z) SUB expected, 17
if(!Z) SUB expected, 22
    AND expected, 7
    CMP mode, 0 :wz
if(Z) ADD expected, aug(531)
if(!Z) ADD expected, 30
compare_startup:
    CMP target_time, expected :wz
if(!Z) ADD failures, 1
    ADD offset, 1
    CMP offset, 8 :wz
if(!Z) JMP phase_loop
    ADD bank, 1
    CMP bank, 8 :wz
if(!Z) JMP bank_loop
    ADD mode, 1
    CMP mode, 3 :wz
if(!Z) JMP mode_loop
    SETQ 0
    JMP nrel(_end)
var mode: LONG 0
var control: LONG 0
var bank: LONG 0
var offset: LONG 0
var source: LONG 0
var mailbox: LONG 0
var timer: LONG 0
var start: LONG 0
var finish: LONG 0
var target_time: LONG 0
var expected: LONG 0
var command_delay: LONG 0
var failures: LONG 0
.data
stamp: LONG 0
sources: LONG hubaddr(image0),hubaddr(image1),hubaddr(image2),hubaddr(image3),hubaddr(image4),hubaddr(image5),hubaddr(image6),hubaddr(image7), 0,0,0,0,0,0,0,0, hubaddr(hub0),hubaddr(hub1),hubaddr(hub2),hubaddr(hub3),hubaddr(hub4),hubaddr(hub5),hubaddr(hub6),hubaddr(hub7)
.cogexec 16384, 0
image0:
    GETCT register(20)
    WRLONG register(20), PTRA
    COGID register(21)
    COGSTOP register(21)
    LONG [0] * 500
.cogexec 20484, 0
image1:
    GETCT register(20)
    WRLONG register(20), PTRA
    COGID register(21)
    COGSTOP register(21)
    LONG [0] * 500
