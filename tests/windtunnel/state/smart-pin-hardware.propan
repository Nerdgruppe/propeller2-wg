                WAITCT1
                WXPIN   0x155,          40
                WAITX   128
                RQPIN   probe_result,   40

                JMP     nrel(_end)
var probe_result:
                LONG    0
var target:     LONG    0
.data
mailbox:        LONG    0
.cogexec    0x4000, 0
worker:
                RDLONG  register(300),  PTRA
                CMP     register(300),  0       :wz
    if(Z)       JMP     worker
                ADDCT1  register(300),  0
                WAITCT1
                WXPIN   0x0aa,          40
                COGSTOP 1
                LONG    [0] * 490
.data

