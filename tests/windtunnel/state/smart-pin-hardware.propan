//? post: cog[*].reg[probe_result] == 1
//?
//? run: "OR P_OUTBIT_A, worker DIRL"
//? macro: immediate_readback set RQPIN
//? macro: short_gap set NOP
//? macro: short_observe set RQPIN probe_result, 40
//? macro: delayed_gap set NOP
//? macro: delayed_observe set TESTP 40 :wc
//? macro: queued_observe set MOV probe_result, INB
//? macro: ack_readback set RDPIN probe_result, 40
//? macro: worker_stimulus set WXPIN 0x155, 40
//? macro: worker_settle set RQPIN probe_result, 40
//? macro: worker_command set WXPIN 0x0aa, 40
//? macro: input_pin_mode set aug(P_OUTBIT_A)
//? macro: input_worker_direction set DIRL
//? const: probe_layout = 8
//? post: cog[*].reg[probe_result] == 0
//?
//? run: "OR P_OUTBIT_A, worker DIRH"
//? macro: immediate_readback set RQPIN
//? macro: short_gap set NOP
//? macro: short_observe set RQPIN probe_result, 40
//? macro: delayed_gap set NOP
//? macro: delayed_observe set TESTP 40 :wc
//? macro: queued_observe set MOV probe_result, INB
//? macro: ack_readback set RDPIN probe_result, 40
//? macro: worker_stimulus set WXPIN 0x155, 40
//? macro: worker_settle set RQPIN probe_result, 40
//? macro: worker_command set WXPIN 0x0aa, 40
//? macro: input_pin_mode set aug(P_OUTBIT_A)
//? macro: input_worker_direction set DIRH
//? const: probe_layout = 8
//? post: cog[*].reg[probe_result] == 1

// Real-board characterization keeps nine distinct code/data layouts.
// Run-local instruction fragments select stimuli within each unchanged layout.
.if probe_layout == 0
                // Read a smart pin immediately after its repository write.
                DIRL    40
                WRPIN   2, 40
                DIRH    40
                WXPIN   0, 40
                WAITX   32
                WXPIN   0x155, 40
                {{ immediate_readback }}    probe_result, 40
                JMP     nrel(_end)
var probe_result:
                LONG    0
.endif

.if probe_layout == 1
                // Configure, stimulate, and sample the shortest delayed smart-pin sequences.
                DIRL    40
                WRPIN   {{ short_pin_mode }}, 40
                {{ short_enable }}  40
                {{ short_initialize }}
                WAITX   32
                {{ short_stimulus }}
                {{ short_gap }}
                {{ short_observe }}
                JMP     nrel(_end)
var probe_result:
                LONG    0
.endif

.if probe_layout == 2
                // Observe delayed smart-pin readback and input-event transitions.
                DIRL    40
                WRPIN   {{ delayed_pin_mode }}, 40
                {{ delayed_enable }}    40
                {{ delayed_initialize }}
                WAITX   32
                {{ delayed_stimulus }}
                {{ delayed_gap }}
                {{ delayed_observe }}
                {{ delayed_capture }}
                JMP     nrel(_end)
var probe_result:
                LONG    0
.endif

.if probe_layout == 3
                // Observe smart-pin acknowledgement and queued input transitions.
                DIRL    40
                WRPIN   {{ queued_pin_mode }}, 40
                {{ queued_enable }} 40
                {{ queued_initialize }}
                WAITX   32
                {{ queued_stimulus }}
                {{ queued_gap }}
                {{ queued_observe }}
                {{ queued_extract }}
                {{ queued_mask }}
                JMP     nrel(_end)
var probe_result:
                LONG    0
.endif

.if probe_layout == 4
                // Check longer acknowledgement and queued-transition sequences.
                DIRL    40
                {{ ack_prepare }}
                {{ ack_enable }}
                {{ ack_initialize }}
                {{ ack_drive }}
                {{ ack_drive_adjacent }}
                {{ ack_enable_adjacent }}
                {{ ack_readback }}
                {{ ack_gap }}
                TESTP   40 :wc
                WRC     probe_result
                JMP     nrel(_end)
var probe_result:
                LONG    0
.endif

.if probe_layout == 5
                // Check that repository writes during smart-pin reset are ignored.
                DIRL    40
                WRPIN   2, 40
                DIRH    40
                WXPIN   0, 40
                WAITX   32
                WXPIN   0x155, 40
                WAITX   32
                DIRL    40
                WAITX   32
                WXPIN   0x0aa, 40
                WAITX   32
                RQPIN   probe_result, 40
                JMP     nrel(_end)
var probe_result:
                LONG    0
.endif

.if probe_layout == 6
                // Compare smart-pin command arbitration against a worker cog.
                DIRL    40
                WRPIN   2, 40
                DIRH    40
                WXPIN   0, 40
                WAITX   32
                MOV     PTRA, aug(hubaddr(mailbox))
                WRLONG  0, PTRA
                SETQ    PTRA
                COGINIT {{ worker_cog }}, aug(hubaddr(worker))
                GETCT   target
                ADD     target, aug(2048)
                ANDN    target, 7
                WRLONG  target, PTRA
                ADDCT1  target, {{ worker_offset }}
                WAITCT1
                {{ worker_stimulus }}
                {{ worker_capture }}
                {{ worker_settle }}
                JMP     nrel(_end)
var probe_result:
                LONG    0
var target: LONG 0
.data
mailbox: LONG 0
.cogexec 0x4000, 0
worker:
                RDLONG  register(300), PTRA
                CMP     register(300), 0 :wz
    if(Z)       JMP     worker
                ADDCT1  register(300), 0
                WAITCT1
                {{ worker_command }}
                COGSTOP {{ worker_cog }}
                LONG    [0] * 490
.data
.endif

.if probe_layout == 7
                // Measure cross-cog command-to-readback visibility.
                DIRL    40
                WRPIN   2, 40
                DIRH    40
                WXPIN   0, 40
                WAITX   32
                MOV     PTRA, aug(hubaddr(mailbox))
                WRLONG  0, PTRA
                SETQ    PTRA
                COGINIT 1, aug(hubaddr(worker))
                GETCT   target
                ADD     target, aug(2048)
                ANDN    target, 7
                WRLONG  target, PTRA
                ADDCT1  target, {{ readback_offset }}
                WAITCT1
                RQPIN   probe_result, 40
                WAITX   128
                JMP     nrel(_end)
var probe_result:
                LONG    0
var target: LONG 0
.data
mailbox: LONG 0
.cogexec 0x4000, 0
worker:
                RDLONG  register(300), PTRA
                CMP     register(300), 0 :wz
    if(Z)       JMP     worker
                ADDCT1  register(300), 0
                WAITCT1
                WXPIN   0x0aa, 40
                COGSTOP 1
                LONG    [0] * 490
.data
.endif

.if probe_layout == 8
                // Check raw input routing against worker-cog direction changes.
                DIRL    40
                WRPIN   {{ input_pin_mode }}, 40
                OUTL    40
                DIRH    40
                COGINIT 1, aug(hubaddr(worker))
                WAITX   aug(2048)
                TESTP   40 :wc
                WRC     probe_result
                COGSTOP 1
                JMP     nrel(_end)
var probe_result:
                LONG    0
.cogexec 0x4000, 0
worker:
                OUTH    40
                {{ input_worker_direction }}    40
halt_worker:
                JMP     halt_worker
                LONG    [0] * 495
.data
.endif

