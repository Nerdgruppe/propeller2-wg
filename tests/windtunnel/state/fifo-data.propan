                JMP     nrel(_end)
var address:    LONG    0
var pointer:    LONG    0
var expected:   LONG    0
var loaded:     LONG    0
var status:     LONG    0
var failures:   LONG    0
.data
.align  32
padding:        BYTE    [0xcc] * 4
packet:         BYTE    [0xcc] * 24
variables:      BYTE    0,  1,  63, 64, 127,    128,    1,  255,    63, 128,    64, 255,    127,    128,    128,    1,  255,    255,    63, 128,    128,    64, 255,    255,    127,    128,    128,    128,    1,  255,    255,    255,    127,    128,    128,    128,    128,    255,    255,    255,    255

