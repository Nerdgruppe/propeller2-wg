                // Mix write sizes and verify packing, pointers, flags and untouched neighboring lanes.
                MOV     address,    aug(hubaddr(packet))
                ADD     address,    probe_alignment
                WRFAST  0,          address
                GETBRK  status                              :wcz
                TESTB   status,     20                      :wc
    if(!C)      ADD     failures,   1
                WFBYTE  0x12
                WFWORD  aug(0x3456)
                WFLONG  aug(0x89abcdef)
                WFBYTE  0
                WFWORD  0
                WFLONG  0
                WAITX   32
                GETPTR  pointer
                MOV     expected,   address
                ADD     expected,   14
                CMP     pointer,    expected                :wz
    if(!Z)      ADD     failures,   1
                MOV     pointer,    address
                SUB     pointer,    1
                RDBYTE  loaded,     pointer
                CMP     loaded,     0xcc                    :wz
    if(!Z)      ADD     failures,   1
                MOV     pointer,    address
                ADD     pointer,    14
                RDBYTE  loaded,     pointer
                CMP     loaded,     0xcc                    :wz
    if(!Z)      ADD     failures,   1
                RDFAST  0,          address
                GETBRK  status                              :wcz
                TESTB   status,     20                      :wc
    if(C)       ADD     failures,   1
                RFBYTE  loaded                              :wcz
    if(C)       ADD     failures,   1
    if(Z)       ADD     failures,   1
                CMP     loaded,     aug(18)                 :wz
    if(!Z)      ADD     failures,   1
                RFWORD  loaded                              :wcz
    if(C)       ADD     failures,   1
    if(Z)       ADD     failures,   1
                CMP     loaded,     aug(13398)              :wz
    if(!Z)      ADD     failures,   1
                RFLONG  loaded                              :wcz
    if(!C)      ADD     failures,   1
    if(Z)       ADD     failures,   1
                CMP     loaded,     aug(2309737967)         :wz
    if(!Z)      ADD     failures,   1
                RFBYTE  loaded                              :wcz
    if(C)       ADD     failures,   1
    if(!Z)      ADD     failures,   1
                CMP     loaded,     aug(0)                  :wz
    if(!Z)      ADD     failures,   1
                RFWORD  loaded                              :wcz
    if(C)       ADD     failures,   1
    if(!Z)      ADD     failures,   1
                CMP     loaded,     aug(0)                  :wz
    if(!Z)      ADD     failures,   1
                RFLONG  loaded                              :wcz
    if(C)       ADD     failures,   1
    if(!Z)      ADD     failures,   1
                CMP     loaded,     aug(0)                  :wz
    if(!Z)      ADD     failures,   1
                GETPTR  pointer
                CMP     pointer,    expected                :wz
    if(!Z)      ADD     failures,   1
                // Variable data tests exercise every payload width and both signs; the fourth byte supplies eight bits.
                RDFAST  0,          aug(hubaddr(variables))
                RFVAR   loaded                              :wcz
    if(C)       ADD     failures,   1
    if(!Z)      ADD     failures,   1
                CMP     loaded,     aug(0)                  :wz
    if(!Z)      ADD     failures,   1
                RFVAR   loaded                              :wcz
    if(C)       ADD     failures,   1
    if(Z)       ADD     failures,   1
                CMP     loaded,     aug(1)                  :wz
    if(!Z)      ADD     failures,   1
                RFVAR   loaded                              :wcz
    if(C)       ADD     failures,   1
    if(Z)       ADD     failures,   1
                CMP     loaded,     aug(63)                 :wz
    if(!Z)      ADD     failures,   1
                RFVAR   loaded                              :wcz
    if(C)       ADD     failures,   1
    if(Z)       ADD     failures,   1
                CMP     loaded,     aug(64)                 :wz
    if(!Z)      ADD     failures,   1
                RFVAR   loaded                              :wcz
    if(C)       ADD     failures,   1
    if(Z)       ADD     failures,   1
                CMP     loaded,     aug(127)                :wz
    if(!Z)      ADD     failures,   1
                RFVAR   loaded                              :wcz
