    if(!Z)      ADD     failures,   1
                RFVARS  loaded                              :wcz
    if(!C)      ADD     failures,   1
    if(Z)       ADD     failures,   1
                CMP     loaded,     aug(-268435456)         :wz
    if(!Z)      ADD     failures,   1
                RFVARS  loaded                              :wcz
    if(!C)      ADD     failures,   1
