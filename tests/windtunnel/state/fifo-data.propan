    if(Z)       ADD     failures,   1
                CMP     loaded,     aug(268435456)          :wz
    if(!Z)      ADD     failures,   1
                RFVAR   loaded                              :wcz
    if(C)       ADD     failures,   1
    if(Z)       ADD     failures,   1
                CMP     loaded,     aug(536870911)          :wz
    if(!Z)      ADD     failures,   1
                RDFAST  0,          aug(hubaddr(variables))
                RFVARS  loaded                              :wcz
    if(C)       ADD     failures,   1
    if(!Z)      ADD     failures,   1
                CMP     loaded,     aug(0)                  :wz
    if(!Z)      ADD     failures,   1
                RFVARS  loaded                              :wcz
    if(C)       ADD     failures,   1
    if(Z)       ADD     failures,   1
                CMP     loaded,     aug(1)                  :wz
    if(!Z)      ADD     failures,   1
                RFVARS  loaded                              :wcz
    if(C)       ADD     failures,   1
