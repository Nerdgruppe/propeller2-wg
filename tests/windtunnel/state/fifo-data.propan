    if(!Z)      ADD     failures,   1
                RFVAR   loaded                              :wcz
    if(C)       ADD     failures,   1
    if(Z)       ADD     failures,   1
                CMP     loaded,     aug(268435455)          :wz
    if(!Z)      ADD     failures,   1
