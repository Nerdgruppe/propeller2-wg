                CMP     loaded,     aug(128)                :wz
    if(!Z)      ADD     failures,   1
                RFVARS  loaded                              :wcz
    if(C)       ADD     failures,   1
    if(Z)       ADD     failures,   1
                CMP     loaded,     aug(8191)               :wz
    if(!Z)      ADD     failures,   1
                RFVARS  loaded                              :wcz
    if(!C)      ADD     failures,   1
    if(Z)       ADD     failures,   1
                CMP     loaded,     aug(-8192)              :wz
    if(!Z)      ADD     failures,   1
                RFVARS  loaded                              :wcz
    if(!C)      ADD     failures,   1
    if(Z)       ADD     failures,   1
                CMP     loaded,     aug(-1)                 :wz
    if(!Z)      ADD     failures,   1
                RFVARS  loaded                              :wcz
    if(C)       ADD     failures,   1
    if(Z)       ADD     failures,   1
                CMP     loaded,     aug(16384)              :wz
    if(!Z)      ADD     failures,   1
                RFVARS  loaded                              :wcz
    if(C)       ADD     failures,   1
    if(Z)       ADD     failures,   1
                CMP     loaded,     aug(1048575)            :wz
    if(!Z)      ADD     failures,   1
                RFVARS  loaded                              :wcz
    if(!C)      ADD     failures,   1
    if(Z)       ADD     failures,   1
                CMP     loaded,     aug(-1048576)           :wz
    if(!Z)      ADD     failures,   1
                RFVARS  loaded                              :wcz
    if(!C)      ADD     failures,   1
    if(Z)       ADD     failures,   1
                CMP     loaded,     aug(-1)                 :wz
    if(!Z)      ADD     failures,   1
                RFVARS  loaded                              :wcz
    if(C)       ADD     failures,   1
    if(Z)       ADD     failures,   1
                CMP     loaded,     aug(2097152)            :wz
    if(!Z)      ADD     failures,   1
