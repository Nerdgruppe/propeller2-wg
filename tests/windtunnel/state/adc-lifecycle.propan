                // Preserve a settled high A source while exercising live configuration strobes and reset.
                DIRL    40
                WRPIN   aug(0x40000000 | (mode << 1) | base),   40
                WXPIN   aug(x),                                 40
.if mode < 4
                WYPIN   aug(0x8000),                            40
.endif
                OUTH    40
                DIRH    40
                WAITX   160
.if action == 0
                WRPIN   aug(0x40000000 | (mode << 1) | base),   40
.endif
.if action == 1
                WXPIN   aug(x),                                 40
.endif
.if action == 2
                WYPIN   1,                                      40
.endif
.if action == 3
                DIRL    40
.endif
.if action == 4
                DIRL    40
                WAITX   4
                DIRH    40
.endif
                WAITX   delay
                RQPIN   value,                                  40  :wc
                MOV     flags,                                  0
                MUXC    flags,                                  1
                TESTP   40                                          :wc
                MUXC    flags,                                  2
                DIRL    40
                WRPIN   0,                                      40
                JMP     nrel(_end)
var value:      LONG    0
var flags:      LONG    0

