//? post: cog[0].reg[result] == 256
//? post: cog[0].reg[flags] == 6

                // Observe deterministic DAC levels with an adjacent, disabled comparator.
                DIRL    aug(40 | (1 << 6))
                WRPIN   0,              aug(40 | (1 << 6))
                SETDACS aug(dacs)
                WRPIN   aug(0x1c8000),  observer
.if observer_dir
                DIRH    observer
.endif
                WRPIN   aug(config),    source
                WXPIN   aug(x),         source
                WYPIN   aug(y),         source
.if out
                OUTH    40
.else
                OUTL    40
.endif
                DIRH    source
                WAITX   aug(2000)
                RQPIN   result,         source              :wc
                MOV     flags,          0
                MUXC    flags,          1
                TESTP   source                              :wc
                MUXC    flags,          2
.if (config & 0x3e) != 2
                TESTP   observer                            :wc
                MUXC    flags,          4
.endif
                DIRL    aug(40 | (1 << 6))
                WRPIN   0,              aug(40 | (1 << 6))
                JMP     nrel(_end)
var result:     LONG    0
var flags:      LONG    0

