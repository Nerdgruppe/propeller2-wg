//? const: y = 65535
//? const: source = 40
//? const: observer = 41
//? post: cog[0].reg[result] == 256
//? post: cog[0].reg[flags] == 6

                // Observe deterministic DAC levels with an adjacent, disabled comparator.
                DIRL    aug(40 | (1 << 6))
                WRPIN   0,              aug(40 | (1 << 6))
                SETDACS aug(dacs)
                WRPIN   aug(0x1c8000),  observer
                {{ dirh }}
                WRPIN   aug(config),    source
                WXPIN   aug(x),         source
                WYPIN   aug(y),         source
                {{ out }}   40
                DIRH    source
                WAITX   aug(2000)
                RQPIN   result,         source              :wc
                MOV     flags,          0
                MUXC    flags,          1
                TESTP   source                              :wc
                MUXC    flags,          2
                {{ testp }}
                {{ muxc }}
                DIRL    aug(40 | (1 << 6))
                WRPIN   0,              aug(40 | (1 << 6))
                JMP     nrel(_end)
var result:     LONG    0
var flags:      LONG    0

