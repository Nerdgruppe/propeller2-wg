//? post: cog[*].reg[observed_pc] == 0x0
//? post: cog[*].reg[landed] == 0x3
//? const: relative_offset = 128

                // Hardware-derived PC/mode checks. CALL and CALLPA exposed the same addresses and saved PCs as CALLD.
                // Only the named native instructions below are probed; the final JMP is the checklist's mandatory exit.
                CALLD   exit_link,  nrel(setup)
                NOP
                NOP
                NOP
                NOP
                NOP
setup:
// Initialize captured state while retaining nominal RCFAST and the oracle's UART configuration.
                HUBSET  0xf0
                MOV     PA,                             0
                MOV     PB,                             0
                MOV     link,                           0
                MOV     landed,                         0
                MOV     probe_address,                  aug(hubaddr(probe_table) + form * 4)
.if domain == 0
// Copy an explicitly unrolled NOP prefix, then wrap a hub FIFO through $FFFFC into low hub RAM.
                {{ setq }}
                {{ rdlong }}
                {{ setq }}
                {{ wrlong }}
                RDLONG  word,                           probe_address
                WRLONG  word,                           aug(probe_pc)
                WRLONG  fallthrough_word,               aug(probe_pc + 4)
                WRLONG  0,                              aug(0x7fffc)
.elif domain == 1
// The canceled native MOVs select the physical source of each retained logical overflow PC.
                {{ mov }}
                {{ mov_2 }}
                {{ mov_3 }}
                {{ mov_4 }}
                RDLONG  word,                           probe_address
                MOV     register(probe_pc - 0x400 + 1), word
                MOV     register(0),                    exit_word
                WRLUT   selector_1,                     aug(511)
                // Relative +/-128 and the absolute address select these S-port continuation words.
                MOV     register(128),                  exit_word
                MOV     register(384),                  exit_word
.else
                // Ordinary hub execution at $400 is the control for the overflow-local JMPREL cases.
                RDLONG  word,                           probe_address
                WRLONG  word,                           aug(probe_pc)
                WRLONG  fallthrough_word,               aug(probe_pc + 4)
.endif
                // Z=1 cancels source selectors and deliberately remains present in saved CALLD link words.
                CMP     zero,                           0                                       :wcz
                CALLD   exit_link,                      entry_target
fallthrough:
// LOC deliberately continues sequentially here.
                MOV     landed,     3
                CALLD   exit_link,  done_target
done:
// Capture the probe result before handing control to the existing reporter.
                MOV     result,         PA
                MOV     observed_pc,    PB
                JMP     nrel(_end)

var result:     LONG    0
var observed_pc:
                LONG    0
var landed:     LONG    0
var link:       LONG    0
var exit_link:  LONG    0
var word:       LONG    0
var zero:       LONG    0
var probe_address:
                LONG    0
// These are ordinary assembled instructions, copied to the controlled execution sources above.
var landing_loc:
                LOC     PB, $ + 1
var hub_marker:
                MOV     landed, 0x100
var local_marker:
                MOV     landed, 0x80
var exit_word:
                CALLD   exit_link,  done_target
var fallthrough_word:
                CALLD   exit_link,  fallthrough_target
var selector_1:
    if(!Z)      MOV     register(0),    1
var selector_2:
    if(!Z)      MOV     register(0),    2
var selector_3:
    if(!Z)      MOV     register(0),    3
var selector_4:
    if(!Z)      MOV     register(0),    4
var selector_5:
    if(!Z)      MOV     register(0),    5
var done_target:
                LONG    pcaddr(done)
var fallthrough_target:
                LONG    pcaddr(fallthrough)
.if domain == 0
var entry_target:
                LONG    0xffffc
.elif domain == 1
var entry_target:
                LONG    0x3ff
.else
var entry_target:
                LONG    probe_pc
.endif

// LOC adds its operand in PC units in either runtime mode; the native relocation retains that delta.
.hubexec    0x3000
probe_table:
.pic    force
relative_address:
                LOC     PA, $ + 4 + relative_offset
.pic    avoid
absolute_address:
                LOC     PA, nrel(operand & 0xfffff)
.pic    default

// Ownership declarations for runtime-installed local code; the source words are assembled above.
.cogexec    0x3100, 0x180
cog_landing:
                LOC     PB,         $ + 1
                MOV     landed,     0x80
                CALLD   exit_link,  done_target
.lutexec    0x3200, 0x380
lut_landing:
                LOC     PB,         $ + 1
                MOV     landed,     0x80
                CALLD   exit_link,  done_target
.lutexec    0x3300, 0x3ff
lut_entry:
    if(!Z)      MOV     register(0),    1
.cogexec    0x3400, 128
loc_positive_exit:
                CALLD   exit_link,  done_target

// This unrolled prefix supplies every low-hub instruction preceding the selected probe PC.
.hubexec    0x3800
hub_prefix:
                NOP
                NOP
                NOP
                NOP
                NOP
                NOP
                NOP
                NOP
