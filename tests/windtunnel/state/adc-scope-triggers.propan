                // Exercise both arming polarities and equality after fully settled low/high input.
                DIRL    40
                OUTL    40
                WRPIN   aug(0x40000034),    40
                WXPIN   aug(x),             40
                DIRH    40
                WAITX   160
                RQPIN   low,                40  :wc
                MOV     flags,              0
                MUXC    flags,              1
                OUTH    40
                WAITX   160
                RQPIN   high,               40  :wc
                MUXC    flags,              2
                TESTP   40                      :wc
                MUXC    flags,              4
                AKPIN   40
                OUTL    40
                WAITX   160
                RQPIN   again,              40  :wc
                MUXC    flags,              8
                TESTP   40                      :wc
                MUXC    flags,              16
                DIRL    40
                WRPIN   0,                  40
                JMP     nrel(_end)
var low:        LONG    0
var high:       LONG    0
var again:      LONG    0
var flags:      LONG    0

