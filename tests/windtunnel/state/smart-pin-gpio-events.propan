//? WINDTUNNEL CHECK LIST
//? timeout-ms: 1000
//? max-cycles: 500000
//? run: "pll0-phase0"
//? const: phase = 0
//? post: cog[*].reg[elapsed] == 0x0000000f
//? run: "pll0-phase1"
//? const: phase = 1
//? post: cog[*].reg[elapsed] == 0x0000000f
//? run: "pll0-phase2"
//? const: phase = 2
//? post: cog[*].reg[elapsed] == 0x0000000f
//? run: "pll0-phase3"
//? const: phase = 3
//? post: cog[*].reg[elapsed] == 0x0000000f
//? run: "pll0-phase4"
//? const: phase = 4
//? post: cog[*].reg[elapsed] == 0x0000000f
//? run: "pll0-phase5"
//? const: phase = 5
//? post: cog[*].reg[elapsed] == 0x0000000f
//? run: "pll0-phase6"
//? const: phase = 6
//? post: cog[*].reg[elapsed] == 0x0000000f
//? run: "pll0-phase7"
//? const: phase = 7
//? post: cog[*].reg[elapsed] == 0x0000000f

// Use nominal 20 MHz RCFAST and retain the ROM-calibrated UART divider.

                // Compare the pin-event sampling stage with a normal GPIO edge, independent of smart completion.
                DRVL    40
                WAITX   64
                SETSE1  0
                WAITX   64
                POLLSE1
                SETSE1  (0x40 | 40)
                WAITX   phase
                GETCT   started
                OUTH    40
                WAITSE1
                GETCT   elapsed
                SUB     elapsed,    started
                DIRL    40

                // Restore RCFAST before the shared reporter uses the ROM-calibrated UART.
                HUBSET  0xF0
                WAITX   64
                JMP     nrel(_end)

var elapsed:    LONG    0

var started:    LONG    0

