//? WINDTUNNEL CHECK LIST
//? timeout-ms: 2000
//? max-cycles: 100000
//? post: cog[*].reg[failures] == 0
//? macro: mov_operand required
//? macro: mov_2_operand required
//? macro: xor required
//? macro: modcz required
//? macro: modcz_2 required
//? macro: modcz_3_operand required
//? macro: setpat_operand required
//? macro: xor_2_operand required
//? macro: probe_equal required
//? macro: mov required
//? macro: call required
//? macro: mov_2 required
//? macro: pollpat required
//? macro: add required
//?
//? run: "cog0-ina-different"
//? macro: mov_operand set INA
//? macro: mov_2_operand set 5
//? macro: xor set XOR comparison, 1
//? macro: modcz set MODCZ _CLR, _CLR :wcz
//? macro: modcz_2 set MODCZ _SET, _SET :wcz
//? macro: modcz_3_operand set _CLR
//? macro: setpat_operand set aug(0x10005)
//? macro: xor_2_operand set OUTA
//? macro: probe_equal set // Changes between two unequal patterns do not produce a new mismatch edge.
//? macro: mov set MOV command, 5
//? macro: call set CALL exchange
//? macro: mov_2 set MOV command, 1
//? macro: pollpat set POLLPAT :wc
//? macro: add set if(C) ADD failures, 1
//? cog: 0
//? const: probe_writer = 1
//? const: probe_port = 0
//? const: probe_equal = 0
//?
//? run: "cog0-ina-equal"
//? macro: mov_operand set INA
//? macro: mov_2_operand set 5
//? macro: xor set
//? macro: modcz set MODCZ _CLR, _SET :wcz
//? macro: modcz_2 set MODCZ _SET, _CLR :wcz
