//? WINDTUNNEL CHECK LIST
//? timeout-ms: 2000
//? max-cycles: 100000
//? post: cog[*].reg[failures] == 0
//? run: "cog0-ina-different"
//? cog: 0
//? const: probe_writer = 1
//? const: probe_port = 0
//? const: probe_equal = 0
//? run: "cog0-ina-equal"
//? cog: 0
//? const: probe_writer = 1
//? const: probe_port = 0
//? const: probe_equal = 1
//? run: "cog0-inb-different"
//? cog: 0
//? const: probe_writer = 1
//? const: probe_port = 1
//? const: probe_equal = 0
//? run: "cog0-inb-equal"
//? cog: 0
//? const: probe_writer = 1
//? const: probe_port = 1
//? const: probe_equal = 1
//? run: "cog3-ina-different"
//? cog: 3
//? const: probe_writer = 2
//? const: probe_port = 0
//? const: probe_equal = 0
//? run: "cog3-ina-equal"
//? cog: 3
//? const: probe_writer = 2
//? const: probe_port = 0
//? const: probe_equal = 1
//? run: "cog3-inb-different"
//? cog: 3
//? const: probe_writer = 2
//? const: probe_port = 1
//? const: probe_equal = 0
//? run: "cog3-inb-equal"
//? cog: 3
//? const: probe_writer = 2
//? const: probe_port = 1
//? const: probe_equal = 1
//? run: "cog7-ina-different"
//? cog: 7
//? const: probe_writer = 6
//? const: probe_port = 0
//? const: probe_equal = 0
//? run: "cog7-ina-equal"
//? cog: 7
//? const: probe_writer = 6
//? const: probe_port = 0
//? const: probe_equal = 1
//? run: "cog7-inb-different"
//? cog: 7
//? const: probe_writer = 6
//? const: probe_port = 1
//? const: probe_equal = 0
//? run: "cog7-inb-equal"
//? cog: 7
//? const: probe_writer = 6
//? const: probe_port = 1
//? const: probe_equal = 1

                // The second cog holds distinct patterns on INA[3:0] and INB[3:0].
                // Every acknowledged change settles for 64 clocks; no propagation edge is asserted.
                MOV     PTRA,           aug(hubaddr(mailbox))
                MOV     PTRB,           PTRA
                ADD     PTRB,           4
                MOV     image,          aug(hubaddr(writer))
                SETQ    PTRA
                COGINIT probe_writer,   image
                MOV     command,        1
                CALL    exchange
                // Verify the selected architectural input and leave the other port different.
.if probe_port == 0
                MOV     observed,       INA
                MOV     expected,       5
.else
                MOV     observed,       INB
                MOV     expected,       10
.endif
                AND     observed,       15
                CMP     observed,       expected                :wz
    if(!Z)      ADD     failures,       1
                MOV     comparison,     expected
.if probe_equal == 0
                XOR     comparison,     1
.endif
                // SETPAT captures C/Z and both operands without modifying them.
.if probe_port == 0
.if probe_equal == 0
                MODCZ   _CLR,           _CLR                    :wcz
.else
                MODCZ   _CLR,           _SET                    :wcz
.endif
.else
.if probe_equal == 0
                MODCZ   _SET,           _CLR                    :wcz
.else
                MODCZ   _SET,           _SET                    :wcz
.endif
.endif
                SETPAT  mask,           comparison
                WRC     saved_c
                WRZ     saved_z
                CMP     saved_c,        probe_port              :wz
    if(!Z)      ADD     failures,       1
                CMP     saved_z,        probe_equal             :wz
    if(!Z)      ADD     failures,       1
                CMP     mask,           15                      :wz
    if(!Z)      ADD     failures,       1
                // Later C/Z changes must not affect the captured configuration.
.if probe_port == 0
.if probe_equal == 0
                MODCZ   _SET,           _SET                    :wcz
.else
                MODCZ   _SET,           _CLR                    :wcz
.endif
.else
.if probe_equal == 0
                MODCZ   _CLR,           _SET                    :wcz
.else
                MODCZ   _CLR,           _CLR                    :wcz
.endif
.endif
                // An already-true condition at SETPAT does not generate an event.
                POLLPAT                                         :wcz
    if(C)       ADD     failures,       1
    if(Z)       ADD     failures,       1
.if probe_equal == 0
                // Changes between two unequal patterns do not produce a new mismatch edge.
                MOV     command,        5
                CALL    exchange
                MOV     command,        1
                CALL    exchange
                POLLPAT                                         :wc
    if(C)       ADD     failures,       1
.endif
                // A false-to-true comparison transition produces one event, without level reassertion.
                MOV     command,        2
                CALL    exchange
                MOV     command,        1
                CALL    exchange
                POLLPAT                                         :wcz
    if(!C)      ADD     failures,       1
    if(!Z)      ADD     failures,       1
                POLLPAT                                         :wc
    if(C)       ADD     failures,       1
                // A later transition rearms PAT; JPAT consumes it and JNPAT sees it cleared.
                MOV     command,        2
                CALL    exchange
                MOV     command,        1
                CALL    exchange
                JPAT    matched
                ADD     failures,       1
matched:
                JNPAT   cleared
                ADD     failures,   1
cleared:
                JPAT    unexpected
                JMP     branch_done
unexpected:
                ADD     failures,   1
branch_done:
                // A latched event survives the comparison becoming false again.
                MOV     command,    2
                CALL    exchange
                MOV     command,    1
                CALL    exchange
                MOV     command,    2
                CALL    exchange
                POLLPAT                             :wc
    if(!C)      ADD     failures,   1
                POLLPAT                             :wcz
    if(C)       ADD     failures,   1
    if(Z)       ADD     failures,   1
                // A delayed, held match wakes WAITPAT while the receiving cog is stalled.
                MOV     command,    3
                WRLONG  command,    PTRA
                GETCT   timer
                ADD     timer,      aug(4096)
                SETQ    timer
                WAITPAT                             :wcz
    if(C)       ADD     failures,   1
    if(Z)       ADD     failures,   1
                CALL    await_ack
                POLLPAT                             :wc
    if(C)       ADD     failures,   1
                // Generate another latch, then verify that SETPAT clears it.
                MOV     command,    2
                CALL    exchange
                MOV     command,    1
                CALL    exchange
                MODCZ   _CLR,       _SET            :wcz
                SETPAT  0,          1
                POLLPAT                             :wcz
    if(C)       ADD     failures,   1
    if(Z)       ADD     failures,   1
                GETCT   timer
                ADD     timer,      128
                SETQ    timer
                WAITPAT                             :wcz
    if(!C)      ADD     failures,   1
    if(!Z)      ADD     failures,   1
                // S is not masked: a high S bit makes equality impossible despite changing low inputs.
.if probe_port == 0
                MODCZ   _CLR,       _SET            :wcz
                SETPAT  15,         aug(0x10005)
.else
                MODCZ   _SET,       _SET            :wcz
                SETPAT  15,         aug(0x1000a)
.endif
                MOV     command,    2
                CALL    exchange
                MOV     command,    1
                CALL    exchange
                POLLPAT                             :wc
    if(C)       ADD     failures,   1
                // An always-true mismatch also has no edges when S has unmasked high bits.
.if probe_port == 0
                MODCZ   _CLR,       _CLR            :wcz
                SETPAT  15,         aug(0x10005)
.else
                MODCZ   _SET,       _CLR            :wcz
                SETPAT  15,         aug(0x1000a)
.endif
                MOV     command,    2
                CALL    exchange
                MOV     command,    1
                CALL    exchange
                POLLPAT                             :wc
    if(C)       ADD     failures,   1
                // Reconfiguring false to always true establishes a baseline without a PAT edge.
                MODCZ   _SET,       _SET            :wcz
                SETPAT  0,          1
                WAITX   64
                SETPAT  0,          0
                MOV     command,    2
                CALL    exchange
                MOV     command,    1
                CALL    exchange
                POLLPAT                             :wc
    if(C)       ADD     failures,   1
                // Disable matching and stop the helper before the snapshot reporter runs.
                MODCZ   _SET,       _SET            :wcz
                SETPAT  0,          1
                MOV     command,    4
                CALL    exchange
                SETQ    0
                MODCZ   _CLR,       _CLR            :wcz
                JMP     nrel(_end)
// Send a new command and await its settled-level acknowledgment.
exchange:
                WRLONG  command,    PTRA
// Wait for the writer to finish the current command.
await_ack:
                RDLONG  ack,    PTRB
                CMP     ack,    command :wz
    if(!Z)      JMP     await_ack
                RET
var image:      LONG    0
var mask:       LONG    15
var comparison: LONG    0
var expected:   LONG    0
var observed:   LONG    0
var command:    LONG    0
var ack:        LONG    0
var saved_c:    LONG    0
var saved_z:    LONG    0
var timer:      LONG    0
var failures:   LONG    0
.data
mailbox:        LONG    [0, 0]
.cogexec    0x4000, 0
writer:
                MOV     register(402),  PTRA
                ADD     register(402),  4
                MOV     register(401),  0
writer_wait:
                RDLONG  register(400),  PTRA
                CMP     register(400),  register(401)   :wz
    if(Z)       JMP     writer_wait
                MOV     register(401),  register(400)
                CMP     register(400),  4               :wz
    if(Z)       JMP     writer_stop
                CMP     register(400),  3               :wz
    if(Z)       WAITX   aug(1024)
                // Drive only pins 0..3 and 32..35, leaving the UART pins alone.
                MOV     OUTA,           5
                MOV     OUTB,           10
                CMP     register(400),  2               :wz
.if probe_port == 0
    if(Z)       XOR     OUTA,           1
.else
    if(Z)       XOR     OUTB,           1
.endif
                CMP     register(400),  5               :wz
.if probe_port == 0
    if(Z)       XOR     OUTA,           2
.else
    if(Z)       XOR     OUTB,           2
.endif
                MOV     DIRA,           15
                MOV     DIRB,           15
                WAITX   64
                WRLONG  register(400),  register(402)
                JMP     writer_wait
writer_stop:
                WRLONG  register(400),  register(402)
                COGSTOP probe_writer

