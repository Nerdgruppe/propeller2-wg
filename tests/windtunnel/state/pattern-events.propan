//? macro: mov set
//? macro: call set
//? macro: mov_2 set
//? macro: pollpat set
//? macro: add set
//? cog: 0
//? const: probe_writer = 1
//? const: probe_port = 0
//? const: probe_equal = 1
//?
//? run: "cog0-inb-different"
//? macro: mov_operand set INB
//? macro: mov_2_operand set 10
//? macro: xor set XOR comparison, 1
//? macro: modcz set MODCZ _SET, _CLR :wcz
//? macro: modcz_2 set MODCZ _CLR, _SET :wcz
//? macro: modcz_3_operand set _SET
//? macro: setpat_operand set aug(0x1000a)
//? macro: xor_2_operand set OUTB
//? macro: probe_equal set // Changes between two unequal patterns do not produce a new mismatch edge.
//? macro: mov set MOV command, 5
//? macro: call set CALL exchange
//? macro: mov_2 set MOV command, 1
//? macro: pollpat set POLLPAT :wc
//? macro: add set if(C) ADD failures, 1
//? cog: 0
//? const: probe_writer = 1
//? const: probe_port = 1
//? const: probe_equal = 0
//?
//? run: "cog0-inb-equal"
//? macro: mov_operand set INB
//? macro: mov_2_operand set 10
//? macro: xor set
//? macro: modcz set MODCZ _SET, _SET :wcz
//? macro: modcz_2 set MODCZ _CLR, _CLR :wcz
//? macro: modcz_3_operand set _SET
//? macro: setpat_operand set aug(0x1000a)
//? macro: xor_2_operand set OUTB
//? macro: probe_equal set
//? macro: mov set
//? macro: call set
//? macro: mov_2 set
//? macro: pollpat set
//? macro: add set
//? cog: 0
//? const: probe_writer = 1
//? const: probe_port = 1
//? const: probe_equal = 1
//?
//? run: "cog3-ina-different"
//? macro: mov_operand set INA
//? macro: mov_2_operand set 5
//? macro: xor set XOR comparison, 1
//? macro: modcz set MODCZ _CLR, _CLR :wcz
//? macro: modcz_2 set MODCZ _SET, _SET :wcz
//? macro: modcz_3_operand set _CLR
//? macro: setpat_operand set aug(0x10005)
//? macro: xor_2_operand set OUTA
//? macro: probe_equal set // Changes between two unequal patterns do not produce a new mismatch edge.
//? macro: mov set MOV command, 5
//? macro: call set CALL exchange
//? macro: mov_2 set MOV command, 1
//? macro: pollpat set POLLPAT :wc
//? macro: add set if(C) ADD failures, 1
//? cog: 3
//? const: probe_writer = 2
//? const: probe_port = 0
//? const: probe_equal = 0
//?
//? run: "cog3-ina-equal"
//? macro: mov_operand set INA
//? macro: mov_2_operand set 5
//? macro: xor set
//? macro: modcz set MODCZ _CLR, _SET :wcz
//? macro: modcz_2 set MODCZ _SET, _CLR :wcz
//? macro: modcz_3_operand set _CLR
//? macro: setpat_operand set aug(0x10005)
//? macro: xor_2_operand set OUTA
//? macro: probe_equal set
//? macro: mov set
//? macro: call set
//? macro: mov_2 set
//? macro: pollpat set
//? macro: add set
//? cog: 3
//? const: probe_writer = 2
//? const: probe_port = 0
//? const: probe_equal = 1
//?
//? run: "cog3-inb-different"
//? macro: mov_operand set INB
//? macro: mov_2_operand set 10
//? macro: xor set XOR comparison, 1
//? macro: modcz set MODCZ _SET, _CLR :wcz
//? macro: modcz_2 set MODCZ _CLR, _SET :wcz
//? macro: modcz_3_operand set _SET
//? macro: setpat_operand set aug(0x1000a)
//? macro: xor_2_operand set OUTB
//? macro: probe_equal set // Changes between two unequal patterns do not produce a new mismatch edge.
//? macro: mov set MOV command, 5
//? macro: call set CALL exchange
//? macro: mov_2 set MOV command, 1
//? macro: pollpat set POLLPAT :wc
//? macro: add set if(C) ADD failures, 1
//? cog: 3
//? const: probe_writer = 2
//? const: probe_port = 1
//? const: probe_equal = 0
//?
//? run: "cog3-inb-equal"
//? macro: mov_operand set INB
//? macro: mov_2_operand set 10
//? macro: xor set
//? macro: modcz set MODCZ _SET, _SET :wcz
//? macro: modcz_2 set MODCZ _CLR, _CLR :wcz
//? macro: modcz_3_operand set _SET
//? macro: setpat_operand set aug(0x1000a)
//? macro: xor_2_operand set OUTB
//? macro: probe_equal set
//? macro: mov set
//? macro: call set
//? macro: mov_2 set
//? macro: pollpat set
//? macro: add set
//? cog: 3
//? const: probe_writer = 2
//? const: probe_port = 1
//? const: probe_equal = 1
//?
//? run: "cog7-ina-different"
//? macro: mov_operand set INA
//? macro: mov_2_operand set 5
//? macro: xor set XOR comparison, 1
//? macro: modcz set MODCZ _CLR, _CLR :wcz
//? macro: modcz_2 set MODCZ _SET, _SET :wcz
//? macro: modcz_3_operand set _CLR
//? macro: setpat_operand set aug(0x10005)
//? macro: xor_2_operand set OUTA
//? macro: probe_equal set // Changes between two unequal patterns do not produce a new mismatch edge.
//? macro: mov set MOV command, 5
//? macro: call set CALL exchange
//? macro: mov_2 set MOV command, 1
//? macro: pollpat set POLLPAT :wc
//? macro: add set if(C) ADD failures, 1
//? cog: 7
//? const: probe_writer = 6
//? const: probe_port = 0
//? const: probe_equal = 0
//?
//? run: "cog7-ina-equal"
//? macro: mov_operand set INA
//? macro: mov_2_operand set 5
//? macro: xor set
//? macro: modcz set MODCZ _CLR, _SET :wcz
//? macro: modcz_2 set MODCZ _SET, _CLR :wcz
//? macro: modcz_3_operand set _CLR
//? macro: setpat_operand set aug(0x10005)
//? macro: xor_2_operand set OUTA
//? macro: probe_equal set
//? macro: mov set
//? macro: call set
//? macro: mov_2 set
//? macro: pollpat set
//? macro: add set
//? cog: 7
//? const: probe_writer = 6
//? const: probe_port = 0
//? const: probe_equal = 1
//?
//? run: "cog7-inb-different"
//? macro: mov_operand set INB
//? macro: mov_2_operand set 10
//? macro: xor set XOR comparison, 1
//? macro: modcz set MODCZ _SET, _CLR :wcz
//? macro: modcz_2 set MODCZ _CLR, _SET :wcz
//? macro: modcz_3_operand set _SET
//? macro: setpat_operand set aug(0x1000a)
//? macro: xor_2_operand set OUTB
//? macro: probe_equal set // Changes between two unequal patterns do not produce a new mismatch edge.
//? macro: mov set MOV command, 5
//? macro: call set CALL exchange
//? macro: mov_2 set MOV command, 1
//? macro: pollpat set POLLPAT :wc
//? macro: add set if(C) ADD failures, 1
//? cog: 7
//? const: probe_writer = 6
//? const: probe_port = 1
//? const: probe_equal = 0
//?
//? run: "cog7-inb-equal"
//? macro: mov_operand set INB
//? macro: mov_2_operand set 10
//? macro: xor set
//? macro: modcz set MODCZ _SET, _SET :wcz
//? macro: modcz_2 set MODCZ _CLR, _CLR :wcz
//? macro: modcz_3_operand set _SET
//? macro: setpat_operand set aug(0x1000a)
//? macro: xor_2_operand set OUTB
//? macro: probe_equal set
//? macro: mov set
//? macro: call set
//? macro: mov_2 set
//? macro: pollpat set
//? macro: add set
//? cog: 7
//? const: probe_writer = 6
//? const: probe_port = 1
//? const: probe_equal = 1

                // The second cog holds distinct patterns on INA[3:0] and INB[3:0].
                // Every acknowledged change settles for 64 clocks; no propagation edge is asserted.
                MOV     PTRA,           aug(hubaddr(mailbox))
                MOV     PTRB,           PTRA
                ADD     PTRB,           4
                MOV     image,          aug(hubaddr(writer))
                SETQ    PTRA
                COGINIT probe_writer,   image
                MOV     command,        1
                CALL    exchange
                // Verify the selected architectural input and leave the other port different.
                MOV     observed, {{ mov_operand }}
                MOV     expected, {{ mov_2_operand }}
                AND     observed,       15
                CMP     observed,       expected                :wz
    if(!Z)      ADD     failures,       1
                MOV     comparison,     expected
                {{ xor }}
                // SETPAT captures C/Z and both operands without modifying them.
                {{ modcz }}
                SETPAT  mask,           comparison
                WRC     saved_c
                WRZ     saved_z
                CMP     saved_c,        probe_port              :wz
    if(!Z)      ADD     failures,       1
                CMP     saved_z,        probe_equal             :wz
    if(!Z)      ADD     failures,       1
                CMP     mask,           15                      :wz
    if(!Z)      ADD     failures,       1
                // Later C/Z changes must not affect the captured configuration.
                {{ modcz_2 }}
                // An already-true condition at SETPAT does not generate an event.
                POLLPAT :wcz
    if(C)       ADD     failures,       1
    if(Z)       ADD     failures,       1
                {{ probe_equal }}
                {{ mov }}
                {{ call }}
                {{ mov_2 }}
                {{ call }}
                {{ pollpat }}
                {{ add }}
                // A false-to-true comparison transition produces one event, without level reassertion.
                MOV     command,        2
                CALL    exchange
                MOV     command,        1
                CALL    exchange
                POLLPAT :wcz
    if(!C)      ADD     failures,       1
    if(!Z)      ADD     failures,       1
                POLLPAT :wc
    if(C)       ADD     failures,       1
                // A later transition rearms PAT; JPAT consumes it and JNPAT sees it cleared.
                MOV     command,        2
                CALL    exchange
                MOV     command,        1
                CALL    exchange
                JPAT    matched
                ADD     failures,       1
matched:
                JNPAT   cleared
                ADD     failures,   1
cleared:
                JPAT    unexpected
                JMP     branch_done
unexpected:
                ADD     failures,   1
branch_done:
                // A latched event survives the comparison becoming false again.
                MOV     command,    2
                CALL    exchange
                MOV     command,    1
                CALL    exchange
                MOV     command,    2
                CALL    exchange
                POLLPAT :wc
    if(!C)      ADD     failures,   1
                POLLPAT :wcz
    if(C)       ADD     failures,   1
    if(Z)       ADD     failures,   1
                // A delayed, held match wakes WAITPAT while the receiving cog is stalled.
                MOV     command,    3
                WRLONG  command,    PTRA
                GETCT   timer
                ADD     timer,      aug(4096)
                SETQ    timer
                WAITPAT :wcz
    if(C)       ADD     failures,   1
    if(Z)       ADD     failures,   1
                CALL    await_ack
                POLLPAT :wc
    if(C)       ADD     failures,   1
                // Generate another latch, then verify that SETPAT clears it.
                MOV     command,    2
                CALL    exchange
                MOV     command,    1
                CALL    exchange
                MODCZ   _CLR,       _SET            :wcz
                SETPAT  0,          1
                POLLPAT :wcz
    if(C)       ADD     failures,   1
    if(Z)       ADD     failures,   1
                GETCT   timer
                ADD     timer,      128
                SETQ    timer
                WAITPAT :wcz
    if(!C)      ADD     failures,   1
    if(!Z)      ADD     failures,   1
                // S is not masked: a high S bit makes equality impossible despite changing low inputs.
                MODCZ   {{ modcz_3_operand }}, _SET :wcz
                SETPAT  15, {{ setpat_operand }}
                MOV     command,    2
                CALL    exchange
                MOV     command,    1
                CALL    exchange
                POLLPAT :wc
    if(C)       ADD     failures,   1
                // An always-true mismatch also has no edges when S has unmasked high bits.
                MODCZ   {{ modcz_3_operand }}, _CLR :wcz
                SETPAT  15, {{ setpat_operand }}
                MOV     command,    2
                CALL    exchange
                MOV     command,    1
                CALL    exchange
                POLLPAT :wc
    if(C)       ADD     failures,   1
                // Reconfiguring false to always true establishes a baseline without a PAT edge.
                MODCZ   _SET,       _SET            :wcz
                SETPAT  0,          1
                WAITX   64
                SETPAT  0,          0
                MOV     command,    2
                CALL    exchange
                MOV     command,    1
                CALL    exchange
                POLLPAT :wc
    if(C)       ADD     failures,   1
                // Disable matching and stop the helper before the snapshot reporter runs.
                MODCZ   _SET,       _SET            :wcz
                SETPAT  0,          1
                MOV     command,    4
                CALL    exchange
                SETQ    0
                MODCZ   _CLR,       _CLR            :wcz
                JMP     nrel(_end)
// Send a new command and await its settled-level acknowledgment.
exchange:
                WRLONG  command,    PTRA
// Wait for the writer to finish the current command.
await_ack:
                RDLONG  ack,    PTRB
                CMP     ack,    command :wz
    if(!Z)      JMP     await_ack
                RET
var image:      LONG    0
var mask:       LONG    15
var comparison: LONG    0
var expected:   LONG    0
var observed:   LONG    0
var command:    LONG    0
var ack:        LONG    0
var saved_c:    LONG    0
var saved_z:    LONG    0
var timer:      LONG    0
var failures:   LONG    0
.data
mailbox:        LONG    [0, 0]
.cogexec    0x4000, 0
writer:
                MOV     register(402),  PTRA
                ADD     register(402),  4
                MOV     register(401),  0
writer_wait:
                RDLONG  register(400),  PTRA
                CMP     register(400),  register(401)   :wz
    if(Z)       JMP     writer_wait
                MOV     register(401),  register(400)
                CMP     register(400),  4               :wz
    if(Z)       JMP     writer_stop
                CMP     register(400),  3               :wz
    if(Z)       WAITX   aug(1024)
                // Drive only pins 0..3 and 32..35, leaving the UART pins alone.
                MOV     OUTA,           5
                MOV     OUTB,           10
                CMP     register(400),  2               :wz
    if(Z)       XOR     {{ xor_2_operand }}, 1
                CMP     register(400),  5               :wz
    if(Z)       XOR     {{ xor_2_operand }}, 2
                MOV     DIRA,           15
                MOV     DIRB,           15
                WAITX   64
                WRLONG  register(400),  register(402)
                JMP     writer_wait
writer_stop:
                WRLONG  register(400),  register(402)
                COGSTOP probe_writer

