//? WINDTUNNEL CHECK LIST
//? post: cog[*].reg[observed] == 1
//? macro: source required
//? macro: source_2 required
//? macro: xinit default
//?
//? run: "cog 0 event 10"
//? macro: source set XINIT aug(X_IMM_1X32_4DAC8 | 4), 0
//? macro: source_2 set XCONT aug(X_IMM_1X32_4DAC8 | 16), 0
//? cog: 0
//? const: source = 10
//?
//? run: "cog 0 event 11"
//? macro: source set XINIT aug(X_IMM_1X32_4DAC8 | 1), 0
//? macro: source_2 set
//? cog: 0
//? const: source = 11
//?
//? run: "cog 0 event 12"
//? macro: source set XINIT aug(X_IMM_1X32_4DAC8 | 1), 0
//? macro: source_2 set
//? cog: 0
//? const: source = 12
//?
//? run: "cog 0 event 13"
//? macro: source set SETXFRQ 0
//? macro: source_2 set WRLUT 0, aug(0x1ff)
//? macro: xinit override XINIT aug(X_IMM_4X8_LUT | (15 << 16) | 0xffff), 31
//? cog: 0
//? const: source = 13
//?
//? run: "cog 7 event 10"
//? macro: source set XINIT aug(X_IMM_1X32_4DAC8 | 4), 0
//? macro: source_2 set XCONT aug(X_IMM_1X32_4DAC8 | 16), 0
//? cog: 7
//? const: source = 10
//?
//? run: "cog 7 event 11"
//? macro: source set XINIT aug(X_IMM_1X32_4DAC8 | 1), 0
//? macro: source_2 set
//? cog: 7
//? const: source = 11
//?
//? run: "cog 7 event 12"
//? macro: source set XINIT aug(X_IMM_1X32_4DAC8 | 1), 0
//? macro: source_2 set
//? cog: 7
//? const: source = 12
//?
//? run: "cog 7 event 13"
//? macro: source set SETXFRQ 0
//? macro: source_2 set WRLUT 0, aug(0x1ff)
//? macro: xinit override XINIT aug(X_IMM_4X8_LUT | (15 << 16) | 0xffff), 31
//? cog: 7
//? const: source = 13

                // Every streamer event can drive the ordinary interrupt controller.
                STALLI
                MOV     IJMP1,                                      vector
                SETINT1 source
                ALLOWI
                SETXFRQ aug(0x08000000)
                {{ source }}
                {{ source_2 }}
                {{ xinit }}
                WAITX   aug(400)
                NOP
                NOP
                NOP
                NOP
                NOP
                NOP
                NOP
                NOP
                STALLI
                SETINT1 0
                XSTOP
                MODCZ   _CLR,                                       _CLR        :wcz
                JMP     nrel(_end)
isr:
                ADD     observed,   1
                // The streamer continues clocking during this interrupt handler.
                WAITX   20
                RETI1
var vector:     LONG    pcaddr(isr)
var observed:   LONG    0

