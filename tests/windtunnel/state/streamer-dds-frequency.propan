// Drive a fixed digital input while a ramp table exposes every live NCO phase change.

                HUBSET  aug(0x01000098)
                WAITX   aug(300000)
                HUBSET  aug(0x0100009b)
                DRVH    0
                MOV     index,  0
                MOV     value,  0
// Fill both signed Goertzel coefficient bytes from the LUT index.
fill_table:
                WRLUT   value,                          index
                ADD     value,                          aug(0x01010000)
                ADD     index,                          1
                CMP     index,                          aug(512)        :wz
    if(!Z)      JMP     fill_table
                MOV     new_frequency,                  aug(after)
                SETQ    aug(before)
                XINIT   aug(0xf007ffff | (sinc << 23)), aug(0x1000)
                WAITX   16
                // Change frequency without resetting the accumulated phase.
                SETXFRQ new_frequency
                GETXACC r0
                MOV     r1,                             0
                WAITX   16
                GETXACC r2
                MOV     r3,                             0
                XSTOP
                GETXACC r4
                MOV     r5,                             0
                HUBSET  0xf0
                WAITX   aug(50000)
                DIRL    0
                JMP     nrel(_end)
var index:      LONG    0
var value:      LONG    0
var new_frequency:
                LONG    0
var r0:         LONG    0
var r1:         LONG    0
var r2:         LONG    0
var r3:         LONG    0
var r4:         LONG    0
var r5:         LONG    0

