//? cog: 7
//? const: mode = 2
//? const: kind = 3

                // Compare instruction timing in each execution domain, including EXECF from hub to LUT.
                SETQ2   127
                RDLONG  register(0),    aug(hubaddr(lut_block))
                JMP     target
checked:
                SUB     finish,     start
                CMP     value, {{ cmp_operand }} :wz
    if(!Z)      ADD     failures,   1
                CMP     finish, {{ cmp_2_operand }} :wz
    if(!Z)      ADD     failures,   1
                JMP     nrel(_end)
var target:     LONG    pcaddr(probe)
var exec_target:
                LONG    pcaddr(payload) | (255 << 10)
var start:      LONG    0
var finish:     LONG    0
var value:      LONG    0
var failures:   LONG    0

.lutexec    0x3000, 0x200
lut_block:
.if mode == 0
.cogexec    0x440, 0x100
.elif mode == 1
.lutexec    0x3000, 0x200
.else
.hubexec    0x4000
.endif
probe:
                GETCT   start
                {{ selected_kind }}
                {{ add }}
                {{ add }}
.if kind != 0
                ADD     value,  1
                ADD     value,  1
                ADD     value,  1
                ADD     value,  1
                ADD     value,  1
                ADD     value,  1
                ADD     value,  1
                ADD     value,  1
                ADD     value,  1
                ADD     value,  1
.endif
                GETCT   finish
                JMP     nrel(checked)
                NOP
.lutexec    0x3100, 0x240
payload:
                ADD     value,  1
                ADD     value,  1
                ADD     value,  1
                ADD     value,  1
                ADD     value,  1
                ADD     value,  1
                ADD     value,  1
                ADD     value,  1
                ADD     value,  1
                ADD     value,  1
                GETCT   finish
                JMP     nrel(checked)
                NOP
