//? WINDTUNNEL CHECK LIST
//? macro: setq required
//? macro: crcnib default
//? macro: coginit_operand required
//?
//? run: "SETQ direct"
//? macro: setq set SETQ
//? macro: coginit_operand set address
//? post: cog[0].reg[measured] == 3
//? post: hub[parameter] == u32 [3]
//?
//? run: "SETQ2 direct"
//? macro: setq set SETQ2
//? macro: coginit_operand set address
//? post: cog[0].reg[measured] == 3
//? post: hub[parameter] == u32 [3]
//?
//? run: "SETQ augmented"
//? macro: setq set SETQ
//? macro: coginit_operand set aug(hubaddr(worker))
//? post: cog[0].reg[measured] == 3
//? post: hub[parameter] == u32 [3]
//?
//? run: "SETQ2 augmented"
//? macro: setq set SETQ2
//? macro: coginit_operand set aug(hubaddr(worker))
//? post: cog[0].reg[measured] == 0
//? post: hub[parameter] == u32 [0]
//?
//? run: "CRCNIB direct"
//? macro: setq set SETQ
//? macro: crcnib override CRCNIB measured, measured
//? macro: coginit_operand set address
//? post: cog[0].reg[measured] == 48
//? post: hub[parameter] == u32 [48]

                // COGINIT passes Q as it stands after the earlier decode clear.
                MOV     address,    aug(hubaddr(worker))
                {{ setq }}  3
                {{ crcnib }}
                COGINIT 7, {{ coginit_operand }}
                MOV     measured,   0
                MUXQ    measured,   aug(0xffffffff)
                // Allow image loading and the worker's parameter write to finish.
                WAITX   aug(1000)
                JMP     nrel(_end)
var measured:   LONG    0
var address:    LONG    0
.data
parameter:      LONG    0xffffffff
.cogexec    0x4000
worker:
                // Publish the startup parameter before stopping the worker.
                WRLONG  PTRA,   aug(hubaddr(parameter))
                COGSTOP 7

