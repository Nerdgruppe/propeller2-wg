//? WINDTUNNEL CHECK LIST
//? timeout-ms: 1000
//? max-cycles: 500000
//? run: "pll0-a0-b0"
//? const: pll = 0
//? const: a = 0
//? const: b = 0
//? post: cog[*].reg[initial] == 0x31c6318e
//? post: cog[*].reg[first_result] == 0x00070007
//? post: cog[*].reg[first_ready] == 0x00000001
//? post: cog[*].reg[recovery] == 0xe318c718
//? post: cog[*].reg[second_result] == 0x00070007
//? run: "pll0-a0-b1"
//? const: pll = 0
//? const: a = 0
//? const: b = 1
//? post: cog[*].reg[initial] == 0x00000000
