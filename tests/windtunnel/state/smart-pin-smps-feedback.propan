//? post: cog[*].reg[second_result] == 0x00070007
//? run: "pll0-a1-b1"
//? const: pll = 0
//? const: a = 1
//? const: b = 1
//? post: cog[*].reg[initial] == 0x00000000
//? post: cog[*].reg[first_result] == 0x00000000
//? post: cog[*].reg[first_ready] == 0x00000000
//? post: cog[*].reg[recovery] == 0x8c718c63
//? post: cog[*].reg[second_result] == 0x00070007
//? run: "pll1-a0-b0"
//? const: pll = 1
//? const: a = 0
//? const: b = 0
//? post: cog[*].reg[initial] == 0x38c631c6
//? post: cog[*].reg[first_result] == 0x00070007
//? post: cog[*].reg[first_ready] == 0x00000001
//? post: cog[*].reg[recovery] == 0x6318e318
//? post: cog[*].reg[second_result] == 0x00070007
//? run: "pll1-a0-b1"
//? const: pll = 1
//? const: a = 0
//? const: b = 1
//? post: cog[*].reg[initial] == 0x00000000
//? post: cog[*].reg[first_result] == 0x00070007
//? post: cog[*].reg[first_ready] == 0x00000001
//? post: cog[*].reg[recovery] == 0x6318e318
//? post: cog[*].reg[second_result] == 0x00070007
//? run: "pll1-a1-b0"
//? const: pll = 1
//? const: a = 1
//? const: b = 0
//? post: cog[*].reg[initial] == 0x38000000
//? post: cog[*].reg[first_result] == 0x00000000
//? post: cog[*].reg[first_ready] == 0x00000000
//? post: cog[*].reg[recovery] == 0x8e318c71
//? post: cog[*].reg[second_result] == 0x00070007
//? run: "pll1-a1-b1"
//? const: pll = 1
//? const: a = 1
//? const: b = 1
//? post: cog[*].reg[initial] == 0x00000000
//? post: cog[*].reg[first_result] == 0x00000000
//? post: cog[*].reg[first_ready] == 0x00000000
//? post: cog[*].reg[recovery] == 0x8e318c71
//? post: cog[*].reg[second_result] == 0x00070007

// Select the test clock while retaining the ROM-calibrated UART divider for reporting.
.if pll
                HUBSET  aug(0x010009f8)
                WAITX   aug(200000)
                HUBSET  aug(0x010009fb)
                WAITX   64
.endif

                // Establish feedback before enabling SMPS; capture initial gating and recovery from either source.
                DRVL    3
                DRVL    5
                MOV     OUTA,                                   ((a << 3) | (b << 5))
                WRPIN   aug(0x71000000 | P_TT_01 | (10 << 1)),  4
                WRPIN   aug(0x60000000),                        6
                WXPIN   aug((7 << 16) | 3),                     4
                WYPIN   3,                                      4
                WAITX   32
                DIRH    4
                TESTP   6                                                               :wc
                RCL     initial,                                1
                TESTP   6                                                               :wc
                RCL     initial,                                1
                TESTP   6                                                               :wc
                RCL     initial,                                1
                TESTP   6                                                               :wc
                RCL     initial,                                1
                TESTP   6                                                               :wc
                RCL     initial,                                1
                TESTP   6                                                               :wc
                RCL     initial,                                1
                TESTP   6                                                               :wc
                RCL     initial,                                1
                TESTP   6                                                               :wc
                RCL     initial,                                1
                TESTP   6                                                               :wc
                RCL     initial,                                1
                TESTP   6                                                               :wc
                RCL     initial,                                1
                TESTP   6                                                               :wc
                RCL     initial,                                1
                TESTP   6                                                               :wc
                RCL     initial,                                1
                TESTP   6                                                               :wc
                RCL     initial,                                1
                TESTP   6                                                               :wc
                RCL     initial,                                1
                TESTP   6                                                               :wc
                RCL     initial,                                1
                TESTP   6                                                               :wc
                RCL     initial,                                1
                TESTP   6                                                               :wc
                RCL     initial,                                1
                TESTP   6                                                               :wc
                RCL     initial,                                1
                TESTP   6                                                               :wc
                RCL     initial,                                1
                TESTP   6                                                               :wc
                RCL     initial,                                1
                TESTP   6                                                               :wc
                RCL     initial,                                1
                TESTP   6                                                               :wc
                RCL     initial,                                1
                TESTP   6                                                               :wc
                RCL     initial,                                1
                TESTP   6                                                               :wc
                RCL     initial,                                1
                TESTP   6                                                               :wc
                RCL     initial,                                1
                TESTP   6                                                               :wc
                RCL     initial,                                1
                TESTP   6                                                               :wc
                RCL     initial,                                1
                TESTP   6                                                               :wc
                RCL     initial,                                1
                TESTP   6                                                               :wc
                RCL     initial,                                1
                TESTP   6                                                               :wc
                RCL     initial,                                1
                TESTP   6                                                               :wc
                RCL     initial,                                1
                TESTP   6                                                               :wc
                RCL     initial,                                1

                RQPIN   first_result,                           4
                TESTP   4                                                               :wc
                WRC     first_ready
                MOV     OUTA,                                   0
                WAITX   16
                TESTP   6                                                               :wc
                RCL     recovery,                               1
                TESTP   6                                                               :wc
                RCL     recovery,                               1
                TESTP   6                                                               :wc
                RCL     recovery,                               1
                TESTP   6                                                               :wc
                RCL     recovery,                               1
                TESTP   6                                                               :wc
                RCL     recovery,                               1
                TESTP   6                                                               :wc
                RCL     recovery,                               1
                TESTP   6                                                               :wc
                RCL     recovery,                               1
                TESTP   6                                                               :wc
                RCL     recovery,                               1
                TESTP   6                                                               :wc
                RCL     recovery,                               1
                TESTP   6                                                               :wc
                RCL     recovery,                               1
                TESTP   6                                                               :wc
                RCL     recovery,                               1
                TESTP   6                                                               :wc
                RCL     recovery,                               1
                TESTP   6                                                               :wc
                RCL     recovery,                               1
                TESTP   6                                                               :wc
                RCL     recovery,                               1
                TESTP   6                                                               :wc
                RCL     recovery,                               1
                TESTP   6                                                               :wc
                RCL     recovery,                               1
                TESTP   6                                                               :wc
                RCL     recovery,                               1
                TESTP   6                                                               :wc
                RCL     recovery,                               1
                TESTP   6                                                               :wc
                RCL     recovery,                               1
                TESTP   6                                                               :wc
                RCL     recovery,                               1
                TESTP   6                                                               :wc
                RCL     recovery,                               1
                TESTP   6                                                               :wc
                RCL     recovery,                               1
                TESTP   6                                                               :wc
                RCL     recovery,                               1
                TESTP   6                                                               :wc
                RCL     recovery,                               1
                TESTP   6                                                               :wc
                RCL     recovery,                               1
                TESTP   6                                                               :wc
                RCL     recovery,                               1
                TESTP   6                                                               :wc
                RCL     recovery,                               1
                TESTP   6                                                               :wc
                RCL     recovery,                               1
                TESTP   6                                                               :wc
                RCL     recovery,                               1
                TESTP   6                                                               :wc
                RCL     recovery,                               1
                TESTP   6                                                               :wc
                RCL     recovery,                               1
                TESTP   6                                                               :wc
                RCL     recovery,                               1

                RQPIN   second_result,                          4
                DIRL    4
                DIRL    3
                DIRL    5

                // Restore RCFAST before the shared reporter uses the ROM-calibrated UART.
                HUBSET  0xF0
                WAITX   64
                JMP     nrel(_end)

var initial:    LONG    0
var first_result:
                LONG    0
var first_ready:
                LONG    0
var recovery:   LONG    0
var second_result:
                LONG    0

