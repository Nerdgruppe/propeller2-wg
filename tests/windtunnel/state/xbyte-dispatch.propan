                // Encode each LUT address in a high skip-pattern field, leaving the handler unskipped.
                MOV     index,  0
fill:
                MOV     entry,  index
                SHL     entry,  23
                OR      entry,  nrel(handler)
                WRLUT   entry,  index
                ADD     index,  1
                CMP     index,  aug(512)                :wz
    if(!Z)      JMP     fill
                RDFAST  0,      aug(hubaddr(bytecodes))
                PUSH    aug(0x12345)
                PUSH    0x1ff
                MODCZ   _CLR,   _CLR                    :wcz
                GETCT   start
    return      SETQ    mode
                // Trailing code must be canceled by the phantom return.
                ADD     flags,  16
handler:
                GETCT   elapsed
                MUXC    flags,      1
                MUXZ    flags,      2
                GETBRK  pattern_out                 :wz
                SKIPF   0
                GETBRK  status                      :wc
                MOV     pa_out,     PA
                MOV     pb_out,     PB
                MOV     q_out,      0
                MUXQ    q_out,      all_bits
                POP     stack_out
                SUB     elapsed,    start
                AND     status,     aug(0xffff0000)
                JMP     nrel(_end)
var index:      LONG    0
var entry:      LONG    0
var pattern_out:
                LONG    0
var status:     LONG    0
var flags:      LONG    0
var pa_out:     LONG    0
var pb_out:     LONG    0
var elapsed:    LONG    0
var start:      LONG    0
var q_out:      LONG    0
var stack_out:  LONG    0
var all_bits:   LONG    0xffffffff
.hubexec    0x4000
bytecodes:      BYTE    0xd7,   0x39,   0xa2,   0

