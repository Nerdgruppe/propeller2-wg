//? const: period = 524288
//? const: phase = 0
//? post: cog[*].reg[wave0] == 0xcff3fcf0
//? post: cog[*].reg[wave1] == 0xff333c30
//? post: cog[*].reg[wave2] == 0x3fffffff
//? post: cog[*].reg[result] == 0x89abcdef
//? post: cog[*].reg[carry] == 0x00000001
//? post: cog[*].reg[ready] == 0x00000001
//? post: cog[*].reg[tx_result] == 0xc4d5e6f7
//? post: cog[*].reg[busy] == 0x00000000

// Select the test clock while retaining the ROM-calibrated UART divider for reporting.
.if pll
                HUBSET  aug(0x010009f8)
                WAITX   aug(200000)
                HUBSET  aug(0x010009fb)
                WAITX   64
.endif
                // Initialize a UART loopback through physical routed pads, without endpoint injection.
                WRPIN   P_TT_01 | P_ASYNC_TX,           4
                WRPIN   aug(0x70000000 | P_ASYNC_RX),   5
                WRPIN   aug(0x60000000),                6
                WXPIN   aug(period | (bits - 1)),       4
                WXPIN   aug(period | (bits - 1)),       5
                DIRH    4
                DIRH    5
                WAITX   32
                WAITX   phase
                WYPIN   aug(0x89abcdef),                4

                // Observe 128 clocks of the transmitted physical level.
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1
                TESTP   6                                                   :wc
                RCL     wave0,                          1

                // Observe 128 clocks of the transmitted physical level.
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1
                TESTP   6                                                   :wc
                RCL     wave1,                          1

                // Observe 128 clocks of the transmitted physical level.
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1
                TESTP   6                                                   :wc
                RCL     wave2,                          1

                // Read completion, modal carry and result, then release pins.
                RQPIN   result,                         5                   :wc
                WRC     carry
                TESTP   5                                                   :wc
                WRC     ready
                RQPIN   tx_result,                      4                   :wc
                WRC     busy
                DIRL    4
                DIRL    5


                // TT-enabled smart outputs still drive in reset; restore GPIO before reporting.
                DIRL    aug(0 | (7 << 6))
                WRPIN   0,                              aug(0 | (7 << 6))

                // Restore RCFAST before the shared reporter uses the ROM-calibrated UART.
                HUBSET  0xF0
                WAITX   64
                JMP     nrel(_end)

var wave0:      LONG    0
var wave1:      LONG    0
var wave2:      LONG    0
