//? post: cog[*].reg[wave2] == 0x03f87330
//? post: cog[*].reg[wave3] == 0x6703183f
//? post: cog[*].reg[result] == 0x891a2b3c
//? post: cog[*].reg[busy] == 0x00000000
//? post: cog[*].reg[ready] == 0x00000001

// Use nominal 20 MHz RCFAST and retain the ROM-calibrated UART divider.

                // Queue two UART words without waiting for the first stop bit; preserve fractional phase across them.
                WRPIN   P_TT_01 | P_ASYNC_TX,       4
                WRPIN   aug(0x60000000),            6
                WXPIN   aug(period | (bits - 1)),   4
                DIRH    4
                WAITX   32
                WYPIN   aug(0x89abcdef),            4
                WYPIN   aug(0x12345678),            4

                // Observe 128 clocks, including the buffer handoff and final stop level.
                TESTP   6                                               :wc
                RCL     wave0,                      1
                TESTP   6                                               :wc
                RCL     wave0,                      1
                TESTP   6                                               :wc
                RCL     wave0,                      1
                TESTP   6                                               :wc
                RCL     wave0,                      1
                TESTP   6                                               :wc
                RCL     wave0,                      1
                TESTP   6                                               :wc
                RCL     wave0,                      1
                TESTP   6                                               :wc
                RCL     wave0,                      1
                TESTP   6                                               :wc
                RCL     wave0,                      1
                TESTP   6                                               :wc
                RCL     wave0,                      1
                TESTP   6                                               :wc
                RCL     wave0,                      1
                TESTP   6                                               :wc
                RCL     wave0,                      1
                TESTP   6                                               :wc
                RCL     wave0,                      1
                TESTP   6                                               :wc
                RCL     wave0,                      1
                TESTP   6                                               :wc
                RCL     wave0,                      1
                TESTP   6                                               :wc
                RCL     wave0,                      1
                TESTP   6                                               :wc
                RCL     wave0,                      1
                TESTP   6                                               :wc
                RCL     wave0,                      1
                TESTP   6                                               :wc
                RCL     wave0,                      1
                TESTP   6                                               :wc
                RCL     wave0,                      1
                TESTP   6                                               :wc
                RCL     wave0,                      1
                TESTP   6                                               :wc
                RCL     wave0,                      1
                TESTP   6                                               :wc
                RCL     wave0,                      1
                TESTP   6                                               :wc
                RCL     wave0,                      1
                TESTP   6                                               :wc
                RCL     wave0,                      1
                TESTP   6                                               :wc
                RCL     wave0,                      1
                TESTP   6                                               :wc
                RCL     wave0,                      1
                TESTP   6                                               :wc
                RCL     wave0,                      1
                TESTP   6                                               :wc
                RCL     wave0,                      1
                TESTP   6                                               :wc
                RCL     wave0,                      1
                TESTP   6                                               :wc
                RCL     wave0,                      1
                TESTP   6                                               :wc
                RCL     wave0,                      1
                TESTP   6                                               :wc
                RCL     wave0,                      1

                // Observe 128 clocks, including the buffer handoff and final stop level.
                TESTP   6                                               :wc
                RCL     wave1,                      1
                TESTP   6                                               :wc
                RCL     wave1,                      1
                TESTP   6                                               :wc
                RCL     wave1,                      1
                TESTP   6                                               :wc
                RCL     wave1,                      1
                TESTP   6                                               :wc
                RCL     wave1,                      1
                TESTP   6                                               :wc
                RCL     wave1,                      1
                TESTP   6                                               :wc
                RCL     wave1,                      1
                TESTP   6                                               :wc
                RCL     wave1,                      1
                TESTP   6                                               :wc
                RCL     wave1,                      1
                TESTP   6                                               :wc
                RCL     wave1,                      1
                TESTP   6                                               :wc
                RCL     wave1,                      1
                TESTP   6                                               :wc
                RCL     wave1,                      1
                TESTP   6                                               :wc
                RCL     wave1,                      1
                TESTP   6                                               :wc
                RCL     wave1,                      1
                TESTP   6                                               :wc
                RCL     wave1,                      1
                TESTP   6                                               :wc
                RCL     wave1,                      1
                TESTP   6                                               :wc
                RCL     wave1,                      1
                TESTP   6                                               :wc
                RCL     wave1,                      1
                TESTP   6                                               :wc
                RCL     wave1,                      1
                TESTP   6                                               :wc
                RCL     wave1,                      1
                TESTP   6                                               :wc
                RCL     wave1,                      1
                TESTP   6                                               :wc
                RCL     wave1,                      1
                TESTP   6                                               :wc
                RCL     wave1,                      1
                TESTP   6                                               :wc
                RCL     wave1,                      1
                TESTP   6                                               :wc
                RCL     wave1,                      1
                TESTP   6                                               :wc
                RCL     wave1,                      1
                TESTP   6                                               :wc
                RCL     wave1,                      1
                TESTP   6                                               :wc
                RCL     wave1,                      1
                TESTP   6                                               :wc
                RCL     wave1,                      1
                TESTP   6                                               :wc
                RCL     wave1,                      1
                TESTP   6                                               :wc
                RCL     wave1,                      1
                TESTP   6                                               :wc
                RCL     wave1,                      1

                // Observe 128 clocks, including the buffer handoff and final stop level.
                TESTP   6                                               :wc
                RCL     wave2,                      1
                TESTP   6                                               :wc
                RCL     wave2,                      1
                TESTP   6                                               :wc
                RCL     wave2,                      1
                TESTP   6                                               :wc
                RCL     wave2,                      1
                TESTP   6                                               :wc
                RCL     wave2,                      1
                TESTP   6                                               :wc
                RCL     wave2,                      1
                TESTP   6                                               :wc
                RCL     wave2,                      1
                TESTP   6                                               :wc
                RCL     wave2,                      1
                TESTP   6                                               :wc
                RCL     wave2,                      1
                TESTP   6                                               :wc
                RCL     wave2,                      1
                TESTP   6                                               :wc
                RCL     wave2,                      1
                TESTP   6                                               :wc
                RCL     wave2,                      1
                TESTP   6                                               :wc
                RCL     wave2,                      1
                TESTP   6                                               :wc
                RCL     wave2,                      1
                TESTP   6                                               :wc
                RCL     wave2,                      1
                TESTP   6                                               :wc
                RCL     wave2,                      1
                TESTP   6                                               :wc
                RCL     wave2,                      1
                TESTP   6                                               :wc
                RCL     wave2,                      1
                TESTP   6                                               :wc
                RCL     wave2,                      1
                TESTP   6                                               :wc
                RCL     wave2,                      1
                TESTP   6                                               :wc
                RCL     wave2,                      1
                TESTP   6                                               :wc
                RCL     wave2,                      1
                TESTP   6                                               :wc
                RCL     wave2,                      1
                TESTP   6                                               :wc
                RCL     wave2,                      1
                TESTP   6                                               :wc
                RCL     wave2,                      1
                TESTP   6                                               :wc
                RCL     wave2,                      1
                TESTP   6                                               :wc
                RCL     wave2,                      1
                TESTP   6                                               :wc
                RCL     wave2,                      1
                TESTP   6                                               :wc
                RCL     wave2,                      1
                TESTP   6                                               :wc
                RCL     wave2,                      1
                TESTP   6                                               :wc
                RCL     wave2,                      1
                TESTP   6                                               :wc
                RCL     wave2,                      1

                // Observe 128 clocks, including the buffer handoff and final stop level.
                TESTP   6                                               :wc
                RCL     wave3,                      1
                TESTP   6                                               :wc
                RCL     wave3,                      1
                TESTP   6                                               :wc
                RCL     wave3,                      1
                TESTP   6                                               :wc
                RCL     wave3,                      1
                TESTP   6                                               :wc
                RCL     wave3,                      1
                TESTP   6                                               :wc
                RCL     wave3,                      1
                TESTP   6                                               :wc
                RCL     wave3,                      1
                TESTP   6                                               :wc
                RCL     wave3,                      1
                TESTP   6                                               :wc
                RCL     wave3,                      1
                TESTP   6                                               :wc
                RCL     wave3,                      1
                TESTP   6                                               :wc
                RCL     wave3,                      1
                TESTP   6                                               :wc
                RCL     wave3,                      1
                TESTP   6                                               :wc
                RCL     wave3,                      1
                TESTP   6                                               :wc
                RCL     wave3,                      1
                TESTP   6                                               :wc
                RCL     wave3,                      1
                TESTP   6                                               :wc
                RCL     wave3,                      1
                TESTP   6                                               :wc
                RCL     wave3,                      1
                TESTP   6                                               :wc
                RCL     wave3,                      1
                TESTP   6                                               :wc
                RCL     wave3,                      1
                TESTP   6                                               :wc
                RCL     wave3,                      1
                TESTP   6                                               :wc
                RCL     wave3,                      1
                TESTP   6                                               :wc
                RCL     wave3,                      1
                TESTP   6                                               :wc
                RCL     wave3,                      1
                TESTP   6                                               :wc
                RCL     wave3,                      1
                TESTP   6                                               :wc
                RCL     wave3,                      1
                TESTP   6                                               :wc
                RCL     wave3,                      1
                TESTP   6                                               :wc
                RCL     wave3,                      1
                TESTP   6                                               :wc
                RCL     wave3,                      1
                TESTP   6                                               :wc
                RCL     wave3,                      1
                TESTP   6                                               :wc
                RCL     wave3,                      1
                TESTP   6                                               :wc
                RCL     wave3,                      1
                TESTP   6                                               :wc
                RCL     wave3,                      1

                RQPIN   result,                     4                   :wc
                WRC     busy
                TESTP   4                                               :wc
                WRC     ready
                DIRL    4

                // TT-enabled smart outputs still drive in reset; restore GPIO before reporting.
                DIRL    aug(0 | (7 << 6))
                WRPIN   0,                          aug(0 | (7 << 6))

                // Restore RCFAST before the shared reporter uses the ROM-calibrated UART.
                HUBSET  0xF0
                WAITX   64
                JMP     nrel(_end)

var wave0:      LONG    0
var wave1:      LONG    0
var wave2:      LONG    0
var wave3:      LONG    0
var result:     LONG    0
var busy:       LONG    0
var ready:      LONG    0

