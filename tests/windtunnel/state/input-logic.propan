                // Independent selectors produce all four A/B combinations from a driven low pad.
                DRVL    8
                WRPIN   aug((a << 31) | (b << 27) | (logic << 21)), 8
                WAITX   32
                TESTP   8                                               :wc
                WRC     result
                JMP     nrel(_end)
var result:     LONG    0
