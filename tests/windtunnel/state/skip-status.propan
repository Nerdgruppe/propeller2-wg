// Probe empty patterns, return underflow and installation while suspended.
.if kind == 1
                PUSH    nrel(done)
.endif
.if fast
                SKIPF   bits
.else
                SKIP    bits
.endif
.if kind == 0
                CALL    nrel(sub)
.elif   kind == 1
                RET
.elif   kind == 2
                GETBRK  a               :wc
                WRC     cflag
                GETBRK  b               :wz
                WRZ     zflag
.else
                CALL    nrel(reset_sub)
.endif
                NOP
                NOP
                NOP
                NOP
done:
                GETBRK  after                   :wc
                GETBRK  after_pattern           :wz
                AND     a,      aug(0xF8000000)
                AND     inside, aug(0xF8000000)
                AND     after,  aug(0xF8000000)
                JMP     nrel(_end)
sub:
                GETBRK  inside          :wc
                GETBRK  inside_pattern  :wz
                RET
reset_sub:
                SKIP    0
                GETBRK  inside          :wc
                GETBRK  inside_pattern  :wz
                RET
var a:          LONG    0
var b:          LONG    0
var cflag:      LONG    0
var zflag:      LONG    0
var inside:     LONG    0
var inside_pattern:
                LONG    0
var after:      LONG    0
var after_pattern:
                LONG    0
var value:      LONG    0

