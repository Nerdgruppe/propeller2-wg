//? WINDTUNNEL CHECK LIST
//? timeout-ms: 1000
//? post: cog[*].reg[failures] == 0
//? run: "int1-cog0-kind0"
//? cog: 0
//? const: irq_level = 1
//? const: kind = 0
//? run: "int1-cog0-kind1"
//? cog: 0
//? const: irq_level = 1
//? const: kind = 1
//? run: "int1-cog0-kind2"
//? cog: 0
//? const: irq_level = 1
//? const: kind = 2
//? run: "int1-cog7-kind0"
//? cog: 7
//? const: irq_level = 1
//? const: kind = 0
//? run: "int1-cog7-kind1"
//? cog: 7
//? const: irq_level = 1
//? const: kind = 1
//? run: "int1-cog7-kind2"
//? cog: 7
//? const: irq_level = 1
//? const: kind = 2
//? run: "int2-cog0-kind0"
//? cog: 0
//? const: irq_level = 2
//? const: kind = 0
//? run: "int2-cog0-kind1"
//? cog: 0
//? const: irq_level = 2
//? const: kind = 1
//? run: "int2-cog0-kind2"
//? cog: 0
//? const: irq_level = 2
//? const: kind = 2
//? run: "int2-cog7-kind0"
//? cog: 7
//? const: irq_level = 2
//? const: kind = 0
//? run: "int2-cog7-kind1"
//? cog: 7
//? const: irq_level = 2
//? const: kind = 1
//? run: "int2-cog7-kind2"
//? cog: 7
//? const: irq_level = 2
//? const: kind = 2
//? run: "int3-cog0-kind0"
//? cog: 0
//? const: irq_level = 3
//? const: kind = 0
//? run: "int3-cog0-kind1"
//? cog: 0
//? const: irq_level = 3
//? const: kind = 1
//? run: "int3-cog0-kind2"
//? cog: 0
//? const: irq_level = 3
//? const: kind = 2
//? run: "int3-cog7-kind0"
//? cog: 7
//? const: irq_level = 3
//? const: kind = 0
//? run: "int3-cog7-kind1"
//? cog: 7
//? const: irq_level = 3
//? const: kind = 1
//? run: "int3-cog7-kind2"
//? cog: 7
//? const: irq_level = 3
//? const: kind = 2

const vector_reg = register(0x1f6 - 2 * irq_level)

                MOV     vector_reg, vector
                // A latched INT is pollable but does not satisfy WAITINT on this silicon.
.if irq_level == 1
                TRGINT1
.elif   irq_level == 2
                TRGINT2
.else
                TRGINT3
.endif
                NOP
                NOP
                NOP
                MODCZ   _CLR,       _CLR    :wcz
    if(C)       WAITINT
                POLLINT                     :wc
    if(!C)      ADD     failures,   1
.if irq_level == 1
                TRGINT1
.elif   irq_level == 2
                TRGINT2
.else
                TRGINT3
.endif
                NOP
                NOP
                NOP
                GETCT   timeout
                ADD     timeout,    64
                SETQ    timeout
                WAITINT                     :wcz
    if(!C)      ADD     failures,   1
    if(!Z)      ADD     failures,   1
                POLLINT                     :wc
    if(C)       ADD     failures,   1
                MOV     count,      0
                // A new pending request wakes WAITINT even while STALLI holds entry off.
                GETCT   target
                ADD     target,     64
                ADDCT1  target,     0
.if irq_level == 1
                SETINT1 1
.elif   irq_level == 2
                SETINT2 1
.else
                SETINT3 1
.endif
.if kind == 1
                STALLI
.endif
                GETCT   timeout
                ADD     timeout,    128
                GETCT   start
                SETQ    timeout
.if kind == 2
                WAITATN                     :wc
.else
                WAITINT                     :wc
.endif
                GETCT   elapsed
                WRC     timedout
                NOP
                NOP
                NOP
                SUB     elapsed,    start
.if kind == 2
                CMP     timedout,   1       :wz
.else
                CMP     timedout,   0       :wz
.endif
    if(!Z)      ADD     failures,   1
.if kind == 1
                CMP     count,      0       :wz
.else
                CMP     count,      1       :wz
.endif
    if(!Z)      ADD     failures,   1
.if kind != 2
                SUB     target,     start
                ADD     target,     4
                CMP     elapsed,    target  :wz
    if(!Z)      ADD     failures,   1
.endif
                STALLI
.if irq_level == 1
                NIXINT1
.elif   irq_level == 2
                NIXINT2
.else
                NIXINT3
.endif
.if irq_level == 1
                SETINT1 0
.elif   irq_level == 2
                SETINT2 0
.else
                SETINT3 0
.endif
                SETQ    0
                MODCZ   _CLR,       _CLR    :wcz
                JMP     nrel(_end)
isr:
.if irq_level == 1
                SETINT1 0
.elif   irq_level == 2
                SETINT2 0
.else
                SETINT3 0
.endif
                ADD     count,  1
.if irq_level == 1
                RETI1
.elif   irq_level == 2
                RETI2
.else
                RETI3
.endif
var vector:     LONG    pcaddr(isr)
var target:     LONG    0
var timeout:    LONG    0
var start:      LONG    0
var elapsed:    LONG    0
var count:      LONG    0
var timedout:   LONG    0
var failures:   LONG    0

