//? WINDTUNNEL CHECK LIST
//? timeout-ms: 1000
//? post: cog[*].reg[failures] == 0
//? macro: interrupt_level required
//? macro: stalli default
//? macro: wait required
//? macro: cmp_operand required
//? macro: cmp_2_operand required
//? macro: sub required
//? macro: add required
//? macro: cmp_3 required
//? macro: add_2 required
