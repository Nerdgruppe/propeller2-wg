//? macro: interrupt_level set 3
//? macro: stalli override STALLI
//? macro: wait set WAITINT
//? macro: cmp_operand set 0
//? macro: cmp_2_operand set 0
//? macro: sub set SUB target, start
//? macro: add set ADD target, 4
//? macro: cmp_3 set CMP elapsed, target :wz
//? macro: add_2 set if(!Z) ADD failures, 1
//? cog: 0
//? const: irq_level = 3
//?
//? run: "int3-cog0-kind2"
//? macro: interrupt_level set 3
//? macro: wait set WAITATN
//? macro: cmp_operand set 1
//? macro: cmp_2_operand set 1
//? macro: sub set
//? macro: add set
//? macro: cmp_3 set
//? macro: add_2 set
//? cog: 0
//? const: irq_level = 3
//?
//? run: "int3-cog7-kind0"
//? macro: interrupt_level set 3
//? macro: wait set WAITINT
//? macro: cmp_operand set 0
//? macro: cmp_2_operand set 1
//? macro: sub set SUB target, start
//? macro: add set ADD target, 4
//? macro: cmp_3 set CMP elapsed, target :wz
//? macro: add_2 set if(!Z) ADD failures, 1
//? cog: 7
//? const: irq_level = 3
//?
//? run: "int3-cog7-kind1"
//? macro: interrupt_level set 3
//? macro: stalli override STALLI
//? macro: wait set WAITINT
//? macro: cmp_operand set 0
//? macro: cmp_2_operand set 0
//? macro: sub set SUB target, start
//? macro: add set ADD target, 4
//? macro: cmp_3 set CMP elapsed, target :wz
//? macro: add_2 set if(!Z) ADD failures, 1
//? cog: 7
//? const: irq_level = 3
//?
//? run: "int3-cog7-kind2"
//? macro: interrupt_level set 3
//? macro: wait set WAITATN
//? macro: cmp_operand set 1
//? macro: cmp_2_operand set 1
//? macro: sub set
//? macro: add set
//? macro: cmp_3 set
//? macro: add_2 set
//? cog: 7
//? const: irq_level = 3

const vector_reg = register(0x1f6 - 2 * irq_level)

                MOV     vector_reg, vector
                // A latched INT is pollable but does not satisfy WAITINT on this silicon.
                TRGINT{{ interrupt_level }}
                NOP
                NOP
                NOP
                MODCZ   _CLR,       _CLR    :wcz
    if(C)       WAITINT
                POLLINT :wc
    if(!C)      ADD     failures,   1
                TRGINT{{ interrupt_level }}
                NOP
                NOP
                NOP
                GETCT   timeout
                ADD     timeout,    64
                SETQ    timeout
                WAITINT :wcz
    if(!C)      ADD     failures,   1
    if(!Z)      ADD     failures,   1
                POLLINT :wc
    if(C)       ADD     failures,   1
                MOV     count,      0
                // A new pending request wakes WAITINT even while STALLI holds entry off.
                GETCT   target
                ADD     target,     64
                ADDCT1  target,     0
                SETINT{{ interrupt_level }} 1
                {{ stalli }}
                GETCT   timeout
                ADD     timeout,    128
                GETCT   start
                SETQ    timeout
                {{ wait }}  :wc
                GETCT   elapsed
                WRC     timedout
                NOP
                NOP
                NOP
                SUB     elapsed,    start
                CMP     timedout, {{ cmp_operand }} :wz
    if(!Z)      ADD     failures,   1
                CMP     count, {{ cmp_2_operand }} :wz
    if(!Z)      ADD     failures,   1
                {{ sub }}
                {{ add }}
                {{ cmp_3 }}
                {{ add_2 }}
                STALLI
                NIXINT{{ interrupt_level }}
                SETINT{{ interrupt_level }} 0
                SETQ    0
                MODCZ   _CLR,       _CLR    :wcz
                JMP     nrel(_end)
isr:
                SETINT{{ interrupt_level }} 0
                ADD     count,  1
                RETI{{ interrupt_level }}
var vector:     LONG    pcaddr(isr)
var target:     LONG    0
var timeout:    LONG    0
var start:      LONG    0
var elapsed:    LONG    0
var count:      LONG    0
var timedout:   LONG    0
var failures:   LONG    0

