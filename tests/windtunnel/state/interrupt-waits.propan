//? macro: wait set WAITINT
//? macro: cmp_operand set 0
//? macro: cmp_2_operand set 1
//? macro: sub set SUB target, start
//? macro: add set ADD target, 4
//? macro: cmp_3 set CMP elapsed, target :wz
//? macro: add_2 set if(!Z) ADD failures, 1
