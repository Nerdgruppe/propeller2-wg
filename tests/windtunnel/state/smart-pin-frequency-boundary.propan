// Check optimistic GPIO boundaries at RCFAST; electrical limits are summarized in docs/accumulated.md.
// Use nominal 20 MHz RCFAST and retain the ROM-calibrated UART divider.

                // Observe smart-pin/GPIO boundaries at nominal 20 MHz RCFAST.
                HUBSET  0xF0
                WAITX   64
                DRVL    40
                WRPIN   aug(sync << 16),    40
                WRPIN   aug(0x70000000),    41
                WAITX   32
                OUTH    40
.if gap
                WAITX   gap
.endif
                TESTP   41                      :wc
                WRC     rising
                WAITX   32
                OUTL    40
.if gap
                WAITX   gap
.endif
                TESTP   41                      :wc
                WRC     falling
                DIRL    40

                // Restore RCFAST before the shared reporter uses the ROM-calibrated UART.
                HUBSET  0xF0
                WAITX   64
                JMP     nrel(_end)

var rising:     LONG    0
var falling:    LONG    0

