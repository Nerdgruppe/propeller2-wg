//? post: cog[*].reg[elapsed] == 22

                // Branch targets at a repeat boundary use the already-wrapped next PC.
                GETCT   a
                REP     3,      count
                ADD     value,  1
                NOP
                {{ selected_kind }}
                MOV     landed, 1
                JMP     nrel(checked)
                NOP
destination:
                MOV     landed, 2
                JMP     nrel(checked)
callee:
                POP     link
                MOV     landed, 3
                JMP     nrel(checked)
checked:
                GETCT   b
                SUB     link,       body_address
                MOV     elapsed,    b
                SUB     elapsed,    a
                JMP     nrel(_end)
var target:     LONG    pcaddr(destination)
var body_address:
                LONG    pcaddr(_wt_testcode) + 2
var landed:     LONG    0
var value:      LONG    0
var link:       LONG    0
var elapsed:    LONG    0
var a:          LONG    0
var b:          LONG    0
var inside:     LONG    0
var after:      LONG    0
var pattern_out:
                LONG    0

