//? WINDTUNNEL CHECK LIST
//? profile: program
//? stop: _end
//? stdin: hex [00 80 ff]
//? stdin-after: "READY\n"
//? stdout: "READY\n\x00\x80\xff"
//? max-cycles: 1_000_000
//? timeout-ms: 1000
//? baudrate: 2000000

// Exercise a complete UART exchange, including zero and high-bit input bytes.
// The READY marker gates input delivery; buffering all three bytes avoids missing RX while echoing.


.cogexec
                HUBSET  0xF0
                WRPIN   P_TT_01 | P_ASYNC_TX,   62
                DIRH    62
                WRPIN   P_ASYNC_RX,             63
                DIRH    63
                CALLPA  aug(hubaddr(ready)),    write_str
                // Read the complete short packet before echoing, keeping up with RX.
                CALL    read_byte
                MOV     first,                  PA
                CALL    read_byte
                MOV     second,                 PA
                CALL    read_byte
                MOV     third,                  PA
                MOV     PA,                     first
                CALL    write_byte
                MOV     PA,                     second
                CALL    write_byte
                MOV     PA,                     third
                CALL    write_byte
// Finish the final frame before the observable checkpoint.
.flush:         RQPIN   PA,                     62          :wc
    if(C)       JMP     .flush
_end:
                JMP     _end

read_byte:
                TESTP   63          :wc
    if(!C)      JMP     read_byte
                RDPIN   PA, 63
                // The 8-bit smart-pin RX result is left-aligned in the returned long.
                SHR     PA, 24
                RET
write_str:
                RDFAST  0,  PA
.next:          RFBYTE  PA          :wz
    if(!Z)      CALL    write_byte
    return      TJNZ    PA, .next
write_byte:
                WYPIN   PA, 62
                WAITX   1
.wait:          TESTP   62      :wc
    if(!C)      JMP     .wait
                RET

var first:      LONG    0
var second:     LONG    0
var third:      LONG    0
ready:          BYTE    "READY\n",  0

