//? WINDTUNNEL CHECK LIST
//? profile: program
//? stop: _end
//? stdout: "x"
//? max-cycles: 1_000_000
//? timeout-ms: 1000
//? run: "MOV DIRB"
//? const: enable_method = 0
//? run: "OR DIRB"
//? const: enable_method = 1

// Verify UART enable through MOV and OR writes to DIRB in separate runs.
// Use direct register writes rather than DIRH to catch peripheral enable paths that bypass writeback.


.cogexec
                HUBSET  0xF0
                WRPIN   P_TT_01 | P_ASYNC_TX,   62
.if enable_method == 0
                MOV     DIRB,                   aug(1 << 30)
.else
                OR      DIRB,                   aug(1 << 30)
.endif
                WYPIN   'x',                    62
// Observe acceptance before polling busy, whose return pipeline can still hold idle.
accepted:
                TESTP   62          :wc
    if(!C)      JMP     accepted
flush:
                RQPIN   PB, 62  :wc
    if(C)       JMP     flush
_end:
                JMP     _end
