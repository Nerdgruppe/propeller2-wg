//? WINDTUNNEL CHECK LIST
//? profile: program
//? stop: _end
//? stdin-after: "!"
//? max-cycles: 30_000_000
//? timeout-ms: 1000
//? baudrate: 115200
//? run: "binary terminal packet"
//? stdin: hex [00 80 ff]
//? stdout: "!\x00\x80\xff"
//? run: "text terminal packet"
//? stdin: "ABC"
//? stdout: "!ABC"

// A repeatable terminal protocol: announce readiness, then echo three-byte packets.
// Collect each packet before transmitting so RX does not overrun while TX is busy.
// The server tests send several packets over one connection; local checks stop after the first.
const UART_CFG = SmartPin.UartTx.config(baud=115_200, bits=8, clk=200_000_000)
.cogexec
                HUBSET  aug(0x0100_09fb)
                WRPIN   P_TT_01 | P_ASYNC_TX,   62
                WXPIN   aug(UART_CFG),          62
                DIRH    62
                WRPIN   P_ASYNC_RX,             63
                WXPIN   aug(UART_CFG),          63
                DIRH    63
                WAITX   aug(20_000_000)
                MOV     PA,                     '!'
                CALL    write_byte
main:
                CALL    read_byte
                MOV     first,  PA
                CALL    read_byte
                MOV     second, PA
                CALL    read_byte
                MOV     third,  PA
                MOV     PA,     first
                CALL    write_byte
                MOV     PA,     second
                CALL    write_byte
                MOV     PA,     third
                CALL    write_byte
_end:
                JMP     main
read_byte:
                TESTP   63          :wc
    if(!C)      JMP     read_byte
                RDPIN   PA, 63
                SHR     PA, 24
                RET
write_byte:
                WYPIN   PA, 62
                WAITX   1
.wait:          TESTP   62      :wc
    if(!C)      JMP     .wait
                RET
var first:      LONG    0
var second:     LONG    0
var third:      LONG    0
