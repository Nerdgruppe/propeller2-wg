//? stdout: "\x00\x60\x00\x00\x01\x00\x80\x00\xf8\x01\x00\x00\x00\x10\x00\x00\x00\x60\x00\x00"

// Debug-enabled loaded, no-load cog, LUT and hub starts on all eight cogs.
.cogexec    0
                HUBSET  0xF0
                WRPIN   P_TT_01 | P_ASYNC_TX,   62
                DIRH    62
                // Hand the controller to a separate cog, including when the target is cog zero.
                COGINIT observer_cog,           aug(hubaddr(controller))
                COGSTOP 0
.pack   off
.cogexec    0x2000, 0
controller:
                DIRH    62
                // Warm-load a retained local/LUT image before the debug-enabled restart.
                COGINIT target_cog,         aug(hubaddr(application))
                WAITX   aug(10000)
                SETQ    15
                RDLONG  register(0x100),    aug(hubaddr(debug_image))
                SETQ    15
                WRLONG  register(0x100),    aug(0xff840 + ((15 ^ target_cog) << 7))
                HUBSET  aug(0x20000000 | (1 << target_cog))
                SETQ    aug(0x1000)
                {{ coginit }}
                WAITX   aug(10000)
                MOV     PTRB,               aug(0x1000)
                MOV     register(0x90),     20
byte:
                RDBYTE  PA, PTRB++
                WYPIN   PA, 62
                WAITX   1
ready:
                TESTP   62                      :wc
    if(!C)      JMP     ready
                DJNZ    register(0x90), byte

flush:
                RQPIN   PB, 62  :wc
    if(C)       JMP     flush
_end:
                COGSTOP observer_cog

.cogexec    0x3000, 0
debug_image:
        // ROM pointer substitutions do not replace the application's PTRA/PTRB.
                MOV     register(0x80), PTRA
                MOV     register(0x81), INB
                GETBRK  register(0x82)                  :wcz
                MOV     register(0x83), INA
                MOV     register(0x84), PTRA
                MOV     register(0x85), PTRB
                SETQ    4
                WRLONG  register(0x81), register(0x80)
                JMP     nrel(0x1fd)
                LONG    [0] * 7

.cogexec    0x4000, 0
application:
        // Seed LUT execution for the subsequent no-load startup test.
                SETQ2   15
                RDLONG  register(0),    aug(hubaddr(lut_application))
                COGSTOP target_cog
                LONG    [0] * 500
.lutexec    0x5000
lut_application:
                COGSTOP target_cog
                LONG    [0] * 15
.hubexec    0x6000
hub_application:
                COGSTOP target_cog
