//? WINDTUNNEL CHECK LIST
//? post: cog[0].reg[PTRA] == 1

   // standalone block at the start rounds its first column up to four
     // including columns that are not multiples of four

// formatter fixture
.cogexec // first segment
first: MOV PTRA, 1 :wc // leading instruction
.local: if(!C & !Z) MOV PTRA, 3 :wz // local label stays in block
  NOP // no operands
  // standalone block after an instruction keeps its location
     // even without a blank line before it
 // all three lines share the first comment's column

    // attached to the local label
  // this line also attaches to the label
.attached:
          // before the instruction at its own column
   // this line shares the block indentation
NOP
     // unattached to the dot directive
  // this line shares the first comment's column
.align 4

second: LONG ticks(1000, ms=3) // one-line call
const SUM = (1 + // expression comment
    2)

.hubexec 0x100 // second segment
third: LONG ticks(1000, ms=ticks(1000, // nested call comment
    ms=1))
LONG ticks(1000, ms=3,) // trailing-comma call
math:
const PLUS = + +1
const MINUS = - -1
BYTE PLUS, MINUS
   // standalone block at EOF rounds its first column up to four
     // without a following statement
