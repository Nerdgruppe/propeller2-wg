// segments are chunks of contiguous memory in hub ram.
// each segment has its own unique "group" of addresses
// which typically can be loaded at once.

// keeps current segment,
// moves PC to ${addr}, can only forward PC.
// emission of data afterwards will pad the skipped space
.org ${addr}

// keeps current segment,
// aligns PC forward such that it is divisible by ${size},
// emission of data afterwards will pad the skipped space
// align is kinda weird as it aligns PC, not the hub address.
.align ${size}

// keeps current segment,
// increments PC by the provided count of LONGs
// emission of data afterwards will be an error,
// only legal in cogexec or regspace.
// use case: allocating uninitialized data registers. These registers
// won't have a defined initial value.
.reserve ${count}

// starts new segment,
// switches mode into "cog exec" mode and sets PC = 0x000
.cogexec

// starts new segment,
// switches mode into "lut exec" mode and sets PC = 0x200
.lutexec

// starts new segment,
// switches mode into "hub exec" mode and sets PC = <current hub address>
.hubexec

// starts new segment,
// switches mode into "cog exec" mode and sets PC = 0x000,
// will emit at hub address ${addr}.
.cogexec ${addr}

// starts a new cog segment at hub address ${addr} with PC = ${localstart}.
// unlike .org, this does not emit padding.
.cogexec ${addr}, ${localstart}
.cogexec $, ${localstart} // starts at the current hub address

// starts new segment,
// switches mode into "lut exec" mode and sets PC = 0x200,
// will emit at hub address ${addr}.
.lutexec ${addr}

// starts a new LUT segment with PC = ${localstart}, without padding.
.lutexec ${addr}, ${localstart}
.lutexec $, ${localstart}

// starts new segment,
// switches mode into "hub exec" mode and sets PC = ${addr},
// will emit at hub address ${addr}.
.hubexec ${addr}

// starts new segment,
// switches into "reg space" mode, sets PC = 0x000
// will not emit any data
.regspace

// starts a new register-space segment at ${localstart}, without padding.
.regspace ${addr}, ${localstart}
.regspace $, ${localstart}

// starts new segment,
// switches into "no code" mode, sets PC = invalid
// allows only emission of data instructions, not code
// labels have no "jump" address associated,
.data

// starts new segment,
// switches into "no code" mode, sets PC = invalid
// allows only emission of data instructions, not code
// labels have no "jump" address associated,
// will emit at hub address ${addr}.
.data ${addr}


// There are four kinds of data emission available:
BYTE … // emits all operands as 8 bit values.
WORD … // emits all operands as 16 bit values.
LONG … // emits all operands as 32 bit values.
FILE "path" // emits all bytes of the file "path"
// the important part is that in cog/lut exec mode is that:
// | BYTE 1, 2
// | BYTE 3, 4
// will still only occupy a single LONG, but 
// | BYTE 1
// | LONG 2
// will emit a 8-bit "1", optional padding so the LONG is aligned, then a 32-bit number "2"
//
// if any padding is emitted, a warning shall be generated.
