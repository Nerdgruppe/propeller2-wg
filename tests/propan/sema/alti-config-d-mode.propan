//? PROPAN CHECK LIST
//? mem: 0 == u32 [ 0b000_000_000_000_111_000 ]
.assert alti.config(#keep, #dec, #none, #none, #keep, #none) == 0b000_000_000_000_010_000
.assert alti.config(#keep, #inc, #none, #none, #keep, #none) == 0b000_000_000_000_011_000
.assert alti.config(#keep, #keep, #none, #subst, #keep, #none) == 0b000_000_000_000_100_000
.assert alti.config(#keep, #dec, #none, #subst, #keep, #none) == 0b000_000_000_000_110_000
LONG alti.config(#keep, #inc, #none, #subst, #keep, #none)
