//? PROPAN CHECK LIST
//? sym: _start0 code:0:0
//? sym: _end0   code:12:3
//? sym: _start1 code:20:0
//? sym: _end1   code:32:3
//? sym: _start2 code:40:0
//? sym: _end2   code:52:3
//? sym: _start3 code:60:60
//? sym: _end3   code:72:72
//? mem: 0x00000 == u32 [
//?      100,  200,  300,  3, 12,
//?      400,  500,  600,  3, 32,
//?      700,  800,  900,  3, 52,
//?     1000, 1100, 1200, 72, 72
//? ]

.cogexec
_start0:
    LONG 100
    LONG 200
    LONG 300
_end0:
    LONG _end0, hubaddr(_end0)

.cogexec
_start1:
    LONG 400
    LONG 500
    LONG 600
_end1:
    LONG _end1, hubaddr(_end1)

.lutexec
_start2:
    LONG 700
    LONG 800
    LONG 900
_end2:
    LONG _end2, hubaddr(_end2)

.hubexec
_start3:
    LONG 1000
    LONG 1100
    LONG 1200
_end3:
    LONG _end3, hubaddr(_end3)
