//? PROPAN CHECK LIST
//? seg: 0x100 4 lutexec
//? seg: 0x104 4 lutexec
//? seg: 0x108 0 regspace
//? seg: 0x108 1 hubexec
//? seg: 0x109 1 data

.lutexec 0x100, 0x200
lut_start:
NOP
.fit lut_end
lut_end:

.lutexec $, lut_start
NOP
.fit lut_end

.regspace $, 0x1f7
var reg_start:
RES 1
.regspace $, reg_start
RES 1
.fit 0x1f8

.hubexec $
.fit hub_end
BYTE 1
hub_end:
.fit hub_end

.data $
BYTE 2
data_end:
.fit data_end
