const COGSIZE = 0x1F8

.hubexec 0x0000 // sets the current hub address where data will be emitted
.cogexec 0x000 // sets the current cog address which is used in cogexec mode
.lutexec 0x000 // sets the current lut address which is used in lutexec mode

.cogexec // labels afterwards will use register-addressing
.lutexec // labels afterwards will use lut addressing (similar to .cogexec)
.hubexec // labels afterwards will use ram-addressing

.cogexec
code:
    RDLONG dst, hub(ramdata) // use builtin to get hub address 

var dst:
    LONG value

.cogfit COGSIZE // check if the code fits into the given number of registers

ramdata:
    LONG 10, 20, 30, 40

.cogexec 0x1F0
.cogexec

var IJMP3: RES 1  // 0x1F0: Read/WriteInterrupt call address for INT3; set by code
var IRET3: RES 1  // 0x1F1: Read/WriteInterrupt return address and C/Z flags for INT3; set by cog
var IJMP2: RES 1  // 0x1F2: Read/WriteInterrupt call address for INT2; set by code
var IRET2: RES 1  // 0x1F3: Read/WriteInterrupt return address and C/Z flags for INT2; set by cog
var IJMP1: RES 1  // 0x1F4: Read/WriteInterrupt call address for INT1; set by code
var IRET1: RES 1  // 0x1F5: Read/WriteInterrupt return address and C/Z flags for INT1; set by cog
var PA:    RES 1  // 0x1F6: Read/WriteCALLD-imm return, CALLPA parameter, or LOC address
var PB:    RES 1  // 0x1F7: Read/WriteCALLD-imm return, CALLPB parameter, or LOC address
var PTRA:  RES 1  // 0x1F8: Read Special / Write Special Pointer A to Hub RAM
var PTRB:  RES 1  // 0x1F9: Read Special / Write Special Pointer B to Hub RAM
var DIRA:  RES 1  // 0x1FA: Read / Write SpecialOutput enables (direction bits) for P31..P0
var DIRB:  RES 1  // 0x1FB: Read / Write SpecialOutput enables (direction bits) for P63..P32
var OUTA:  RES 1  // 0x1FC: Read / Write SpecialOutput states for P31..P0
var OUTB:  RES 1  // 0x1FD: Read / Write SpecialOutput states for P63..P32
var INA:   RES 1  // 0x1FE: Read SpecialInput states for P31..P0
var INB:   RES 1  // 0x1FE: Read SpecialInput states for P63..P32

// RES N will advance the cog address by N longs, but prevents further hub emission before another segment

