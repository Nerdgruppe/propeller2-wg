                //? ]
                // Start all seven companions before the common CT deadline.
                MOV     target_ptr, aug(hubaddr(target))
                GETCT   timer
                ADD     timer,      aug(20000)
                WRLONG  timer,      target_ptr
                MOV     id,         1
launch:
                COGINIT id,             aug(hubaddr(worker))
                ADD     id,             1
                CMP     id,             8                       :wz
    if(!Z)      JMP     launch
                MOV     id,             0
                // Capture all cog words at identical clocks, with alternating parity between bursts.
                MOV     PTRA,           aug(hubaddr(buffer))
                MOV     offset,         id
                MUL     offset,         aug(2064)
                ADD     PTRA,           offset
                RDLONG  timer,          aug(hubaddr(target))
                MOV     blocks_left,    4
burst:
                ADDCT1  timer,          0
                WAITCT1
                GETCT   stamp
                GETCT   sample0
                WAITX   0                                   :wc
                GETCT   sample1
                WRC     sample2
                WRZ     sample3
                GETCT   sample4
                WAITX   1                                   :wz
                GETCT   sample5
                WRC     sample6
                WRZ     sample7
                GETCT   sample8
                WAITX   3                                   :wcz
                GETCT   sample9
                WRC     sample10
                WRZ     sample11
                GETCT   sample12
                WAITX   7                                   :wc
                GETCT   sample13
                WRC     sample14
                WRZ     sample15
                GETCT   sample16
                WAITX   15                                  :wz
                GETCT   sample17
                WRC     sample18
                WRZ     sample19
                GETCT   sample20
                WAITX   31                                  :wcz
                GETCT   sample21
                WRC     sample22
                WRZ     sample23
                // Move the completed register burst to hub RAM after the sampling window.
                WRLONG  stamp,          PTRA
                ADD     PTRA,           4
                SETQ    127
                WRLONG  sample0,        PTRA
                ADD     PTRA,           aug(512)
                ADD     timer,          aug(4097)
                DJNZ    blocks_left,    burst
                MOV     offset,         id
                SHL     offset,         2
                ADD     offset,         aug(hubaddr(done))
                WRLONG  one,            offset
                // Wait for every companion to finish before the oracle reads the shared buffers.
                MOV     id,             1
join:
                MOV     offset, id
                SHL     offset, 2
                ADD     offset, aug(hubaddr(done))
                RDLONG  value,  offset
                CMP     value,  1                   :wz
    if(!Z)      JMP     join
                ADD     id,     1
                CMP     id,     8                   :wz
    if(!Z)      JMP     join
                JMP     nrel(_end)
