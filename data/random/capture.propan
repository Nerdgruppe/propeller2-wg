                WRLONG  stamp,          PTRA
                ADD     PTRA,           4
                SETQ    127
                WRLONG  sample0,        PTRA
                ADD     PTRA,           aug(512)
                ADD     timer,          aug(4097)
                DJNZ    blocks_left,    burst
                MOV     offset,         id
                SHL     offset,         2
                ADD     offset,         aug(hubaddr(done))
                WRLONG  one,            offset
                // Wait for every companion to finish before the oracle reads the shared buffers.
                MOV     id,             1
join:
                MOV     offset, id
                SHL     offset, 2
                ADD     offset, aug(hubaddr(done))
                RDLONG  value,  offset
                CMP     value,  1                   :wz
    if(!Z)      JMP     join
                ADD     id,     1
                CMP     id,     8                   :wz
    if(!Z)      JMP     join
                JMP     nrel(_end)
