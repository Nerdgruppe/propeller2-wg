.cogexec    0x4000, 0
worker:
                COGID   w_id
                // Capture all cog words at identical clocks, with alternating parity between bursts.
                MOV     PTRA,           aug(hubaddr(buffer))
                MOV     w_offset,         w_id
                MUL     w_offset,         aug(2064)
                ADD     PTRA,           w_offset
                RDLONG  w_timer,          aug(hubaddr(target))
                MOV     w_blocks_left,    4
w_burst:
