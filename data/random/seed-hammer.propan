var timer_init: LONG    0
var launch_id:  LONG    0

.cogexec    0x4000, 0
worker:

                // Rotate the w_observer and the four w_seed counts, retaining a no-seeding baseline.
                COGID   w_id
                RDLONG  w_timer,    aug(hubaddr(target))
                MOV     PTRA,       aug(hubaddr(buffer))
                MOV     w_config,   0
w_config_loop:
                MOV     w_seeders,  w_config
                CMP     w_seeders,  0           :wz
    if(!Z)      ADD     w_seeders,  3
                MOV     w_observer, 0
w_observer_loop:
                MOV     w_blocks,   8
w_burst:
                MOV     w_rank,     w_id
                SUB     w_rank,     w_observer
                SUB     w_rank,     1
                AND     w_rank,     7
                CMP     w_id,       w_observer  :wz
    if(Z)       JMP     w_observe
                CMP     w_rank,     w_seeders   :wc
    if(!C)      JMP     w_next_block
                // Seven cogs issue HUBSET at their own hub-command slots, with no work between writes.
                ADDCT1  w_timer,    0
                WAITCT1
                MOV     w_repeats,  64
w_hammer:
                HUBSET  w_seed
                HUBSET  w_seed
                HUBSET  w_seed
                HUBSET  w_seed
                HUBSET  w_seed
                HUBSET  w_seed
                HUBSET  w_seed
                HUBSET  w_seed
                HUBSET  w_seed
                HUBSET  w_seed
                HUBSET  w_seed
                HUBSET  w_seed
                HUBSET  w_seed
                HUBSET  w_seed
                HUBSET  w_seed
                HUBSET  w_seed
                DJNZ    w_repeats,  w_hammer
                JMP     w_next_block
w_observe:
// Let repeated seeding settle; incrementing w_burst deadlines visits all CT phases.
                MOV     w_sample_time,  w_timer
                ADD     w_sample_time,  aug(4096)
                ADDCT1  w_sample_time,  0
                WAITCT1
                GETCT   w_stamp
                GETRND  w_sample0
                GETRND  w_sample1
                GETRND  w_sample2
                GETRND  w_sample3
                GETRND  w_sample4
                GETRND  w_sample5
                GETRND  w_sample6
                GETRND  w_sample7
                GETRND  w_sample8
                GETRND  w_sample9
                GETRND  w_sample10
                GETRND  w_sample11
                GETRND  w_sample12
                GETRND  w_sample13
                GETRND  w_sample14
                GETRND  w_sample15
                GETRND  w_sample16
                GETRND  w_sample17
                GETRND  w_sample18
                GETRND  w_sample19
                GETRND  w_sample20
                GETRND  w_sample21
                GETRND  w_sample22
                GETRND  w_sample23
                GETRND  w_sample24
                GETRND  w_sample25
                GETRND  w_sample26
                GETRND  w_sample27
                GETRND  w_sample28
                GETRND  w_sample29
                GETRND  w_sample30
                GETRND  w_sample31
                GETRND  w_sample32
                GETRND  w_sample33
                GETRND  w_sample34
                GETRND  w_sample35
                GETRND  w_sample36
                GETRND  w_sample37
                GETRND  w_sample38
                GETRND  w_sample39
                GETRND  w_sample40
                GETRND  w_sample41
                GETRND  w_sample42
                GETRND  w_sample43
                GETRND  w_sample44
                GETRND  w_sample45
                GETRND  w_sample46
                GETRND  w_sample47
                GETRND  w_sample48
                GETRND  w_sample49
                GETRND  w_sample50
                GETRND  w_sample51
                GETRND  w_sample52
                GETRND  w_sample53
                GETRND  w_sample54
                GETRND  w_sample55
                GETRND  w_sample56
                GETRND  w_sample57
                GETRND  w_sample58
                GETRND  w_sample59
                GETRND  w_sample60
                GETRND  w_sample61
                GETRND  w_sample62
                GETRND  w_sample63

                // Save the register w_burst only after sampling, outside the measurement window.
                WRLONG  w_stamp,        PTRA
                ADD     PTRA,           4
                SETQ    63
                WRLONG  w_sample0,      PTRA
w_next_block:
                ADD     PTRA,       aug(256)
                // Only the w_observer advances by the w_stamp long as well.
                CMP     w_id,       w_observer          :wz
    if(!Z)      ADD     PTRA,       4
                ADD     w_timer,    aug(32769)
                DJNZ    w_blocks,   w_burst
                ADD     w_observer, 1
                CMP     w_observer, 8                   :wz
    if(!Z)      JMP     w_observer_loop
                ADD     w_config,   1
                CMP     w_config,   5                   :wz
    if(!Z)      JMP     w_config_loop
                // Stop companions, and keep cog 0 alive until every worker has finished.
                MOV     w_offset,   w_id
                SHL     w_offset,   2
                ADD     w_offset,   aug(hubaddr(done))
                WRLONG  w_one,      w_offset
                CMP     w_id,       0                   :wz
    if(!Z)      COGSTOP w_id
                MOV     w_id,       1
w_join:
                MOV     w_offset,   w_id
                SHL     w_offset,   2
                ADD     w_offset,   aug(hubaddr(done))
                RDLONG  w_value,    w_offset
                CMP     w_value,    1                   :wz
    if(!Z)      JMP     w_join
                ADD     w_id,       1
                CMP     w_id,       8                   :wz
    if(!Z)      JMP     w_join
                JMP     nrel(_end)
var w_id:       LONG    0
var w_timer:    LONG    0
var w_config:   LONG    0
var w_seeders:  LONG    0
var w_observer: LONG    0
var w_blocks:   LONG    0
var w_rank:     LONG    0
var w_repeats:  LONG    0
var w_seed:     LONG    0x80000000
var w_sample_time:
                LONG    0
