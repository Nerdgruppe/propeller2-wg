//? ]

                // Start the seven companions before the common CT deadline.
                MOV     target_ptr, aug(hubaddr(target))
                GETCT   timer_init
                ADD     timer_init, aug(20000)
                WRLONG  timer_init, target_ptr
                MOV     launch_id,  1
launch:
                COGINIT launch_id,  aug(hubaddr(worker))
                ADD     launch_id,  1
                CMP     launch_id,  8                       :wz
    if(!Z)      JMP     launch

                // Rotate the observer and the four seed counts, retaining a no-seeding baseline.
                COGID   id
                RDLONG  timer,      aug(hubaddr(target))
                MOV     PTRA,       aug(hubaddr(buffer))
                MOV     config,     0
config_loop:
                MOV     seeders,    config
                CMP     seeders,    0       :wz
    if(!Z)      ADD     seeders,    3
                MOV     observer,   0
observer_loop:
                MOV     blocks, 8
burst:
                MOV     rank,       id
                SUB     rank,       observer
                SUB     rank,       1
                AND     rank,       7
                CMP     id,         observer    :wz
    if(Z)       JMP     observe
                CMP     rank,       seeders     :wc
    if(!C)      JMP     next_block
                // Seven cogs issue HUBSET at their own hub-command slots, with no work between writes.
                ADDCT1  timer,      0
                WAITCT1
                MOV     repeats,    64
hammer:
                HUBSET  seed
                HUBSET  seed
                HUBSET  seed
                HUBSET  seed
                HUBSET  seed
                HUBSET  seed
                HUBSET  seed
                HUBSET  seed
                HUBSET  seed
                HUBSET  seed
                HUBSET  seed
                HUBSET  seed
                HUBSET  seed
                HUBSET  seed
                HUBSET  seed
                HUBSET  seed
                DJNZ    repeats,    hammer
                JMP     next_block
observe:
// Let repeated seeding settle; incrementing burst deadlines visits all CT phases.
                MOV     sample_time,    timer
                ADD     sample_time,    aug(4096)
                ADDCT1  sample_time,    0
                WAITCT1
                GETCT   stamp
                GETRND  sample0
                GETRND  sample1
                GETRND  sample2
                GETRND  sample3
                GETRND  sample4
                GETRND  sample5
                GETRND  sample6
                GETRND  sample7
                GETRND  sample8
                GETRND  sample9
                GETRND  sample10
                GETRND  sample11
                GETRND  sample12
                GETRND  sample13
                GETRND  sample14
                GETRND  sample15
                GETRND  sample16
                GETRND  sample17
                GETRND  sample18
                GETRND  sample19
                GETRND  sample20
                GETRND  sample21
                GETRND  sample22
                GETRND  sample23
                GETRND  sample24
                GETRND  sample25
                GETRND  sample26
                GETRND  sample27
                GETRND  sample28
                GETRND  sample29
                GETRND  sample30
                GETRND  sample31
                GETRND  sample32
                GETRND  sample33
                GETRND  sample34
                GETRND  sample35
                GETRND  sample36
                GETRND  sample37
                GETRND  sample38
                GETRND  sample39
                GETRND  sample40
                GETRND  sample41
                GETRND  sample42
                GETRND  sample43
                GETRND  sample44
                GETRND  sample45
                GETRND  sample46
                GETRND  sample47
                GETRND  sample48
                GETRND  sample49
                GETRND  sample50
                GETRND  sample51
                GETRND  sample52
                GETRND  sample53
                GETRND  sample54
                GETRND  sample55
                GETRND  sample56
                GETRND  sample57
                GETRND  sample58
                GETRND  sample59
                GETRND  sample60
                GETRND  sample61
                GETRND  sample62
                GETRND  sample63

                // Save the register burst only after sampling, outside the measurement window.
                WRLONG  stamp,          PTRA
                ADD     PTRA,           4
                SETQ    63
                WRLONG  sample0,        PTRA
next_block:
                ADD     PTRA,       aug(256)
                // Only the observer advances by the stamp long as well.
                CMP     id,         observer            :wz
    if(!Z)      ADD     PTRA,       4
                ADD     timer,      aug(32769)
                DJNZ    blocks,     burst
                ADD     observer,   1
                CMP     observer,   8                   :wz
    if(!Z)      JMP     observer_loop
                ADD     config,     1
                CMP     config,     5                   :wz
    if(!Z)      JMP     config_loop
                // Stop companions, and keep cog 0 alive until every worker has finished.
                MOV     offset,     id
                SHL     offset,     2
                ADD     offset,     aug(hubaddr(done))
                WRLONG  one,        offset
                CMP     id,         0                   :wz
    if(!Z)      COGSTOP id
                MOV     id,         1
join:
                MOV     offset, id
                SHL     offset, 2
                ADD     offset, aug(hubaddr(done))
                RDLONG  value,  offset
                CMP     value,  1                   :wz
    if(!Z)      JMP     join
                ADD     id,     1
                CMP     id,     8                   :wz
    if(!Z)      JMP     join
                JMP     nrel(_end)
var id:         LONG    0
var timer:      LONG    0
var config:     LONG    0
var seeders:    LONG    0
var observer:   LONG    0
var blocks:     LONG    0
var rank:       LONG    0
var repeats:    LONG    0
var seed:       LONG    0x80000000
var sample_time:
                LONG    0
var stamp:      LONG    0
var offset:     LONG    0
var one:        LONG    1
var value:      LONG    0
var sample0:    LONG    0
var sample1:    LONG    0
