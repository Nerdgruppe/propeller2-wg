//? ]
// Start all seven companions before the common CT deadline.
                MOV     target_ptr, aug(hubaddr(target))
                GETCT   timer
                ADD     timer,      aug(20000)
                WRLONG  timer,      target_ptr
                MOV     id,         1
launch:
                COGINIT id,             aug(hubaddr(worker))
                ADD     id,             1
                CMP     id,             8                       :wz
    if(!Z)      JMP     launch
                MOV     id,             0
                // Capture all cog words at identical clocks, with alternating parity between bursts.
                MOV     PTRA,           aug(hubaddr(buffer))
                MOV     offset,         id
                MUL     offset,         aug(4352)
                ADD     PTRA,           offset
                RDLONG  timer,          aug(hubaddr(target))
                MOV     blocks_left, 64
burst:
                ADDCT1  timer,          0
                WAITCT1
                GETCT   stamp
                HUBSET seed
                GETRND  sample0
                GETRND  sample1
                GETRND  sample2
                GETRND  sample3
                GETRND  sample4
                GETRND  sample5
                GETRND  sample6
                GETRND  sample7
                GETRND  sample8
                GETRND  sample9
                GETRND  sample10
                GETRND  sample11
                GETRND  sample12
                GETRND  sample13
                GETRND  sample14
                GETRND  sample15
                // Move the completed register burst to hub RAM after the sampling window.
                WRLONG  stamp,          PTRA
                ADD     PTRA,           4
                SETQ 15
                WRLONG  sample0,        PTRA
                ADD     PTRA,           aug(64)
                ADD seed, aug(0x01a35000)
                ADD     timer,          aug(257)
                DJNZ    blocks_left,    burst
                MOV     offset,         id
                SHL     offset,         2
                ADD     offset,         aug(hubaddr(done))
                WRLONG  one,            offset
                // Wait for every companion to finish before the oracle reads the shared buffers.
                MOV     id,             1
join:
                MOV     offset, id
                SHL     offset, 2
                ADD     offset, aug(hubaddr(done))
                RDLONG  value,  offset
                CMP     value,  1                   :wz
    if(!Z)      JMP     join
                ADD     id,     1
                CMP     id,     8                   :wz
    if(!Z)      JMP     join
                JMP     nrel(_end)
var id:         LONG    0
var timer:      LONG    0
var stamp:      LONG    0
var target_ptr: LONG    0
var offset:     LONG    0
var blocks_left:
                LONG    0
var value:      LONG    0
var seed: LONG 0x80000000
var one:        LONG    1
var sample0:    LONG    0
var sample1:    LONG    0
var sample2:    LONG    0
var sample3:    LONG    0
var sample4:    LONG    0
var sample5:    LONG    0
var sample6:    LONG    0
var sample7:    LONG    0
var sample8:    LONG    0
var sample9:    LONG    0
var sample10:   LONG    0
var sample11:   LONG    0
var sample12:   LONG    0
var sample13:   LONG    0
var sample14:   LONG    0
var sample15:   LONG    0

.cogexec    0x4000, 0
worker:
                COGID   w_id
                // Capture all cog words at identical clocks, with alternating parity between bursts.
                MOV     PTRA,           aug(hubaddr(buffer))
                MOV     w_offset,         w_id
                MUL     w_offset,         aug(4352)
                ADD     PTRA,           w_offset
                RDLONG  w_timer,          aug(hubaddr(target))
                MOV     w_blocks_left, 64
w_burst:
                ADDCT1  w_timer,          0
                WAITCT1
                GETCT   w_stamp
                GETRND  w_sample0
                GETRND  w_sample1
                GETRND  w_sample2
                GETRND  w_sample3
                GETRND  w_sample4
                GETRND  w_sample5
                GETRND  w_sample6
                GETRND  w_sample7
                GETRND  w_sample8
                GETRND  w_sample9
                GETRND  w_sample10
                GETRND  w_sample11
                GETRND  w_sample12
                GETRND  w_sample13
                GETRND  w_sample14
                GETRND  w_sample15
                // Move the completed register w_burst to hub RAM after the sampling window.
                WRLONG  w_stamp,          PTRA
                ADD     PTRA,           4
                SETQ 15
                WRLONG  w_sample0,        PTRA
                ADD     PTRA,           aug(64)
                ADD     w_timer,          aug(257)
                DJNZ    w_blocks_left,    w_burst
                MOV     w_offset,         w_id
                SHL     w_offset,         2
                ADD     w_offset,         aug(hubaddr(done))
                WRLONG  w_one,            w_offset
                COGSTOP w_id
var w_id:         LONG    0
var w_timer:      LONG    0
var w_stamp:      LONG    0
var w_target_ptr: LONG    0
var w_offset:     LONG    0
var w_blocks_left:
                LONG    0
var w_value:      LONG    0
var w_one:        LONG    1
var w_sample0:    LONG    0
var w_sample1:    LONG    0
var w_sample2:    LONG    0
var w_sample3:    LONG    0
var w_sample4:    LONG    0
var w_sample5:    LONG    0
var w_sample6:    LONG    0
var w_sample7:    LONG    0
var w_sample8:    LONG    0
var w_sample9:    LONG    0
var w_sample10:   LONG    0
var w_sample11:   LONG    0
var w_sample12:   LONG    0
var w_sample13:   LONG    0
var w_sample14:   LONG    0
var w_sample15:   LONG    0

.data   0x8000
