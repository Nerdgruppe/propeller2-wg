// External serial receiver on P10, with A=P8 and B=P9; the pad never drives the shared bus.
.cogexec
                HUBSET  0xf0
                WRPIN   P_TT_01 | P_ASYNC_TX,   62
                WRPIN   P_ASYNC_RX,             63
                DIRH    62
                DIRH    63
                HUBSET  aug(0x010009f8)
                WAITX   aug(200000)
                HUBSET  aug(0x010009fb)
                WXPIN   aug((100 << 16) | 7),   62
                WXPIN   aug((100 << 16) | 7),   63
                GETCT   deadline
                ADD     deadline,               aug(1000000000)
                MOV     PA,                     '!'
                CALL    write_byte
main:
                CALL    read_byte
                CMP     PA, 'C'     :wz
    if(Z)       JMP     configure
                CMP     PA, 'X'     :wz
    if(Z)       JMP     change_x
                CMP     PA, 'R'     :wz
    if(Z)       JMP     report
                DIRL    10
                WRPIN   0,  10
                JMP     ack
// Configure only the receiver and its routed inputs.
configure:
                CALL    read_byte
                MOV     mode,   PA
                SHL     mode,   1
                OR      mode,   aug(0x67000000)
                DIRL    10
                WRPIN   mode,   10
                CALL    read_long
                WXPIN   word,   10
                DIRH    10
                WAITX   16
                JMP     ack
// Leave the partial receive state intact during an X update.
change_x:
                CALL    read_long
                WXPIN   word,   10
                WAITX   16
                JMP     ack
// Capture result and readiness before the reporter changes flags.
report:
                RQPIN   word,   10  :wc
                WRC     carry
                TESTP   10          :wc
                WRC     ready
                MOV     bytes,  4
report_byte:
                MOV     PA,     word
                CALL    write_byte
                SHR     word,   8
                DJNZ    bytes,  report_byte
                MOV     PA,     carry
                CALL    write_byte
                MOV     PA,     ready
                CALL    write_byte
                JMP     main
ack:
                MOV     PA, '.'
                CALL    write_byte
                JMP     main
// Bound input waits so an abandoned host session releases the receiver bank.
read_byte:
                GETCT   now
                SUB     now,        deadline
                TESTB   now,        31              :wc
    if(!C)      JMP     stop
                TESTP   63                          :wc
    if(!C)      JMP     read_byte
                RDPIN   PA,         63
                SHR     PA,         24
                GETCT   deadline
                ADD     deadline,   aug(1000000000)
                RET
// Receive one little-endian host command parameter.
read_long:
                MOV     word,   0
                MOV     bytes,  4
read_long_byte:
                CALL    read_byte
                SHR     word,   8
                SHL     PA,     24
                OR      word,   PA
                DJNZ    bytes,  read_long_byte
                RET
// Do not accept another command until the response entered the UART shifter.
write_byte:
                WYPIN   PA,             62
                WAITX   1
                MOV     flush_budget,   aug(100000)
.wait:          TESTP   62                          :wc
    if(C)       RET
                DJNZ    flush_budget,   .wait
                JMP     stop
stop:
                DIRL    10
                WRPIN   0,  10
                COGSTOP 0
var mode:       LONG    0
var word:       LONG    0
var bytes:      LONG    0
var carry:      LONG    0
var ready:      LONG    0
var deadline:   LONG    0
var now:        LONG    0


var flush_budget:
                LONG    0

