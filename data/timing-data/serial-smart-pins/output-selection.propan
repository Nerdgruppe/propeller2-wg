//? run: "pll1-out1-gap8"
//? const: pll = 1
//? const: initial = 1
//? const: gap = 8
//? post: cog[*].reg[selected] == 0x00000001
//? post: cog[*].reg[settled] == 0x00000001
//? post: cog[*].reg[restored] == 0x00000001
//? post: cog[*].reg[restored_settled] == 0x00000001

// Select the stable low/high timing bands, retaining ROM-calibrated reporting.
.if pll
                HUBSET  aug(0x010009f8)
                WAITX   aug(200000)
                HUBSET  aug(0x010009fb)
                WAITX   64
.endif
                // Observe P4 through GPIO P5, independently of UART's completion IN signal.
                WRPIN   aug(0x70000000),        5
                WRPIN   0,                      4
.if initial
                DRVH    4
.else
                DRVL    4
.endif
                WAITX   32
                // Select idle UART TX without a payload; retain the cog OUT value for restoration.
                WRPIN   P_TT_01 | P_ASYNC_TX,   4
.if gap
                WAITX   gap
.endif
                TESTP   5                                           :wc
                WRC     selected
                WAITX   32
                TESTP   5                                           :wc
                WRC     settled
                // Return to GPIO and sample the same OUT level at the same instruction offset.
                WRPIN   0,                      4
.if gap
                WAITX   gap
.endif
                TESTP   5                                           :wc
                WRC     restored
                WAITX   32
                TESTP   5                                           :wc
                WRC     restored_settled
                // Restore GPIO and calibrated RCFAST before the shared reporter owns the terminal.
                DIRL    aug(0 | (7 << 6))
                WRPIN   0,                      aug(0 | (7 << 6))
                HUBSET  0xf0
                WAITX   64
                JMP     nrel(_end)
var selected:   LONG    0
var settled:    LONG    0
var restored:   LONG    0
var restored_settled:
                LONG    0

