// Independent weak-drive GPIO source with a bounded idle watchdog, using ROM-calibrated UART.
.cogexec
                HUBSET  0xF0
                WRPIN   P_TT_01 | P_ASYNC_TX,           62
                DIRH    62
                WRPIN   P_ASYNC_RX,                     63
                DIRH    63
                WRPIN   aug(P_HIGH_1K5 | P_LOW_1K5),    aug(8 | (7 << 6))
                DIRL    aug(8 | (7 << 6))
                HUBSET  aug(0x010009f8)
                WAITX   aug(200000)
                HUBSET  aug(0x010009fb)
                WXPIN   aug((100 << 16) | 7),           62
                WXPIN   aug((100 << 16) | 7),           63
                GETCT   deadline
                ADD     deadline,                       aug(1000000000)
                MOV     PA,                             '!'
                CALL    write_byte
main:
                CALL    read_byte
                CMP     PA, 'U'     :wz
    if(Z)       JMP     uart_word
                CMP     PA, 'W'     :wz
    if(Z)       JMP     write_gpio
                CALL    release
                JMP     ack
write_gpio:
                WRPIN   aug(P_HIGH_1K5 | P_LOW_1K5),    aug(8 | (7 << 6))
                CALL    read_byte
                SHL     PA,                             8
                // One GPIO write avoids artificial intermediate edges while changing source states.
                MOV     OUTA,                           PA
                DIRH    aug(8 | (7 << 6))
                GETCT   deadline
                ADD     deadline,                       aug(1000000000)
                WAITX   aug(10000)
ack:
                GETCT   deadline
                ADD     deadline,   aug(1000000000)
                MOV     PA,         '.'
                CALL    write_byte
                JMP     main
// Release all shared outputs if host communication stops for roughly one RCFAST second.
read_byte:
                GETCT   now
                SUB     now,    deadline
                TESTB   now,    31          :wc
    if(!C)      CALL    release
                TESTP   63                  :wc
    if(!C)      JMP     read_byte
                RDPIN   PA,     63
                SHR     PA,     24
                RET
// Finish every response before accepting another command.
write_byte:
                WYPIN   PA,             62
                WAITX   1
                MOV     flush_budget,   aug(100000)
.wait:          TESTP   62                          :wc
    if(C)       RET
                DJNZ    flush_budget,   .wait
                CALL    release
                COGSTOP 0
// Emit a full-width UART word using the independently clocked secondary board.
uart_word:
                CALL    read_byte
                MOV     width,                                              PA
                CALL    read_long
                DIRL    8
                WRPIN   aug(P_TT_01 | P_HIGH_1K5 | P_LOW_1K5 | P_ASYNC_TX), 8
                SUB     width,                                              1
                OR      width,                                              aug(1024 << 16)
                WXPIN   width,                                              8
                DIRH    8
                WYPIN   word,                                               8
                WAITX   8
                GETCT   deadline
                ADD     deadline,                                           aug(2000000)
uart_wait:
                GETCT   now
                SUB     now,    deadline
                TESTB   now,    31          :wc
    if(!C)      CALL    release
    if(!C)      JMP     ack
                RQPIN   PA,     8           :wc
    if(C)       JMP     uart_wait
                JMP     ack
// Receive little-endian host words while retaining the existing input watchdog.
read_long:
                MOV     word,   0
                MOV     bytes,  4
read_long_byte:
                CALL    read_byte
                SHR     word,   8
                SHL     PA,     24
                OR      word,   PA
                DJNZ    bytes,  read_long_byte
                RET
// UART TT can drive while DIR is low, so restore GPIO routing as well as DIR.
release:
                DIRL    aug(8 | (7 << 6))
                WRPIN   aug(P_HIGH_1K5 | P_LOW_1K5),    aug(8 | (7 << 6))
                RET
var width:      LONG    0
var word:       LONG    0
var bytes:      LONG    0
var deadline:   LONG    0
var now:        LONG    0


var flush_budget:
                LONG    0

