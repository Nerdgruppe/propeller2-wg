// RAM-only wiring probe. UART retains the ROM-calibrated 2 Mbaud divider.
.cogexec
                HUBSET  0xF0
                CALL    float_pins
                WRPIN   P_TT_01 | P_ASYNC_TX,   62
                DIRH    62
                WRPIN   P_ASYNC_RX,             63
                DIRH    63
                MOV     PA,                     '!'
                CALL    write_byte

// I: weak pulldown receiver; W<byte>: weak output; R: sample; F: float; L: analyzer pattern.
main:
                CALL    read_byte
                CMP     PA, 'I'         :wz
    if(Z)       JMP     receive_pins
                CMP     PA, 'W'         :wz
    if(Z)       JMP     drive_pins
                CMP     PA, 'R'         :wz
    if(Z)       JMP     sample_pins
                CMP     PA, 'F'         :wz
    if(Z)       CALL    float_pins
                CMP     PA, 'L'         :wz
    if(Z)       CALL    logic_pattern
ack:
                MOV     PA, '.'
                CALL    write_byte
                JMP     main

// Bias disconnected wires low with 150 kOhm while preserving a high-impedance high state.
receive_pins:
                DIRL    aug(8 | (7 << 6))
                WRPIN   aug(P_HIGH_FLOAT | P_LOW_150K), aug(8 | (7 << 6))
                OUTL    aug(8 | (7 << 6))
                DIRH    aug(8 | (7 << 6))
                JMP     ack

// Limit drive strength in both directions, then allow the bus to settle.
drive_pins:
                CALL    read_byte
                SHL     PA,                             8
                DIRL    aug(8 | (7 << 6))
                WRPIN   aug(P_HIGH_1K5 | P_LOW_1K5),    aug(8 | (7 << 6))
                ANDN    OUTA,                           aug(0xFF00)
                OR      OUTA,                           PA
                DIRH    aug(8 | (7 << 6))
                WAITX   aug(10000)
                JMP     ack

// Return P8..P15 in the low byte after a settling interval.
sample_pins:
                WAITX   aug(10000)
                MOV     PA, INA
                SHR     PA, 8
                AND     PA, 255
                CALL    write_byte
                JMP     main

// Release every tested pin without changing the UART.
float_pins:
                DIRL    aug(0 | (15 << 6))
                DIRL    aug(32 | (7 << 6))
                RET

// Three frames, each with a low marker, 16 walking ones and 16 walking zeros.
logic_pattern:
                WRPIN   aug(P_HIGH_1K5 | P_LOW_1K5),    aug(0 | (7 << 6))
                WRPIN   aug(P_HIGH_1K5 | P_LOW_1K5),    aug(32 | (7 << 6))
                MOV     pattern,                        0
                CALL    output_pattern
                DIRH    aug(0 | (7 << 6))
                DIRH    aug(32 | (7 << 6))
                MOV     frames,                         3
.frame:         MOV     pattern,                        0
                CALL    output_pattern
                WAITX   aug(400000)
                MOV     bit,                            1
                MOV     count,                          16
.ones:          MOV     pattern,                        bit
                CALL    output_pattern
                SHL     bit,                            1
                DJNZ    count,                          .ones
                MOV     bit,                            1
                MOV     count,                          16
.zeros:         MOV     pattern,                        aug(0xFFFF)
                XOR     pattern,                        bit
                CALL    output_pattern
                SHL     bit,                            1
                DJNZ    count,                          .zeros
                DJNZ    frames,                         .frame
                DIRL    aug(0 | (7 << 6))
                DIRL    aug(32 | (7 << 6))
                RET

// Map a 16-bit pattern to P0..P7 and P32..P39, holding each state for about 10 ms.
output_pattern:
                ANDN    OUTA,   255
                MOV     temp,   pattern
                AND     temp,   255
                OR      OUTA,   temp
                ANDN    OUTB,   255
                MOV     temp,   pattern
                SHR     temp,   8
                AND     temp,   255
                OR      OUTB,   temp
                WAITX   aug(200000)
                RET

// Receive one UART byte.
read_byte:
                TESTP   63          :wc
    if(!C)      JMP     read_byte
                RDPIN   PA, 63
                SHR     PA, 24
                RET

// Transmit one byte and wait for its frame to complete.
write_byte:
                WYPIN   PA, 62
                WAITX   1
.wait:          TESTP   62      :wc
    if(!C)      JMP     .wait
                RET

var pattern:    LONG    0
var bit:        LONG    0
var count:      LONG    0
var frames:     LONG    0
var temp:       LONG    0

