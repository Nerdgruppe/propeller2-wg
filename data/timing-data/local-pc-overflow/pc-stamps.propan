//? WINDTUNNEL CHECK LIST
//? timeout-ms: 1000
//? post: cog[*].reg[a] == 0
//? post: cog[*].reg[b] == 0
//? post: cog[*].reg[c] == 0
//? post: cog[*].reg[d] == 0
//? post: cog[*].reg[link] == 0
//? run: "kind0"
//? const: kind = 0
//? run: "kind1"
//? const: kind = 1
//? run: "kind2"
//? const: kind = 2
//? run: "kind3"
//? const: kind = 3

                // Stamp both sides of local wrap and record a CALLD return PC.
                MOV     register(0),    word0
                MOV     register(1),    word1
                MOV     register(2),    word2
                WRLUT   tail_word,      aug(511)
                GETCT   a
.if kind == 3
                JMP     nrel(0)
.else
                JMP     nrel(0x3ff)
.endif
done:
                GETCT   d
                SUB     b,      a
                SUB     c,      a
                SUB     d,      a
                SUB     link,   0
                JMP     nrel(_end)
var a:          LONG    0
var b:          LONG    0
var c:          LONG    0
var d:          LONG    0
var link:       LONG    0
var target:     LONG    pcaddr(done)
.if kind == 1
var word0:      LONG    0xfd800000 | pcaddr(done)
.elif   kind == 2
var word0:      LONG    0xfb200000 | (cogaddr(link) << 9) | cogaddr(target)
.else
var word0:      LONG    0xfd60001a | (cogaddr(b) << 9)
.endif
var word1:      LONG    0xfd60001a | (cogaddr(c) << 9)
var word2:      LONG    0xfd800000 | pcaddr(done)
var tail_word:  LONG    0

