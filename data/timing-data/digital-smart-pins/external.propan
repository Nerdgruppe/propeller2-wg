// MODE, Y, and PLL are supplied by external.py. Only P2AAS opens the DUT's serial port.
.cogexec
.if PLL
                HUBSET  aug(0x010009f8)
                WAITX   aug(200000)
                HUBSET  aug(0x010009fb)
.endif
                WRPIN   P_TT_01 | P_ASYNC_TX,           62
.if PLL
                WXPIN aug(0x640007), 62
.endif
                DIRH    62
                WRPIN   P_ASYNC_RX,                     63
.if PLL
                WXPIN aug(0x640007), 63
.endif
                DIRH    63
                WAITX 64
                // P10 receives external A from P8 and B from P9; its physical output is disabled.
                WRPIN   aug(0x67000000 | (MODE << 1)),  10
.if MODE == 18
                WXPIN   aug(1000000),                   10
.else
                WXPIN   0,                              10
.endif
                WYPIN   Y,                              10
                DIRH    10
                MOV     PA,                             '!'
                CALL    write_byte
main:
                CALL    read_byte
                CMP     PA, 'R'     :wz
    if(Z)       JMP     sample
                CMP     PA, 'A'     :wz
    if(Z)       AKPIN   10
                CMP     PA, 'F'     :wz
    if(Z)       DIRL    10
                MOV     PA, '.'
                CALL    write_byte
                JMP     main
// Return a little-endian result word followed by modal C and IN.
sample:
                RQPIN   value,  10      :wc
                WRC     flag
                TESTP   10              :wc
                WRC     ready
                MOV     count,  4
.word:          MOV     PA,     value
                AND     PA,     255
                CALL    write_byte
                SHR     value,  8
                DJNZ    count,  .word
                MOV     PA,     flag
                CALL    write_byte
                MOV     PA,     ready
                CALL    write_byte
                JMP     main
// Receive one UART command without consuming test inputs.
read_byte:
                TESTP   63          :wc
    if(!C)      JMP     read_byte
                RDPIN   PA, 63
                SHR     PA, 24
                RET
// Serialize responses over the existing transport UART.
write_byte:
                WYPIN   PA, 62
                WAITX   1
.wait:          TESTP   62      :wc
    if(!C)      JMP     .wait
                RET
var value:      LONG    0
var flag:       LONG    0
var ready:      LONG    0
var count:      LONG    0

