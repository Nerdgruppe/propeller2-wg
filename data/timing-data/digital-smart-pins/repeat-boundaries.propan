//? post: cog[*].reg[acknowledged] == 0x00000001
//? post: cog[*].reg[reset_result] == 0x00070007
//? post: cog[*].reg[reset_flag] == 0x00000000
//? post: cog[*].reg[reset_output] == 0x00000000
//? run: "pll1-mode10-x70003-y3-phase5"
//? const: pll = 1
//? const: mode = 10
//? const: x = 458755
//? const: y = 3
//? const: phase = 5
//? post: cog[*].reg[waveform] == 0xc631c631
//? post: cog[*].reg[result] == 0x00070007
//? post: cog[*].reg[flag] == 0x00000000
//? post: cog[*].reg[ready] == 0x00000001
//? post: cog[*].reg[acknowledged] == 0x00000000
//? post: cog[*].reg[reset_result] == 0x00070007
//? post: cog[*].reg[reset_flag] == 0x00000000
//? post: cog[*].reg[reset_output] == 0x00000000
//? run: "pll1-mode10-x70003-y3-phase6"
//? const: pll = 1
//? const: mode = 10
//? const: x = 458755
//? const: y = 3
//? const: phase = 6
//? post: cog[*].reg[waveform] == 0xc6318e31
//? post: cog[*].reg[result] == 0x00070007
//? post: cog[*].reg[flag] == 0x00000000
//? post: cog[*].reg[ready] == 0x00000001
//? post: cog[*].reg[acknowledged] == 0x00000000
//? post: cog[*].reg[reset_result] == 0x00070007
//? post: cog[*].reg[reset_flag] == 0x00000000
//? post: cog[*].reg[reset_output] == 0x00000000
//? run: "pll1-mode10-x70003-y3-phase7"
//? const: pll = 1
//? const: mode = 10
//? const: x = 458755
//? const: y = 3
//? const: phase = 7
//? post: cog[*].reg[waveform] == 0x8e318c71
//? post: cog[*].reg[result] == 0x00070007
//? post: cog[*].reg[flag] == 0x00000000
//? post: cog[*].reg[ready] == 0x00000001
//? post: cog[*].reg[acknowledged] == 0x00000000
//? post: cog[*].reg[reset_result] == 0x00070007
//? post: cog[*].reg[reset_flag] == 0x00000000
//? post: cog[*].reg[reset_output] == 0x00000000
// Select the test clock while retaining the ROM-calibrated UART divider for reporting.
.if pll
                HUBSET  aug(0x010009f8)
                WAITX   aug(200000)
                HUBSET  aug(0x010009fb)
                WAITX   64
.endif

                // P4 is the DUT; P6 observes its physical pad through the -2 selector.
                // A/B come from low P3/P5, making SMPS feedback inactive.
                DRVL    3
                DRVL    5
                WRPIN   aug(0x71000000 | (mode << 1) | P_TT_01),    4
                WRPIN   aug(0x60000000),                            6
                WXPIN   aug(x),                                     4
                WYPIN   aug(y),                                     4
                DIRH    4
                WAITX   phase
                WYPIN   aug(y),                                     4
                TESTP   6                                               :wc
                RCL     waveform,                                   1
                TESTP   6                                               :wc
                RCL     waveform,                                   1
                TESTP   6                                               :wc
                RCL     waveform,                                   1
                TESTP   6                                               :wc
                RCL     waveform,                                   1
                TESTP   6                                               :wc
                RCL     waveform,                                   1
                TESTP   6                                               :wc
                RCL     waveform,                                   1
                TESTP   6                                               :wc
                RCL     waveform,                                   1
                TESTP   6                                               :wc
                RCL     waveform,                                   1
                TESTP   6                                               :wc
                RCL     waveform,                                   1
                TESTP   6                                               :wc
                RCL     waveform,                                   1
                TESTP   6                                               :wc
                RCL     waveform,                                   1
                TESTP   6                                               :wc
                RCL     waveform,                                   1
                TESTP   6                                               :wc
                RCL     waveform,                                   1
                TESTP   6                                               :wc
                RCL     waveform,                                   1
                TESTP   6                                               :wc
                RCL     waveform,                                   1
                TESTP   6                                               :wc
                RCL     waveform,                                   1
                TESTP   6                                               :wc
                RCL     waveform,                                   1
                TESTP   6                                               :wc
                RCL     waveform,                                   1
                TESTP   6                                               :wc
                RCL     waveform,                                   1
                TESTP   6                                               :wc
                RCL     waveform,                                   1
                TESTP   6                                               :wc
                RCL     waveform,                                   1
                TESTP   6                                               :wc
                RCL     waveform,                                   1
                TESTP   6                                               :wc
                RCL     waveform,                                   1
                TESTP   6                                               :wc
                RCL     waveform,                                   1
                TESTP   6                                               :wc
                RCL     waveform,                                   1
                TESTP   6                                               :wc
                RCL     waveform,                                   1
                TESTP   6                                               :wc
                RCL     waveform,                                   1
                TESTP   6                                               :wc
                RCL     waveform,                                   1
                TESTP   6                                               :wc
                RCL     waveform,                                   1
                TESTP   6                                               :wc
                RCL     waveform,                                   1
                TESTP   6                                               :wc
                RCL     waveform,                                   1
                TESTP   6                                               :wc
                RCL     waveform,                                   1

                // Observe result/flag and readiness independently, then acknowledge and reset.
                RQPIN   result,                                     4   :wc
                WRC     flag
                TESTP   4                                               :wc
                WRC     ready
                AKPIN   4
                WAITX   8
                TESTP   4                                               :wc
                WRC     acknowledged
                DIRL    4
                WAITX   8
                RQPIN   reset_result,                               4   :wc
                WRC     reset_flag
                TESTP   6                                               :wc
                WRC     reset_output
                DIRL    3
                DIRL    5

                // Restore RCFAST before the shared reporter uses the ROM-calibrated UART.
                HUBSET  0xF0
                WAITX   64
                JMP     nrel(_end)

var waveform:   LONG    0
var result:     LONG    0
var flag:       LONG    0
var ready:      LONG    0
var acknowledged:
                LONG    0
var reset_result:
                LONG    0
var reset_flag: LONG    0
var reset_output:
                LONG    0

