// Select the test clock while retaining the ROM-calibrated UART divider for reporting.
.if pll
                HUBSET  aug(0x010009f8)
                WAITX   aug(200000)
                HUBSET  aug(0x010009fb)
                WAITX   64
.endif

                // Start a fresh NCO and time its first completion through the pin-event bus.
                WRPIN   (mode << 1),        4
                WXPIN   x,                  4
                SETSE1  0
                WAITX   64
                POLLSE1
                SETSE1  (0x40 | 4)
                GETCT   started
                DIRH    4
                WAITX   phase
                WYPIN   aug(0x87654321),    4
                WAITSE1
                GETCT   elapsed
                SUB     elapsed,            started
                TESTP   4                           :wc
                WRC     ready
                RQPIN   result,             4       :wc
                WRC     flag
                DIRL    4
                WAITX   16
                RQPIN   held,               4

var started:    LONG    0

                // Restore RCFAST before the shared reporter uses the ROM-calibrated UART.
                HUBSET  0xF0
                WAITX   64
                JMP     nrel(_end)

var elapsed:    LONG    0
var ready:      LONG    0
var result:     LONG    0
var flag:       LONG    0
var held:       LONG    0

