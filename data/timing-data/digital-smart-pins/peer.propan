// Independent weak-drive GPIO source with a bounded idle watchdog, using ROM-calibrated UART.
.cogexec
                HUBSET  0xF0
                WRPIN   P_TT_01 | P_ASYNC_TX,           62
                DIRH    62
                WRPIN   P_ASYNC_RX,                     63
                DIRH    63
                WRPIN   aug(P_HIGH_1K5 | P_LOW_1K5),    aug(8 | (7 << 6))
                DIRL    aug(8 | (7 << 6))
                GETCT   deadline
                ADD     deadline,                       aug(20000000)
                MOV     PA,                             '!'
                CALL    write_byte
main:
                CALL    read_byte
                CMP     PA, 'W'             :wz
    if(Z)       JMP     write_gpio
                DIRL    aug(8 | (7 << 6))
                JMP     ack
write_gpio:
                CALL    read_byte
                SHL     PA,         8
                // One GPIO write avoids artificial intermediate edges while changing source states.
                MOV     OUTA,       PA
                DIRH    aug(8 | (7 << 6))
                GETCT   deadline
                ADD     deadline,   aug(20000000)
                WAITX   aug(10000)
ack:
                MOV     PA, '.'
                CALL    write_byte
                JMP     main
// Release all shared outputs if host communication stops for roughly one RCFAST second.
read_byte:
                GETCT   now
                SUB     now,    deadline
                TESTB   now,    31          :wc
    if(!C)      DIRL    aug(8 | (7 << 6))
                TESTP   63                  :wc
    if(!C)      JMP     read_byte
                RDPIN   PA,     63
                SHR     PA,     24
                RET
// Finish every response before accepting another command.
write_byte:
                WYPIN   PA, 62
                WAITX   1
.wait:          TESTP   62      :wc
    if(!C)      JMP     .wait
                RET
var deadline:   LONG    0
var now:        LONG    0

