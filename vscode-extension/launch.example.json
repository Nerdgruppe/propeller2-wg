{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Desktop Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/.."
      ],
      "outFiles": ["${workspaceFolder}/dist/desktop/**/*.js"]
    }
  ]
}
