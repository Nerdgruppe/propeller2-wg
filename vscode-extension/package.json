{
  "name": "propan-assembler",
  "displayName": "Propan Assembler",
  "description": "Language support for the Propeller 2 assembler Propan",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.91.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:propan"
  ],
  "browser": "./dist/web/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "propan.restartLsp",
        "title": "Restart LSP",
        "category": "Propan",
        "enablement": "!isWeb"
      },
      {
        "command": "propan.check",
        "title": "Check",
        "category": "Propan",
        "icon": "$(check)",
        "enablement": "!isWeb && isWorkspaceTrusted && resourceScheme == file && resourceLangId == propan"
      },
      {
        "command": "propan.run",
        "title": "Run",
        "category": "Propan",
        "icon": "$(play)",
        "enablement": "!isWeb && isWorkspaceTrusted && resourceScheme == file && resourceLangId == propan"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "propan.restartLsp",
          "when": "!isWeb"
        },
        {
          "command": "propan.check",
          "when": "!isWeb && isWorkspaceTrusted && resourceScheme == file && resourceLangId == propan"
        },
        {
          "command": "propan.run",
          "when": "!isWeb && isWorkspaceTrusted && resourceScheme == file && resourceLangId == propan"
        }
      ],
      "editor/title": [
        {
          "command": "propan.check",
          "when": "!isWeb && isWorkspaceTrusted && resourceScheme == file && resourceLangId == propan",
          "group": "navigation"
        },
        {
          "command": "propan.run",
          "when": "!isWeb && isWorkspaceTrusted && resourceScheme == file && resourceLangId == propan",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "propan.check",
          "when": "!isWeb && isWorkspaceTrusted && resourceScheme == file && resourceLangId == propan",
          "group": "propan"
        },
        {
          "command": "propan.run",
          "when": "!isWeb && isWorkspaceTrusted && resourceScheme == file && resourceLangId == propan",
          "group": "propan"
        }
      ],
      "explorer/context": [
        {
          "command": "propan.check",
          "when": "!isWeb && isWorkspaceTrusted && resourceScheme == file && resourceLangId == propan",
          "group": "propan"
        },
        {
          "command": "propan.run",
          "when": "!isWeb && isWorkspaceTrusted && resourceScheme == file && resourceLangId == propan",
          "group": "propan"
        }
      ]
    },
    "languages": [
      {
        "id": "propan",
        "extensions": [
          ".propan",
          ".p2asm"
        ],
        "configuration": "./propan/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "propan",
        "scopeName": "source.propan",
        "path": "./propan/tmGrammar.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "propanMnemonic",
        "superType": "keyword",
        "description": "Propan instruction mnemonic or directive"
      },
      {
        "id": "propanCodeLabel",
        "superType": "function",
        "description": "Propan code label"
      },
      {
        "id": "propanVarLabel",
        "superType": "variable",
        "description": "Propan variable label"
      },
      {
        "id": "propanConstant",
        "superType": "variable",
        "description": "Propan constant"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "propan",
        "scopes": {
          "propanMnemonic": [
            "keyword.control.propan"
          ],
          "propanCodeLabel": [
            "entity.name.function.propan"
          ],
          "propanVarLabel": [
            "variable.other.propan"
          ],
          "propanConstant": [
            "constant.other.propan"
          ]
        }
      }
    ],
    "configuration": {
      "title": "Propeller 2",
      "properties": {
        "propeller2.propanLsp.path": {
          "type": "string",
          "default": "propan-lsp",
          "scope": "machine-overridable",
          "restricted": true,
          "description": "Propan language server executable: an absolute path, workspace-relative path, or command on PATH. Changes restart the server."
        },
        "propeller2.propanLsp.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine-overridable",
          "restricted": true,
          "description": "Arguments passed to propan-lsp. Changes restart the server."
        },
        "propeller2.propan.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "restricted": true,
          "description": "Propan assembler executable. When empty, uses propan beside the configured LSP executable, or propan on PATH."
        },
        "propeller2.propan.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "restricted": true,
          "description": "Additional assembler arguments, such as -I include paths."
        },
        "propeller2.p2aas.endpoint": {
          "type": "string",
          "default": "ws://127.0.0.1:12880/",
          "scope": "resource",
          "description": "P2AAS WebSocket endpoint for Run. Optional baudrate and timeout_ms query parameters default to 115200 and 5000."
        }
      }
    }
  },
  "scripts": {
    "test": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. --extensionTestsPath=dist/web/test/suite/extensionTests.js",
    "pretest": "npm run compile-web",
    "vscode:prepublish": "npm run package-web",
    "compile-web": "npm run check-types && npm run lint && node esbuild.js",
    "watch-web": "npm-run-all -p watch-web:*",
    "watch-web:esbuild": "node esbuild.js --watch",
    "watch-web:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package-web": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "run-in-browser": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. .",
    "compile": "npm run compile-web",
    "package": "npm run package-web",
    "test-desktop": "node --test tests/desktop.cjs"
  },
  "devDependencies": {
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "@types/assert": "^1.5.11",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.91.1",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-web": "^0.0.69",
    "assert": "^2.1.0",
    "esbuild": "^0.25.3",
    "eslint": "^9.25.1",
    "glob": "^11.0.2",
    "mocha": "^11.1.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@vscode/vsce": "^3.3.2",
    "undici": "^6.29.0",
    "vscode-languageclient": "^9.0.1"
  },
  "main": "./dist/desktop/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Propan starts native executables from workspace settings."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "The native Propan tools require local files."
    }
  }
}
